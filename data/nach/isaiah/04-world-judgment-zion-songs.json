  "timeline": { "period_name": "Julgamento universal e esperança", "anno_mundi_start": 3150, "anno_mundi_end": 3205, "era": "neviim-acharonim", "position_pct": 55, "description": "O horizonte profético passa do local ao cósmico, com Tzion como foco de refúgio e canção." },
  "summary": { "short": "O julgamento se torna cósmico, mas Tzion aparece como centro de salvação e restauração.", "medium": "Os capítulos 24-27 ampliam o julgamento para a terra inteira. A ordem humana é abalada, mas a voz dos justos canta da extremidade da terra.\n\nNo centro está Tzion: banquete, remoção da morte, cidade forte e reunião dos dispersos.", "characters_main": ["Tzion", "Israel", "Nações"], "characters_secondary": ["Leviatan", "Moav"], "themes": ["Julgamento universal", "Tzion", "Cântico", "Restauração"] },
  "facts": [
    { "id": "ys025", "order": 1, "text": "A terra é retratada como esvaziada e abalada por transgressão da aliança.", "text_he": null, "refs": ["Isaiah 24:1-13"], "ref_start": "Isaiah 24:1", "ref_end": "Isaiah 24:13", "chapter": 24, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Isaiah 24:1-13", "tags": ["terra", "aliança", "julgamento"], "topic": "Terra abalada" },
    { "id": "ys026", "order": 2, "text": "Mesmo em meio ao juízo, vozes cantam glória ao Deus de Israel desde os confins da terra.", "text_he": null, "refs": ["Isaiah 24:14-16"], "ref_start": "Isaiah 24:14", "ref_end": "Isaiah 24:16", "chapter": 24, "verse_start": 14, "verse_end": 16, "sefaria_ref": "Isaiah 24:14-16", "tags": ["cântico", "glória", "remanescente"], "topic": "Cântico no juízo" },
    { "id": "ys027", "order": 3, "text": "Deus reina no monte Tzion, diante dos anciãos, após abalar poderes celestes e terrestres.", "text_he": null, "refs": ["Isaiah 24:17-23"], "ref_start": "Isaiah 24:17", "ref_end": "Isaiah 24:23", "chapter": 24, "verse_start": 17, "verse_end": 23, "sefaria_ref": "Isaiah 24:17-23", "tags": ["tzion", "reino", "poderes"], "topic": "Reinado em Tzion" },
    { "id": "ys028", "order": 4, "text": "Yeshaya louva Deus por transformar cidade opressora em ruína e ser refúgio ao pobre.", "text_he": null, "refs": ["Isaiah 25:1-5"], "ref_start": "Isaiah 25:1", "ref_end": "Isaiah 25:5", "chapter": 25, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Isaiah 25:1-5", "tags": ["refúgio", "pobre", "cidade"], "topic": "Refúgio do fraco" },
    { "id": "ys029", "order": 5, "text": "No monte, Deus prepara banquete para todos os povos e remove lágrimas e morte.", "text_he": null, "refs": ["Isaiah 25:6-12"], "ref_start": "Isaiah 25:6", "ref_end": "Isaiah 25:12", "chapter": 25, "verse_start": 6, "verse_end": 12, "sefaria_ref": "Isaiah 25:6-12", "tags": ["banquete", "morte", "consolo"], "topic": "Banquete futuro" },
    { "id": "ys030", "order": 6, "text": "Yehudá canta uma cidade forte, aberta ao povo justo que guarda fidelidade.", "text_he": null, "refs": ["Isaiah 26:1-6"], "ref_start": "Isaiah 26:1", "ref_end": "Isaiah 26:6", "chapter": 26, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Isaiah 26:1-6", "tags": ["cidade", "fidelidade", "justiça"], "topic": "Cidade forte" },
    { "id": "ys031", "order": 7, "text": "A esperança de vida aparece em linguagem de despertar dos mortos e parto nacional.", "text_he": null, "refs": ["Isaiah 26:7-21"], "ref_start": "Isaiah 26:7", "ref_end": "Isaiah 26:21", "chapter": 26, "verse_start": 7, "verse_end": 21, "sefaria_ref": "Isaiah 26:7-21", "tags": ["vida", "esperança", "ressurreição"], "topic": "Esperança de vida" },
    { "id": "ys032", "order": 8, "text": "Leviatan é julgado, a vinha de Israel é guardada e os dispersos são reunidos ao monte santo.", "text_he": null, "refs": ["Isaiah 27:1-13"], "ref_start": "Isaiah 27:1", "ref_end": "Isaiah 27:13", "chapter": 27, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Isaiah 27:1-13", "tags": ["leviatan", "vinha", "reunião"], "topic": "Reunião dos dispersos" }
