  "identity": { "id": "world-judgment-zion-songs", "label": "Julgamento universal e cânticos de Tzion", "label_pt": "A terra abalada, cidade forte, banquete futuro e ressurreição simbólica", "hebrew": null, "transliteration": "World Judgment and Zion Songs" },
