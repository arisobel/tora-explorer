  "identity": { "id": "immanuel-davidic-hope", "label": "Immanuel e esperança davídica", "label_pt": "Achaz, ameaça aramita, sinal de Immanuel e promessa de governo justo", "hebrew": null, "transliteration": "Immanuel and Davidic Hope" },
  "range": { "ref_start": "Isaiah 7:1", "ref_end": "Isaiah 12:6", "sefaria_ref": "Isaiah 7:1-12:6", "chapters_covered": [7,8,9,10,11,12], "chapter_start": 7, "chapter_end": 12, "verse_start": 1, "verse_end_chapter": 12, "verse_end": 6 },
  "timeline": { "period_name": "Crise de Achaz e esperança davídica", "anno_mundi_start": 3150, "anno_mundi_end": 3170, "era": "neviim-acharonim", "position_pct": 55, "description": "A ameaça política contra Yehudá se torna cenário para sinais, advertência e promessa de futuro davídico." },
  "summary": { "short": "Diante da crise política, Yeshaya chama Yehudá à confiança e projeta esperança davídica.", "medium": "Achaz teme a coalizão de Aram e Israel. Yeshaya insiste que a estabilidade de Yehudá depende de confiança, não de cálculo político.\n\nOs sinais proféticos e os nomes simbólicos das crianças conduzem à promessa de luz, governo justo e rebento de Yishai.", "characters_main": ["Yeshaya", "Achaz", "Shear-Yashuv", "Immanuel"], "characters_secondary": ["Retzin", "Pekach", "Assíria", "Yishai"], "themes": ["Confiança", "Immanuel", "David", "Mashiach"] },
  "facts": [
    { "id": "ys009", "order": 1, "text": "Aram e Israel ameaçam Yehudá, e Achaz treme diante da crise.", "text_he": null, "refs": ["Isaiah 7:1-2"], "ref_start": "Isaiah 7:1", "ref_end": "Isaiah 7:2", "chapter": 7, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Isaiah 7:1-2", "tags": ["achaz", "aram", "crise"], "topic": "Crise siro-efraimita" },
    { "id": "ys010", "order": 2, "text": "Yeshaya leva Shear-Yashuv a Achaz e declara que a ameaça não prevalecerá se houver firmeza na fé.", "text_he": null, "refs": ["Isaiah 7:3-9"], "ref_start": "Isaiah 7:3", "ref_end": "Isaiah 7:9", "chapter": 7, "verse_start": 3, "verse_end": 9, "sefaria_ref": "Isaiah 7:3-9", "tags": ["fé", "shear-yashuv", "confiança"], "topic": "Chamado à firmeza" },
    { "id": "ys011", "order": 3, "text": "O sinal de Immanuel afirma que Deus permanece com Yehudá em meio à ameaça.", "text_he": null, "refs": ["Isaiah 7:10-17"], "ref_start": "Isaiah 7:10", "ref_end": "Isaiah 7:17", "chapter": 7, "verse_start": 10, "verse_end": 17, "sefaria_ref": "Isaiah 7:10-17", "tags": ["immanuel", "sinal", "achaz"], "topic": "Sinal de Immanuel" },
    { "id": "ys012", "order": 4, "text": "Yeshaya anuncia que a Assíria será instrumento de pressão, como águas que transbordam.", "text_he": null, "refs": ["Isaiah 8:1-10"], "ref_start": "Isaiah 8:1", "ref_end": "Isaiah 8:10", "chapter": 8, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Isaiah 8:1-10", "tags": ["assíria", "sinal", "immanuel"], "topic": "Águas da Assíria" },
    { "id": "ys013", "order": 5, "text": "O povo é chamado a temer Deus, não conspirações políticas ou pressões humanas.", "text_he": null, "refs": ["Isaiah 8:11-22"], "ref_start": "Isaiah 8:11", "ref_end": "Isaiah 8:22", "chapter": 8, "verse_start": 11, "verse_end": 22, "sefaria_ref": "Isaiah 8:11-22", "tags": ["temor", "confiança", "torá"], "topic": "Temor correto" },
    { "id": "ys014", "order": 6, "text": "Uma luz nasce para o povo em trevas, associada a alegria, libertação e governo justo.", "text_he": null, "refs": ["Isaiah 9:1-6"], "ref_start": "Isaiah 9:1", "ref_end": "Isaiah 9:6", "chapter": 9, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Isaiah 9:1-6", "tags": ["luz", "governo", "esperança"], "topic": "Luz em trevas" },
    { "id": "ys015", "order": 7, "text": "A Assíria é descrita como vara de juízo, mas também será julgada por sua arrogância.", "text_he": null, "refs": ["Isaiah 10:5-34"], "ref_start": "Isaiah 10:5", "ref_end": "Isaiah 10:34", "chapter": 10, "verse_start": 5, "verse_end": 34, "sefaria_ref": "Isaiah 10:5-34", "tags": ["assíria", "arrogância", "juízo"], "topic": "Vara da ira" },
    { "id": "ys016", "order": 8, "text": "Do tronco de Yishai brotará liderança justa, seguida por conhecimento de Deus e cântico de salvação.", "text_he": null, "refs": ["Isaiah 11:1-12:6"], "ref_start": "Isaiah 11:1", "ref_end": "Isaiah 12:6", "chapter": 11, "verse_start": 1, "verse_end_chapter": 12, "verse_end": 6, "sefaria_ref": "Isaiah 11:1-12:6", "tags": ["yishai", "mashiach", "redenção"], "topic": "Rebento de Yishai" }
  ]
