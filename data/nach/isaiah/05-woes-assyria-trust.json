  "identity": { "id": "woes-assyria-trust", "label": "Ais, Assíria e confiança", "label_pt": "Advertências contra alianças falsas, promessa de rei justo e retorno a Tzion", "hebrew": null, "transliteration": "Woes Assyria and Trust" },
  "range": { "ref_start": "Isaiah 28:1", "ref_end": "Isaiah 35:10", "sefaria_ref": "Isaiah 28:1-35:10", "chapters_covered": [28,29,30,31,32,33,34,35], "chapter_start": 28, "chapter_end": 35, "verse_start": 1, "verse_end_chapter": 35, "verse_end": 10 },
  "timeline": { "period_name": "Advertências e retorno", "anno_mundi_start": 3170, "anno_mundi_end": 3199, "era": "neviim-acharonim", "position_pct": 55, "description": "A pressão assíria revela a tentação de confiar em alianças e a necessidade de retornar a Deus." },
  "summary": { "short": "Yeshaya confronta confiança em poderes humanos e aponta para justiça, redenção e retorno.", "medium": "A série de ais denuncia liderança bêbada, religiosidade superficial e estratégias políticas baseadas em Egito. A crise assíria é tratada como teste de confiança.\n\nAo mesmo tempo, a seção aponta para rei justo, segurança de Tzion e caminho de retorno para os resgatados.", "characters_main": ["Yeshaya", "Efraim", "Ariel", "Assíria", "Tzion"], "characters_secondary": ["Egito", "Edom", "Resgatados"], "themes": ["Ais", "Confiança", "Assíria", "Retorno"] },
  "facts": [
    { "id": "ys033", "order": 1, "text": "Efraim é advertido por orgulho e embriaguez, enquanto Deus promete uma coroa de glória ao remanescente.", "text_he": null, "refs": ["Isaiah 28:1-13"], "ref_start": "Isaiah 28:1", "ref_end": "Isaiah 28:13", "chapter": 28, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Isaiah 28:1-13", "tags": ["efraim", "orgulho", "remanescente"], "topic": "Ai de Efraim" },
    { "id": "ys034", "order": 2, "text": "Yeshaya fala de pedra firme em Tzion, contrastando fundamento seguro com pacto ilusório.", "text_he": null, "refs": ["Isaiah 28:14-29"], "ref_start": "Isaiah 28:14", "ref_end": "Isaiah 28:29", "chapter": 28, "verse_start": 14, "verse_end": 29, "sefaria_ref": "Isaiah 28:14-29", "tags": ["tzion", "fundamento", "falsidade"], "topic": "Pedra em Tzion" },
    { "id": "ys035", "order": 3, "text": "Ariel, nome profético para Yerushalayim, será cercada mas também surpreendida pela intervenção divina.", "text_he": null, "refs": ["Isaiah 29:1-8"], "ref_start": "Isaiah 29:1", "ref_end": "Isaiah 29:8", "chapter": 29, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Isaiah 29:1-8", "tags": ["ariel", "yerushalayim", "cerco"], "topic": "Ai de Ariel" },
    { "id": "ys036", "order": 4, "text": "O povo honra Deus com lábios, mas seu coração está distante, exigindo renovação profunda.", "text_he": null, "refs": ["Isaiah 29:9-24"], "ref_start": "Isaiah 29:9", "ref_end": "Isaiah 29:24", "chapter": 29, "verse_start": 9, "verse_end": 24, "sefaria_ref": "Isaiah 29:9-24", "tags": ["coração", "hipocrisia", "renovação"], "topic": "Religião superficial" },
    { "id": "ys037", "order": 5, "text": "Buscar proteção no Egito sem consultar Deus é denunciado como rebeldia política e espiritual.", "text_he": null, "refs": ["Isaiah 30:1-17"], "ref_start": "Isaiah 30:1", "ref_end": "Isaiah 30:17", "chapter": 30, "verse_start": 1, "verse_end": 17, "sefaria_ref": "Isaiah 30:1-17", "tags": ["egito", "aliança", "rebeldia"], "topic": "Confiança no Egito" },
    { "id": "ys038", "order": 6, "text": "Deus espera para ter misericórdia, e o povo ouvirá orientação no caminho certo.", "text_he": null, "refs": ["Isaiah 30:18-33"], "ref_start": "Isaiah 30:18", "ref_end": "Isaiah 30:33", "chapter": 30, "verse_start": 18, "verse_end": 33, "sefaria_ref": "Isaiah 30:18-33", "tags": ["misericórdia", "ensino", "retorno"], "topic": "Misericórdia e direção" },
    { "id": "ys039", "order": 7, "text": "Um rei justo e líderes íntegros são projetados como resposta à crise moral e política.", "text_he": null, "refs": ["Isaiah 31:1-32:20"], "ref_start": "Isaiah 31:1", "ref_end": "Isaiah 32:20", "chapter": 31, "verse_start": 1, "verse_end_chapter": 32, "verse_end": 20, "sefaria_ref": "Isaiah 31:1-32:20", "tags": ["rei", "justiça", "espírito"], "topic": "Rei em justiça" },
    { "id": "ys040", "order": 8, "text": "Após juízo contra opressores, o deserto floresce e os resgatados retornam a Tzion com alegria.", "text_he": null, "refs": ["Isaiah 33:1-35:10"], "ref_start": "Isaiah 33:1", "ref_end": "Isaiah 35:10", "chapter": 33, "verse_start": 1, "verse_end_chapter": 35, "verse_end": 10, "sefaria_ref": "Isaiah 33:1-35:10", "tags": ["redenção", "deserto", "tzion"], "topic": "Caminho dos resgatados" }
  ]
