  "identity": { "id": "comfort-cyrus-servant", "label": "Consolo, Ciro e o servo", "label_pt": "Consolação de Israel, unicidade divina, queda dos ídolos e missão do servo", "hebrew": null, "transliteration": "Comfort Cyrus and Servant" },
