  "summary": { "short": "A voz profética fala ao exílio: Deus consola Tzion, governa a história e chama Ciro.", "medium": "A segunda grande parte de Yeshaya começa com consolo. O povo no exílio deve enxergar que Deus ainda governa, que ídolos são vazios e que a história pode ser conduzida por instrumentos inesperados.\n\nCiro aparece como agente de retorno, enquanto o servo de Deus introduz missão, justiça e luz às nações.", "characters_main": ["Ciro", "Servo de Deus", "Yaakov", "Tzion"], "characters_secondary": ["Bavel", "Ídolos", "Nações"], "themes": ["Consolo", "Retorno", "Monoteísmo", "Servo"] },
  "facts": [
    { "id": "ys049", "order": 1, "text": "A voz anuncia consolo para Yerushalayim e prepara caminho no deserto para a revelação de Deus.", "text_he": null, "refs": ["Isaiah 40:1-11"], "ref_start": "Isaiah 40:1", "ref_end": "Isaiah 40:11", "chapter": 40, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Isaiah 40:1-11", "tags": ["consolo", "deserto", "retorno"], "topic": "Consolai meu povo" },
    { "id": "ys050", "order": 2, "text": "Deus é apresentado como Criador incomparável, acima das nações e dos astros.", "text_he": null, "refs": ["Isaiah 40:12-31"], "ref_start": "Isaiah 40:12", "ref_end": "Isaiah 40:31", "chapter": 40, "verse_start": 12, "verse_end": 31, "sefaria_ref": "Isaiah 40:12-31", "tags": ["criador", "força", "esperança"], "topic": "Grandeza do Criador" },
    { "id": "ys051", "order": 3, "text": "Israel é chamado de servo escolhido, descendência de Avraham, sustentado pela mão divina.", "text_he": null, "refs": ["Isaiah 41:1-20"], "ref_start": "Isaiah 41:1", "ref_end": "Isaiah 41:20", "chapter": 41, "verse_start": 1, "verse_end": 20, "sefaria_ref": "Isaiah 41:1-20", "tags": ["servo", "avraham", "escolha"], "topic": "Servo escolhido" },
    { "id": "ys052", "order": 4, "text": "Os ídolos são desafiados a explicar a história, mas se revelam vazios.", "text_he": null, "refs": ["Isaiah 41:21-29"], "ref_start": "Isaiah 41:21", "ref_end": "Isaiah 41:29", "chapter": 41, "verse_start": 21, "verse_end": 29, "sefaria_ref": "Isaiah 41:21-29", "tags": ["ídolos", "história", "prova"], "topic": "Vazio dos ídolos" },
    { "id": "ys053", "order": 5, "text": "O servo trará justiça às nações sem quebrar a cana rachada nem apagar pavio fraco.", "text_he": null, "refs": ["Isaiah 42:1-9"], "ref_start": "Isaiah 42:1", "ref_end": "Isaiah 42:9", "chapter": 42, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Isaiah 42:1-9", "tags": ["servo", "justiça", "nações"], "topic": "Servo e justiça" },
    { "id": "ys054", "order": 6, "text": "Deus promete reunir Israel das extremidades porque o povo foi criado para Sua glória.", "text_he": null, "refs": ["Isaiah 43:1-21"], "ref_start": "Isaiah 43:1", "ref_end": "Isaiah 43:21", "chapter": 43, "verse_start": 1, "verse_end": 21, "sefaria_ref": "Isaiah 43:1-21", "tags": ["reunião", "glória", "redenção"], "topic": "Criado para glória" },
    { "id": "ys055", "order": 7, "text": "Ciro é nomeado como ungido para abrir caminhos e permitir restauração, mesmo sem conhecer Deus plenamente.", "text_he": null, "refs": ["Isaiah 44:24-45:13"], "ref_start": "Isaiah 44:24", "ref_end": "Isaiah 45:13", "chapter": 44, "verse_start": 24, "verse_end_chapter": 45, "verse_end": 13, "sefaria_ref": "Isaiah 44:24-45:13", "tags": ["ciro", "retorno", "soberania"], "topic": "Ciro como instrumento" },
    { "id": "ys056", "order": 8, "text": "Bavel e seus ídolos caem, enquanto Israel é chamado a sair e ouvir o Redentor.", "text_he": null, "refs": ["Isaiah 46:1-48:22"], "ref_start": "Isaiah 46:1", "ref_end": "Isaiah 48:22", "chapter": 46, "verse_start": 1, "verse_end_chapter": 48, "verse_end": 22, "sefaria_ref": "Isaiah 46:1-48:22", "tags": ["bavel", "ídolos", "saída"], "topic": "Queda de Bavel" }
