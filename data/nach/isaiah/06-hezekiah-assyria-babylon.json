  "identity": { "id": "hezekiah-assyria-babylon", "label": "Chizkiyahu, Assíria e Bavel", "label_pt": "Cerco de Sancheriv, oração de Chizkiyahu, cura e sinal de Bavel", "hebrew": null, "transliteration": "Hezekiah Assyria and Babylon" },
