  "timeline": { "period_name": "Chizkiyahu entre Assíria e Bavel", "anno_mundi_start": 3199, "anno_mundi_end": 3205, "era": "neviim-acharonim", "position_pct": 55, "description": "A história de Chizkiyahu mostra a eficácia da confiança em Deus e antecipa o futuro exílio babilônico." },
  "summary": { "short": "A narrativa histórica mostra confiança em Deus contra Assíria e antecipa o eixo babilônico.", "medium": "Os capítulos 36-39 ecoam Melachim: Sancheriv ameaça Yerushalayim, Ravshakeh ridiculariza a confiança em Deus, Chizkiyahu ora, e Yeshaya anuncia livramento.\n\nA cura de Chizkiyahu e a visita babilônica viram ponte literária para a segunda metade do livro, onde Bavel e consolo ganham centralidade.", "characters_main": ["Chizkiyahu", "Yeshaya", "Sancheriv", "Ravshakeh"], "characters_secondary": ["Elyakim", "Shevna", "Merodach-Baladan", "Bavel"], "themes": ["Confiança", "Oração", "Assíria", "Bavel"] },
  "facts": [
    { "id": "ys041", "order": 1, "text": "Sancheriv toma cidades fortificadas de Yehudá e envia Ravshakeh contra Yerushalayim.", "text_he": null, "refs": ["Isaiah 36:1-3"], "ref_start": "Isaiah 36:1", "ref_end": "Isaiah 36:3", "chapter": 36, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Isaiah 36:1-3", "tags": ["sancheriv", "assíria", "yerushalayim"], "topic": "Assíria ameaça" },
    { "id": "ys042", "order": 2, "text": "Ravshakeh questiona a confiança de Yehudá e tenta minar a fidelidade do povo.", "text_he": null, "refs": ["Isaiah 36:4-22"], "ref_start": "Isaiah 36:4", "ref_end": "Isaiah 36:22", "chapter": 36, "verse_start": 4, "verse_end": 22, "sefaria_ref": "Isaiah 36:4-22", "tags": ["ravshakeh", "confiança", "ameaça"], "topic": "Discurso de Ravshakeh" },
    { "id": "ys043", "order": 3, "text": "Chizkiyahu rasga suas vestes, vai à casa de Deus e busca palavra por meio de Yeshaya.", "text_he": null, "refs": ["Isaiah 37:1-7"], "ref_start": "Isaiah 37:1", "ref_end": "Isaiah 37:7", "chapter": 37, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Isaiah 37:1-7", "tags": ["chizkiyahu", "oração", "yeshaya"], "topic": "Busca profética" },
    { "id": "ys044", "order": 4, "text": "Diante da carta de Sancheriv, Chizkiyahu ora reconhecendo Deus como Rei sobre todos os reinos.", "text_he": null, "refs": ["Isaiah 37:8-20"], "ref_start": "Isaiah 37:8", "ref_end": "Isaiah 37:20", "chapter": 37, "verse_start": 8, "verse_end": 20, "sefaria_ref": "Isaiah 37:8-20", "tags": ["carta", "oração", "reino"], "topic": "Oração no Templo" },
    { "id": "ys045", "order": 5, "text": "Yeshaya responde que Tzion despreza o orgulho assírio e que Deus defenderá a cidade.", "text_he": null, "refs": ["Isaiah 37:21-35"], "ref_start": "Isaiah 37:21", "ref_end": "Isaiah 37:35", "chapter": 37, "verse_start": 21, "verse_end": 35, "sefaria_ref": "Isaiah 37:21-35", "tags": ["tzion", "defesa", "profecia"], "topic": "Resposta de Yeshaya" },
    { "id": "ys046", "order": 6, "text": "O exército assírio é ferido, e Sancheriv retorna para morrer em sua própria terra.", "text_he": null, "refs": ["Isaiah 37:36-38"], "ref_start": "Isaiah 37:36", "ref_end": "Isaiah 37:38", "chapter": 37, "verse_start": 36, "verse_end": 38, "sefaria_ref": "Isaiah 37:36-38", "tags": ["livramento", "assíria", "sancheriv"], "topic": "Queda assíria" },
    { "id": "ys047", "order": 7, "text": "Chizkiyahu adoece, ora, recebe acréscimo de vida e compõe cântico de gratidão.", "text_he": null, "refs": ["Isaiah 38:1-22"], "ref_start": "Isaiah 38:1", "ref_end": "Isaiah 38:22", "chapter": 38, "verse_start": 1, "verse_end": 22, "sefaria_ref": "Isaiah 38:1-22", "tags": ["cura", "sinal", "gratidão"], "topic": "Cura de Chizkiyahu" },
    { "id": "ys048", "order": 8, "text": "Enviados de Bavel veem os tesouros de Chizkiyahu, e Yeshaya anuncia futuro exílio babilônico.", "text_he": null, "refs": ["Isaiah 39:1-8"], "ref_start": "Isaiah 39:1", "ref_end": "Isaiah 39:8", "chapter": 39, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Isaiah 39:1-8", "tags": ["bavel", "tesouros", "exílio"], "topic": "Sinal de Bavel" }
