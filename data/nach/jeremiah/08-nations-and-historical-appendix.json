  "identity": { "id": "nations-and-historical-appendix", "label": "Nações e apêndice histórico", "label_pt": "Oráculos contra nações, queda de Bavel e relato final da destruição", "hebrew": null, "transliteration": "Nations and Historical Appendix" },
  "range": { "ref_start": "Jeremiah 46:1", "ref_end": "Jeremiah 52:34", "sefaria_ref": "Jeremiah 46:1-52:34", "chapters_covered": [46,47,48,49,50,51,52], "chapter_start": 46, "chapter_end": 52, "verse_start": 1, "verse_end_chapter": 52, "verse_end": 34 },
  "timeline": { "period_name": "Nações e memória do exílio", "anno_mundi_start": 3339, "anno_mundi_end": 3340, "era": "neviim-acharonim", "position_pct": 58, "description": "O livro amplia o juízo às nações e fecha com a queda de Yerushalayim e uma ponta de esperança para Yehoyachin." },
  "summary": { "short": "As nações também são julgadas, Bavel cairá, e o livro fecha com memória histórica do exílio.", "medium": "Yirmiyahu mostra que o juízo não se limita a Yehudá. Egito, Pelishtim, Moav, Amon, Edom, Damasco, Kedar, Elam e Bavel estão dentro da soberania divina.\n\nO apêndice histórico retoma a destruição de Yerushalayim e termina com a elevação de Yehoyachin no exílio, pequena abertura de esperança.", "characters_main": ["Egito", "Moav", "Edom", "Bavel", "Yehoyachin"], "characters_secondary": ["Pelishtim", "Amon", "Damasco", "Elam", "Nevuchadnetzar"], "themes": ["Nações", "Bavel", "Destruição", "Esperança"] },
  "facts": [
    { "id": "jr057", "order": 1, "text": "O Egito é julgado após sua derrota, mas recebe também promessa de restauração futura.", "text_he": null, "refs": ["Jeremiah 46:1-28"], "ref_start": "Jeremiah 46:1", "ref_end": "Jeremiah 46:28", "chapter": 46, "verse_start": 1, "verse_end": 28, "sefaria_ref": "Jeremiah 46:1-28", "tags": ["egito", "nações", "restauração"], "topic": "Oráculo contra Egito" },
    { "id": "jr058", "order": 2, "text": "Pelishtim é retratada diante de águas vindas do norte, imagem de invasão devastadora.", "text_he": null, "refs": ["Jeremiah 47:1-7"], "ref_start": "Jeremiah 47:1", "ref_end": "Jeremiah 47:7", "chapter": 47, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Jeremiah 47:1-7", "tags": ["pelishtim", "norte", "juízo"], "topic": "Oráculo contra Pelishtim" },
    { "id": "jr059", "order": 3, "text": "Moav é lamentado e julgado por orgulho, mas o fim do oráculo preserva promessa de restauração.", "text_he": null, "refs": ["Jeremiah 48:1-47"], "ref_start": "Jeremiah 48:1", "ref_end": "Jeremiah 48:47", "chapter": 48, "verse_start": 1, "verse_end": 47, "sefaria_ref": "Jeremiah 48:1-47", "tags": ["moav", "orgulho", "lamento"], "topic": "Oráculo contra Moav" },
    { "id": "jr060", "order": 4, "text": "Amon, Edom, Damasco, Kedar, Chatzor e Elam entram na série de julgamentos às nações.", "text_he": null, "refs": ["Jeremiah 49:1-39"], "ref_start": "Jeremiah 49:1", "ref_end": "Jeremiah 49:39", "chapter": 49, "verse_start": 1, "verse_end": 39, "sefaria_ref": "Jeremiah 49:1-39", "tags": ["amon", "edom", "elam"], "topic": "Nações vizinhas" },
    { "id": "jr061", "order": 5, "text": "Bavel, instrumento do juízo, também será julgada e Israel será chamado a sair dela.", "text_he": null, "refs": ["Jeremiah 50:1-46"], "ref_start": "Jeremiah 50:1", "ref_end": "Jeremiah 50:46", "chapter": 50, "verse_start": 1, "verse_end": 46, "sefaria_ref": "Jeremiah 50:1-46", "tags": ["bavel", "saída", "israel"], "topic": "Queda de Bavel" },
    { "id": "jr062", "order": 6, "text": "Yirmiyahu ordena que o rolo contra Bavel seja lançado no Eufrates como sinal de sua queda.", "text_he": null, "refs": ["Jeremiah 51:1-64"], "ref_start": "Jeremiah 51:1", "ref_end": "Jeremiah 51:64", "chapter": 51, "verse_start": 1, "verse_end": 64, "sefaria_ref": "Jeremiah 51:1-64", "tags": ["bavel", "eufrates", "sinal"], "topic": "Rolo no Eufrates" },
    { "id": "jr063", "order": 7, "text": "O apêndice narra a queda de Yerushalayim, destruição do Templo e deportações.", "text_he": null, "refs": ["Jeremiah 52:1-30"], "ref_start": "Jeremiah 52:1", "ref_end": "Jeremiah 52:30", "chapter": 52, "verse_start": 1, "verse_end": 30, "sefaria_ref": "Jeremiah 52:1-30", "tags": ["yerushalayim", "templo", "exílio"], "topic": "Apêndice da destruição" },
    { "id": "jr064", "order": 8, "text": "Yehoyachin é elevado na Babilônia, encerrando o livro com sinal discreto de continuidade davídica.", "text_he": null, "refs": ["Jeremiah 52:31-34"], "ref_start": "Jeremiah 52:31", "ref_end": "Jeremiah 52:34", "chapter": 52, "verse_start": 31, "verse_end": 34, "sefaria_ref": "Jeremiah 52:31-34", "tags": ["yehoyachin", "david", "esperança"], "topic": "Yehoyachin elevado" }
