    { "id": "jr019", "order": 3, "text": "Yirmiyahu pergunta por que o caminho dos ímpios prospera, e recebe resposta que amplia sua prova.", "text_he": null, "refs": ["Jeremiah 12:1-17"], "ref_start": "Jeremiah 12:1", "ref_end": "Jeremiah 12:17", "chapter": 12, "verse_start": 1, "verse_end": 17, "sefaria_ref": "Jeremiah 12:1-17", "tags": ["confissão", "justiça", "prova"], "topic": "Pergunta do profeta" },
    { "id": "jr020", "order": 4, "text": "O cinto de linho arruinado simboliza orgulho corrompido e perda de proximidade com Deus.", "text_he": null, "refs": ["Jeremiah 13:1-11"], "ref_start": "Jeremiah 13:1", "ref_end": "Jeremiah 13:11", "chapter": 13, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Jeremiah 13:1-11", "tags": ["sinal", "cinto", "orgulho"], "topic": "Cinto arruinado" },
