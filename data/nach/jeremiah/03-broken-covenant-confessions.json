    { "id": "jr022", "order": 6, "text": "Yirmiyahu lamenta sua missão dolorosa, mas é chamado a permanecer como boca fiel de Deus.", "text_he": null, "refs": ["Jeremiah 15:10-21"], "ref_start": "Jeremiah 15:10", "ref_end": "Jeremiah 15:21", "chapter": 15, "verse_start": 10, "verse_end": 21, "sefaria_ref": "Jeremiah 15:10-21", "tags": ["confissão", "missão", "palavra"], "topic": "Dor do profeta" },
