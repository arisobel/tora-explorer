  "identity": { "id": "yoke-false-prophets-restoration", "label": "Jugo, falsos profetas e restauração", "label_pt": "Aceitar Bavel, carta aos exilados, promessa de retorno e nova aliança", "hebrew": null, "transliteration": "Yoke False Prophets and Restoration" },
  "range": { "ref_start": "Jeremiah 26:1", "ref_end": "Jeremiah 33:26", "sefaria_ref": "Jeremiah 26:1-33:26", "chapters_covered": [26,27,28,29,30,31,32,33], "chapter_start": 26, "chapter_end": 33, "verse_start": 1, "verse_end_chapter": 33, "verse_end": 26 },
  "timeline": { "period_name": "Jugo e restauração", "anno_mundi_start": 3327, "anno_mundi_end": 3336, "era": "neviim-acharonim", "position_pct": 58, "description": "Entre conflito público e promessas futuras, Yirmiyahu ensina que aceitar o exílio abre caminho para restauração." },
  "summary": { "short": "Yirmiyahu confronta profetas de paz ilusória e anuncia restauração futura de Israel e Yehudá.", "medium": "O Templo e a corte entram novamente em conflito com Yirmiyahu. A mensagem de submeter-se a Bavel contraria expectativas nacionalistas e falsos profetas.\n\nNo centro do livro aparecem palavras de consolação: retorno, nova aliança, compra do campo e promessa de renovação davídica.", "characters_main": ["Yirmiyahu", "Chananyah", "Baruch", "Exilados", "Tzidkiyahu"], "characters_secondary": ["Anciãos", "Sacerdotes", "Anameel", "David"], "themes": ["Bavel", "Falsos profetas", "Exílio", "Nova aliança"] },
  "facts": [
    { "id": "jr033", "order": 1, "text": "Yirmiyahu é ameaçado de morte após profetizar que o Templo pode tornar-se como Shiloh.", "text_he": null, "refs": ["Jeremiah 26:1-24"], "ref_start": "Jeremiah 26:1", "ref_end": "Jeremiah 26:24", "chapter": 26, "verse_start": 1, "verse_end": 24, "sefaria_ref": "Jeremiah 26:1-24", "tags": ["templo", "shiloh", "julgamento"], "topic": "Julgamento no Templo" },
    { "id": "jr034", "order": 2, "text": "O jugo simboliza que Yehudá e as nações devem servir a Bavel por um período determinado.", "text_he": null, "refs": ["Jeremiah 27:1-22"], "ref_start": "Jeremiah 27:1", "ref_end": "Jeremiah 27:22", "chapter": 27, "verse_start": 1, "verse_end": 22, "sefaria_ref": "Jeremiah 27:1-22", "tags": ["jugo", "bavel", "nações"], "topic": "Jugo de Bavel" },
    { "id": "jr035", "order": 3, "text": "Chananyah quebra o jugo de madeira prometendo libertação rápida, mas Yirmiyahu anuncia jugo de ferro.", "text_he": null, "refs": ["Jeremiah 28:1-17"], "ref_start": "Jeremiah 28:1", "ref_end": "Jeremiah 28:17", "chapter": 28, "verse_start": 1, "verse_end": 17, "sefaria_ref": "Jeremiah 28:1-17", "tags": ["chananyah", "falso-profeta", "jugo"], "topic": "Chananyah" },
    { "id": "jr036", "order": 4, "text": "A carta aos exilados manda construir casas, plantar jardins e buscar a paz da cidade onde estão.", "text_he": null, "refs": ["Jeremiah 29:1-14"], "ref_start": "Jeremiah 29:1", "ref_end": "Jeremiah 29:14", "chapter": 29, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Jeremiah 29:1-14", "tags": ["exílio", "carta", "paz"], "topic": "Carta aos exilados" },
    { "id": "jr037", "order": 5, "text": "Yirmiyahu promete restauração após tempo de angústia, com retorno de Yaakov e cura das feridas.", "text_he": null, "refs": ["Jeremiah 30:1-24"], "ref_start": "Jeremiah 30:1", "ref_end": "Jeremiah 30:24", "chapter": 30, "verse_start": 1, "verse_end": 24, "sefaria_ref": "Jeremiah 30:1-24", "tags": ["restauração", "cura", "yaakov"], "topic": "Livro da consolação" },
    { "id": "jr038", "order": 6, "text": "Rachel chora por seus filhos, mas Deus promete retorno, reconstrução e nova aliança escrita no coração.", "text_he": null, "refs": ["Jeremiah 31:1-39"], "ref_start": "Jeremiah 31:1", "ref_end": "Jeremiah 31:39", "chapter": 31, "verse_start": 1, "verse_end": 39, "sefaria_ref": "Jeremiah 31:1-39", "tags": ["rachel", "nova-aliança", "retorno"], "topic": "Nova aliança" },
    { "id": "jr039", "order": 7, "text": "Durante o cerco, Yirmiyahu compra um campo em Anatot como sinal de que terras voltarão a ser compradas.", "text_he": null, "refs": ["Jeremiah 32:1-44"], "ref_start": "Jeremiah 32:1", "ref_end": "Jeremiah 32:44", "chapter": 32, "verse_start": 1, "verse_end": 44, "sefaria_ref": "Jeremiah 32:1-44", "tags": ["campo", "anatot", "esperança"], "topic": "Compra do campo" },
    { "id": "jr040", "order": 8, "text": "Deus promete cura, retorno, voz de alegria e continuidade da aliança com David e os kohanim.", "text_he": null, "refs": ["Jeremiah 33:1-26"], "ref_start": "Jeremiah 33:1", "ref_end": "Jeremiah 33:26", "chapter": 33, "verse_start": 1, "verse_end": 26, "sefaria_ref": "Jeremiah 33:1-26", "tags": ["david", "cura", "aliança"], "topic": "Ramo de justiça" }
