  "timeline": { "period_name": "Remanescente após a queda", "anno_mundi_start": 3339, "anno_mundi_end": 3340, "era": "neviim-acharonim", "position_pct": 58, "description": "Depois da destruição, o remanescente ainda precisa escolher entre confiar na palavra de Deus ou fugir para o Egito." },
  "summary": { "short": "Após a destruição, o remanescente rejeita orientação e leva Yirmiyahu ao Egito.", "medium": "Com Gedalyahu, parece haver possibilidade de reorganização em Yehudá. Seu assassinato rompe essa chance e gera pânico.\n\nO povo pede direção a Yirmiyahu, mas rejeita a resposta quando ela contraria o desejo de fugir para o Egito. A unidade fecha com juízo no Egito e uma palavra pessoal a Baruch.", "characters_main": ["Yirmiyahu", "Gedalyahu", "Yishmael", "Yochanan", "Baruch"], "characters_secondary": ["Nevuzaradan", "Remanescente", "Rainha dos céus"], "themes": ["Remanescente", "Egito", "Rejeição", "Baruch"] },
  "facts": [
    { "id": "jr049", "order": 1, "text": "Nevuzaradan liberta Yirmiyahu, que permanece com Gedalyahu entre o povo deixado na terra.", "text_he": null, "refs": ["Jeremiah 40:1-6"], "ref_start": "Jeremiah 40:1", "ref_end": "Jeremiah 40:6", "chapter": 40, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Jeremiah 40:1-6", "tags": ["libertação", "gedalyahu", "remanescente"], "topic": "Yirmiyahu liberto" },
    { "id": "jr050", "order": 2, "text": "Gedalyahu incentiva o remanescente a viver na terra sob domínio babilônico.", "text_he": null, "refs": ["Jeremiah 40:7-16"], "ref_start": "Jeremiah 40:7", "ref_end": "Jeremiah 40:16", "chapter": 40, "verse_start": 7, "verse_end": 16, "sefaria_ref": "Jeremiah 40:7-16", "tags": ["gedalyahu", "bavel", "terra"], "topic": "Governo de Gedalyahu" },
    { "id": "jr051", "order": 3, "text": "Yishmael assassina Gedalyahu em Mitzpah, aprofundando a ruptura do remanescente.", "text_he": null, "refs": ["Jeremiah 41:1-18"], "ref_start": "Jeremiah 41:1", "ref_end": "Jeremiah 41:18", "chapter": 41, "verse_start": 1, "verse_end": 18, "sefaria_ref": "Jeremiah 41:1-18", "tags": ["yishmael", "gedalyahu", "mitzpah"], "topic": "Assassinato de Gedalyahu" },
    { "id": "jr052", "order": 4, "text": "O remanescente pede a Yirmiyahu orientação divina antes de decidir se fugirá para o Egito.", "text_he": null, "refs": ["Jeremiah 42:1-6"], "ref_start": "Jeremiah 42:1", "ref_end": "Jeremiah 42:6", "chapter": 42, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Jeremiah 42:1-6", "tags": ["consulta", "remanescente", "egito"], "topic": "Pedido de orientação" },
    { "id": "jr053", "order": 5, "text": "Deus manda permanecer na terra e adverte que fugir para o Egito trará espada, fome e peste.", "text_he": null, "refs": ["Jeremiah 42:7-22"], "ref_start": "Jeremiah 42:7", "ref_end": "Jeremiah 42:22", "chapter": 42, "verse_start": 7, "verse_end": 22, "sefaria_ref": "Jeremiah 42:7-22", "tags": ["permanecer", "egito", "advertência"], "topic": "Resposta divina" },
    { "id": "jr054", "order": 6, "text": "Yochanan e os líderes acusam Yirmiyahu de falsidade e levam o povo ao Egito.", "text_he": null, "refs": ["Jeremiah 43:1-7"], "ref_start": "Jeremiah 43:1", "ref_end": "Jeremiah 43:7", "chapter": 43, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Jeremiah 43:1-7", "tags": ["yochanan", "egito", "rejeição"], "topic": "Descida ao Egito" },
    { "id": "jr055", "order": 7, "text": "No Egito, Yirmiyahu anuncia que Nevuchadnetzar alcançará a terra onde o povo buscou refúgio.", "text_he": null, "refs": ["Jeremiah 43:8-44:30"], "ref_start": "Jeremiah 43:8", "ref_end": "Jeremiah 44:30", "chapter": 43, "verse_start": 8, "verse_end_chapter": 44, "verse_end": 30, "sefaria_ref": "Jeremiah 43:8-44:30", "tags": ["egito", "nevuchadnetzar", "idolatria"], "topic": "Juízo no Egito" },
    { "id": "jr056", "order": 8, "text": "Baruch recebe palavra pessoal: não buscar grandezas, mas preservar a vida em meio ao juízo.", "text_he": null, "refs": ["Jeremiah 45:1-5"], "ref_start": "Jeremiah 45:1", "ref_end": "Jeremiah 45:5", "chapter": 45, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Jeremiah 45:1-5", "tags": ["baruch", "vida", "consolo"], "topic": "Palavra a Baruch" }
