  "identity": { "id": "final-siege-and-fall", "label": "Cerco final e queda", "label_pt": "Tzidkiyahu, quebra de libertação, prisão de Yirmiyahu e queda de Yerushalayim", "hebrew": null, "transliteration": "Final Siege and Fall" },
  "range": { "ref_start": "Jeremiah 34:1", "ref_end": "Jeremiah 39:18", "sefaria_ref": "Jeremiah 34:1-39:18", "chapters_covered": [34,35,36,37,38,39], "chapter_start": 34, "chapter_end": 39, "verse_start": 1, "verse_end_chapter": 39, "verse_end": 18 },
  "timeline": { "period_name": "Queda de Yerushalayim", "anno_mundi_start": 3336, "anno_mundi_end": 3339, "era": "neviim-acharonim", "position_pct": 58, "description": "O cerco final revela a recusa persistente da palavra profética e culmina na destruição política de Yehudá." },
  "summary": { "short": "Durante o cerco, a rejeição da palavra profética culmina na queda de Yerushalayim.", "medium": "Tzidkiyahu recebe mensagens de rendição a Bavel, mas alterna consulta e medo. A libertação dos escravos é revertida, mostrando a quebra interna da aliança.\n\nYirmiyahu é preso e lançado numa cisterna, mas preservado por Eved-Melech. A cidade cai, Tzidkiyahu é capturado e a palavra profética se cumpre.", "characters_main": ["Yirmiyahu", "Tzidkiyahu", "Eved-Melech", "Nevuchadnetzar"], "characters_secondary": ["Recabitas", "Baruch", "Yehoyakim", "Oficiais"], "themes": ["Cerco", "Escravos", "Rolo", "Queda"] },
  "facts": [
    { "id": "jr041", "order": 1, "text": "Yirmiyahu anuncia a Tzidkiyahu que Yerushalayim será entregue a Bavel.", "text_he": null, "refs": ["Jeremiah 34:1-7"], "ref_start": "Jeremiah 34:1", "ref_end": "Jeremiah 34:7", "chapter": 34, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Jeremiah 34:1-7", "tags": ["tzidkiyahu", "bavel", "cerco"], "topic": "Destino de Tzidkiyahu" },
    { "id": "jr042", "order": 2, "text": "Yehudá liberta escravos hebreus e depois os toma de volta, quebrando a aliança.", "text_he": null, "refs": ["Jeremiah 34:8-22"], "ref_start": "Jeremiah 34:8", "ref_end": "Jeremiah 34:22", "chapter": 34, "verse_start": 8, "verse_end": 22, "sefaria_ref": "Jeremiah 34:8-22", "tags": ["escravos", "aliança", "injustiça"], "topic": "Libertação revertida" },
    { "id": "jr043", "order": 3, "text": "Os recabitas obedecem ao mandamento de seu ancestral, contrastando com a desobediência de Yehudá.", "text_he": null, "refs": ["Jeremiah 35:1-19"], "ref_start": "Jeremiah 35:1", "ref_end": "Jeremiah 35:19", "chapter": 35, "verse_start": 1, "verse_end": 19, "sefaria_ref": "Jeremiah 35:1-19", "tags": ["recabitas", "obediência", "contraste"], "topic": "Recabitas" },
    { "id": "jr044", "order": 4, "text": "Baruch escreve as palavras de Yirmiyahu em um rolo para serem lidas publicamente.", "text_he": null, "refs": ["Jeremiah 36:1-10"], "ref_start": "Jeremiah 36:1", "ref_end": "Jeremiah 36:10", "chapter": 36, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Jeremiah 36:1-10", "tags": ["baruch", "rolo", "palavra"], "topic": "Rolo escrito" },
    { "id": "jr045", "order": 5, "text": "Yehoyakim corta e queima o rolo, mas Deus ordena que ele seja reescrito com palavras adicionais.", "text_he": null, "refs": ["Jeremiah 36:11-32"], "ref_start": "Jeremiah 36:11", "ref_end": "Jeremiah 36:32", "chapter": 36, "verse_start": 11, "verse_end": 32, "sefaria_ref": "Jeremiah 36:11-32", "tags": ["yehoyakim", "rolo", "rejeição"], "topic": "Rolo queimado" },
    { "id": "jr046", "order": 6, "text": "Yirmiyahu é preso acusado de desertar para os babilônios, embora continue anunciando a queda.", "text_he": null, "refs": ["Jeremiah 37:1-21"], "ref_start": "Jeremiah 37:1", "ref_end": "Jeremiah 37:21", "chapter": 37, "verse_start": 1, "verse_end": 21, "sefaria_ref": "Jeremiah 37:1-21", "tags": ["prisão", "acusação", "queda"], "topic": "Prisão do profeta" },
    { "id": "jr047", "order": 7, "text": "Yirmiyahu é lançado numa cisterna, mas Eved-Melech intercede e o resgata.", "text_he": null, "refs": ["Jeremiah 38:1-28"], "ref_start": "Jeremiah 38:1", "ref_end": "Jeremiah 38:28", "chapter": 38, "verse_start": 1, "verse_end": 28, "sefaria_ref": "Jeremiah 38:1-28", "tags": ["cisterna", "eved-melech", "resgate"], "topic": "Cisterna" },
    { "id": "jr048", "order": 8, "text": "Yerushalayim cai; Tzidkiyahu é capturado, e Yirmiyahu é protegido conforme ordem babilônica.", "text_he": null, "refs": ["Jeremiah 39:1-18"], "ref_start": "Jeremiah 39:1", "ref_end": "Jeremiah 39:18", "chapter": 39, "verse_start": 1, "verse_end": 18, "sefaria_ref": "Jeremiah 39:1-18", "tags": ["queda", "tzidkiyahu", "proteção"], "topic": "Queda da cidade" }
  ]
