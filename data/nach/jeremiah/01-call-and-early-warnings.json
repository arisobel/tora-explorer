  "timeline": { "period_name": "Chamado de Yirmiyahu", "anno_mundi_start": 3298, "anno_mundi_end": 3305, "era": "neviim-acharonim", "position_pct": 57, "description": "Yirmiyahu é chamado em meio ao declínio final de Yehudá e recebe missão de arrancar e plantar." },
  "summary": { "short": "Yirmiyahu é chamado como profeta e denuncia a infidelidade que ameaça Yerushalayim.", "medium": "O livro abre com Yirmiyahu ainda jovem, chamado para falar às nações e a Yehudá. As visões iniciais anunciam vigilância divina e perigo vindo do norte.\n\nOs capítulos seguintes recordam a fidelidade inicial de Israel e expõem a troca de Deus por cisternas rachadas, chamando o povo ao retorno.", "characters_main": ["Yirmiyahu", "Yoshiyahu", "Yehudah", "Yerushalayim"], "characters_secondary": ["Anatot", "Israel", "Inimigo do norte"], "themes": ["Chamado", "Teshuvah", "Infidelidade", "Norte"] },
  "facts": [
    { "id": "jr001", "order": 1, "text": "Yirmiyahu é apresentado como profeta desde os dias de Yoshiyahu até o exílio de Yerushalayim.", "text_he": null, "refs": ["Jeremiah 1:1-3"], "ref_start": "Jeremiah 1:1", "ref_end": "Jeremiah 1:3", "chapter": 1, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Jeremiah 1:1-3", "tags": ["yirmiyahu", "yoshiyahu", "exílio"], "topic": "Abertura histórica" },
    { "id": "jr002", "order": 2, "text": "Deus chama Yirmiyahu desde o ventre e o designa profeta às nações.", "text_he": null, "refs": ["Jeremiah 1:4-10"], "ref_start": "Jeremiah 1:4", "ref_end": "Jeremiah 1:10", "chapter": 1, "verse_start": 4, "verse_end": 10, "sefaria_ref": "Jeremiah 1:4-10", "tags": ["chamado", "nações", "missão"], "topic": "Chamado profético" },
    { "id": "jr003", "order": 3, "text": "As visões da vara de amendoeira e da panela fervente anunciam vigilância divina e ameaça do norte.", "text_he": null, "refs": ["Jeremiah 1:11-19"], "ref_start": "Jeremiah 1:11", "ref_end": "Jeremiah 1:19", "chapter": 1, "verse_start": 11, "verse_end": 19, "sefaria_ref": "Jeremiah 1:11-19", "tags": ["visão", "norte", "vigilância"], "topic": "Primeiras visões" },
    { "id": "jr004", "order": 4, "text": "Deus recorda o amor inicial de Israel no deserto e contrasta com sua infidelidade posterior.", "text_he": null, "refs": ["Jeremiah 2:1-13"], "ref_start": "Jeremiah 2:1", "ref_end": "Jeremiah 2:13", "chapter": 2, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Jeremiah 2:1-13", "tags": ["deserto", "aliança", "infidelidade"], "topic": "Amor inicial" },
    { "id": "jr005", "order": 5, "text": "Israel troca a fonte de águas vivas por cisternas rachadas que não retêm água.", "text_he": null, "refs": ["Jeremiah 2:13"], "ref_start": "Jeremiah 2:13", "ref_end": "Jeremiah 2:13", "chapter": 2, "verse_start": 13, "verse_end": 13, "sefaria_ref": "Jeremiah 2:13", "tags": ["águas", "idolatria", "metáfora"], "topic": "Cisternas rachadas" },
    { "id": "jr006", "order": 6, "text": "O profeta chama Israel e Yehudá a retornar, apesar da traição e da vergonha acumulada.", "text_he": null, "refs": ["Jeremiah 3:1-4:4"], "ref_start": "Jeremiah 3:1", "ref_end": "Jeremiah 4:4", "chapter": 3, "verse_start": 1, "verse_end_chapter": 4, "verse_end": 4, "sefaria_ref": "Jeremiah 3:1-4:4", "tags": ["teshuvah", "retorno", "yisrael"], "topic": "Chamado ao retorno" },
    { "id": "jr007", "order": 7, "text": "Uma invasão do norte é descrita como leão, vento e destruição que se aproxima de Yerushalayim.", "text_he": null, "refs": ["Jeremiah 4:5-31"], "ref_start": "Jeremiah 4:5", "ref_end": "Jeremiah 4:31", "chapter": 4, "verse_start": 5, "verse_end": 31, "sefaria_ref": "Jeremiah 4:5-31", "tags": ["norte", "invasão", "yerushalayim"], "topic": "Ameaça do norte" },
    { "id": "jr008", "order": 8, "text": "Yehudah é examinado como metal impuro; a corrupção social impede que a cidade seja poupada.", "text_he": null, "refs": ["Jeremiah 5:1-6:30"], "ref_start": "Jeremiah 5:1", "ref_end": "Jeremiah 6:30", "chapter": 5, "verse_start": 1, "verse_end_chapter": 6, "verse_end": 30, "sefaria_ref": "Jeremiah 5:1-6:30", "tags": ["corrupção", "metal", "justiça"], "topic": "Cidade examinada" }
