  "timeline": { "period_name": "Conflito com autoridades", "anno_mundi_start": 3320, "anno_mundi_end": 3327, "era": "neviim-acharonim", "position_pct": 57, "description": "Sinais públicos e rolos escritos tornam a palavra profética incontornável para reis, sacerdotes e povo." },
  "summary": { "short": "A palavra profética entra em conflito direto com autoridades e anuncia domínio babilônico.", "medium": "A casa do oleiro e o vaso quebrado dramatizam a possibilidade de remodelagem ou destruição. A perseguição de Pashchur e o lamento de Yirmiyahu revelam o custo da missão.\n\nCom Baruch, a palavra é escrita em rolo. Yehoyakim queima o rolo, mas a profecia é reescrita e o domínio de Bavel é anunciado como etapa histórica inevitável.", "characters_main": ["Yirmiyahu", "Pashchur", "Yehoyakim", "Baruch", "Nevuchadnetzar"], "characters_secondary": ["Oleiro", "Pastores", "Bons figos", "Maus figos"], "themes": ["Sinal", "Conflito", "Rolo", "Bavel"] },
  "facts": [
    { "id": "jr025", "order": 1, "text": "Na casa do oleiro, Yirmiyahu aprende que Deus pode remodelar nações conforme sua resposta moral.", "text_he": null, "refs": ["Jeremiah 18:1-12"], "ref_start": "Jeremiah 18:1", "ref_end": "Jeremiah 18:12", "chapter": 18, "verse_start": 1, "verse_end": 12, "sefaria_ref": "Jeremiah 18:1-12", "tags": ["oleiro", "nações", "teshuvah"], "topic": "Casa do oleiro" },
    { "id": "jr026", "order": 2, "text": "A conspiração contra Yirmiyahu cresce porque sua mensagem ameaça planos estabelecidos.", "text_he": null, "refs": ["Jeremiah 18:13-23"], "ref_start": "Jeremiah 18:13", "ref_end": "Jeremiah 18:23", "chapter": 18, "verse_start": 13, "verse_end": 23, "sefaria_ref": "Jeremiah 18:13-23", "tags": ["conspiração", "rejeição", "profecia"], "topic": "Planos contra o profeta" },
    { "id": "jr027", "order": 3, "text": "O vaso quebrado em Ben-Hinom simboliza destruição irreversível para cidade e liderança.", "text_he": null, "refs": ["Jeremiah 19:1-15"], "ref_start": "Jeremiah 19:1", "ref_end": "Jeremiah 19:15", "chapter": 19, "verse_start": 1, "verse_end": 15, "sefaria_ref": "Jeremiah 19:1-15", "tags": ["vaso", "ben-hinom", "juízo"], "topic": "Vaso quebrado" },
    { "id": "jr028", "order": 4, "text": "Pashchur fere Yirmiyahu e o prende; o profeta anuncia terror e exílio contra ele.", "text_he": null, "refs": ["Jeremiah 20:1-6"], "ref_start": "Jeremiah 20:1", "ref_end": "Jeremiah 20:6", "chapter": 20, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Jeremiah 20:1-6", "tags": ["pashchur", "prisão", "exílio"], "topic": "Pashchur" },
    { "id": "jr029", "order": 5, "text": "Yirmiyahu lamenta que a palavra de Deus arde em seus ossos e não pode ser contida.", "text_he": null, "refs": ["Jeremiah 20:7-18"], "ref_start": "Jeremiah 20:7", "ref_end": "Jeremiah 20:18", "chapter": 20, "verse_start": 7, "verse_end": 18, "sefaria_ref": "Jeremiah 20:7-18", "tags": ["confissão", "fogo", "palavra"], "topic": "Fogo nos ossos" },
    { "id": "jr030", "order": 6, "text": "Reis e pastores são julgados, mas surge promessa de um ramo justo da casa de David.", "text_he": null, "refs": ["Jeremiah 21:1-23:8"], "ref_start": "Jeremiah 21:1", "ref_end": "Jeremiah 23:8", "chapter": 21, "verse_start": 1, "verse_end_chapter": 23, "verse_end": 8, "sefaria_ref": "Jeremiah 21:1-23:8", "tags": ["reis", "pastores", "ramo"], "topic": "Pastores e ramo justo" },
    { "id": "jr031", "order": 7, "text": "A visão dos figos distingue exilados que serão restaurados e liderança remanescente que caminha para juízo.", "text_he": null, "refs": ["Jeremiah 24:1-10"], "ref_start": "Jeremiah 24:1", "ref_end": "Jeremiah 24:10", "chapter": 24, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Jeremiah 24:1-10", "tags": ["figos", "exílio", "restauração"], "topic": "Bons e maus figos" },
    { "id": "jr032", "order": 8, "text": "Yirmiyahu anuncia setenta anos de domínio babilônico e juízo também contra Bavel depois.", "text_he": null, "refs": ["Jeremiah 25:1-38"], "ref_start": "Jeremiah 25:1", "ref_end": "Jeremiah 25:38", "chapter": 25, "verse_start": 1, "verse_end": 38, "sefaria_ref": "Jeremiah 25:1-38", "tags": ["setenta-anos", "bavel", "nações"], "topic": "Setenta anos" }
