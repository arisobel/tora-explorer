  "timeline": { "period_name": "Sermão do Templo", "anno_mundi_start": 3305, "anno_mundi_end": 3310, "era": "neviim-acharonim", "position_pct": 57, "description": "Yirmiyahu confronta a falsa segurança religiosa que separa Templo, justiça e fidelidade." },
  "summary": { "short": "O Templo não protege um povo que pratica injustiça, idolatria e recusa a correção.", "medium": "Yirmiyahu proclama no portão do Templo que a presença do santuário não é garantia mágica. Sem justiça, o Templo pode seguir o destino de Shiloh.\n\nA unidade alterna advertência, lamento e crítica aos ídolos, mostrando que sabedoria verdadeira começa no conhecimento de Deus.", "characters_main": ["Yirmiyahu", "Yehudah", "Yerushalayim"], "characters_secondary": ["Shiloh", "Rainha dos céus", "Ídolos"], "themes": ["Templo", "Justiça", "Idolatria", "Lamento"] },
  "facts": [
    { "id": "jr009", "order": 1, "text": "Yirmiyahu é enviado ao portão do Templo para chamar o povo a corrigir seus caminhos.", "text_he": null, "refs": ["Jeremiah 7:1-7"], "ref_start": "Jeremiah 7:1", "ref_end": "Jeremiah 7:7", "chapter": 7, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Jeremiah 7:1-7", "tags": ["templo", "teshuvah", "justiça"], "topic": "Portão do Templo" },
    { "id": "jr010", "order": 2, "text": "O povo repete 'Templo de Deus' enquanto pratica roubo, injustiça e idolatria.", "text_he": null, "refs": ["Jeremiah 7:8-15"], "ref_start": "Jeremiah 7:8", "ref_end": "Jeremiah 7:15", "chapter": 7, "verse_start": 8, "verse_end": 15, "sefaria_ref": "Jeremiah 7:8-15", "tags": ["falsa-segurança", "templo", "shiloh"], "topic": "Falsa confiança" },
    { "id": "jr011", "order": 3, "text": "O culto à rainha dos céus revela idolatria familiar e persistente em Yehudah.", "text_he": null, "refs": ["Jeremiah 7:16-20"], "ref_start": "Jeremiah 7:16", "ref_end": "Jeremiah 7:20", "chapter": 7, "verse_start": 16, "verse_end": 20, "sefaria_ref": "Jeremiah 7:16-20", "tags": ["idolatria", "família", "rainha-dos-céus"], "topic": "Rainha dos céus" },
    { "id": "jr012", "order": 4, "text": "Deus ressalta que a obediência à voz da aliança precede qualquer sistema sacrificial.", "text_he": null, "refs": ["Jeremiah 7:21-28"], "ref_start": "Jeremiah 7:21", "ref_end": "Jeremiah 7:28", "chapter": 7, "verse_start": 21, "verse_end": 28, "sefaria_ref": "Jeremiah 7:21-28", "tags": ["obediência", "sacrifícios", "aliança"], "topic": "Obediência e culto" },
    { "id": "jr013", "order": 5, "text": "Tofet e Ben-Hinom são denunciados como lugar de violência cultual e juízo.", "text_he": null, "refs": ["Jeremiah 7:29-8:3"], "ref_start": "Jeremiah 7:29", "ref_end": "Jeremiah 8:3", "chapter": 7, "verse_start": 29, "verse_end_chapter": 8, "verse_end": 3, "sefaria_ref": "Jeremiah 7:29-8:3", "tags": ["tofet", "ben-hinom", "juízo"], "topic": "Tofet" },
    { "id": "jr014", "order": 6, "text": "Yirmiyahu lamenta a falsa paz proclamada por líderes que não curam a ferida do povo.", "text_he": null, "refs": ["Jeremiah 8:4-22"], "ref_start": "Jeremiah 8:4", "ref_end": "Jeremiah 8:22", "chapter": 8, "verse_start": 4, "verse_end": 22, "sefaria_ref": "Jeremiah 8:4-22", "tags": ["falsa-paz", "ferida", "lamento"], "topic": "Ferida sem cura" },
    { "id": "jr015", "order": 7, "text": "O profeta chora pela ruína moral do povo e contrasta orgulho com conhecer Deus em bondade, justiça e retidão.", "text_he": null, "refs": ["Jeremiah 9:1-25"], "ref_start": "Jeremiah 9:1", "ref_end": "Jeremiah 9:25", "chapter": 9, "verse_start": 1, "verse_end": 25, "sefaria_ref": "Jeremiah 9:1-25", "tags": ["lamento", "conhecimento-de-deus", "justiça"], "topic": "Conhecer Deus" },
    { "id": "jr016", "order": 8, "text": "Ídolos são ridicularizados como obra humana, enquanto Deus é Rei vivo e Criador.", "text_he": null, "refs": ["Jeremiah 10:1-25"], "ref_start": "Jeremiah 10:1", "ref_end": "Jeremiah 10:25", "chapter": 10, "verse_start": 1, "verse_end": 25, "sefaria_ref": "Jeremiah 10:1-25", "tags": ["ídolos", "criador", "rei"], "topic": "Ídolos e Criador" }
