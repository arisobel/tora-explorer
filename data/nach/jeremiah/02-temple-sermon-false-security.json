  "identity": { "id": "temple-sermon-false-security", "label": "Sermão do Templo e falsa segurança", "label_pt": "Crítica ao culto vazio, idolatria e confiança automática no Templo", "hebrew": null, "transliteration": "Temple Sermon and False Security" },
