  "summary": { "short": "O reino de David se expande, mas o pecado com Bat Sheva desencadeia crise profunda na casa real.", "medium": "David vence inimigos ao redor e organiza justiça no reino. Sua bondade com Mephiboshet preserva a aliança com Yonatan.\n\nNo ponto de maior estabilidade, o episódio com Bat Sheva e Uriyah abre uma ferida na casa real. A repreensão de Natan, a morte da criança, o caso de Amnon e Tamar e a rebelião de Avshalom revelam consequências internas de longo alcance.", "characters_main": ["David", "Bat Sheva", "Uriyah", "Natan", "Amnon", "Tamar", "Avshalom", "Yoav"], "characters_secondary": ["Mephiboshet", "Chanun", "Achitofel", "Chushai"], "themes": ["Expansão", "Chesed", "Pecado", "Teshuvah", "Rebelião"] },
  "facts": [
    { "id": "sm049", "order": 1, "text": "David vence povos vizinhos e estabelece administração de justiça e retidão em Israel.", "text_he": null, "refs": ["II Samuel 8:1-18"], "ref_start": "II Samuel 8:1", "ref_end": "II Samuel 8:18", "chapter": 8, "verse_start": 1, "verse_end": 18, "sefaria_ref": "II Samuel 8:1-18", "tags": ["vitórias", "justiça", "reino"], "topic": "Expansão do reino" },
    { "id": "sm050", "order": 2, "text": "David mostra bondade a Mephiboshet por causa da aliança com Yonatan.", "text_he": null, "refs": ["II Samuel 9:1-13"], "ref_start": "II Samuel 9:1", "ref_end": "II Samuel 9:13", "chapter": 9, "verse_start": 1, "verse_end": 13, "sefaria_ref": "II Samuel 9:1-13", "tags": ["mephiboshet", "yonatan", "chesed"], "topic": "Chesed com Mephiboshet" },
    { "id": "sm051", "order": 3, "text": "A humilhação dos mensageiros de David por Amon leva a guerra com Amon e Aram.", "text_he": null, "refs": ["II Samuel 10:1-19"], "ref_start": "II Samuel 10:1", "ref_end": "II Samuel 10:19", "chapter": 10, "verse_start": 1, "verse_end": 19, "sefaria_ref": "II Samuel 10:1-19", "tags": ["amon", "aram", "yoav"], "topic": "Guerra com Amon e Aram" },
    { "id": "sm052", "order": 4, "text": "David toma Bat Sheva e organiza a morte de Uriyah, criando a grande crise moral de seu reinado.", "text_he": null, "refs": ["II Samuel 11:1-27"], "ref_start": "II Samuel 11:1", "ref_end": "II Samuel 11:27", "chapter": 11, "verse_start": 1, "verse_end": 27, "sefaria_ref": "II Samuel 11:1-27", "tags": ["bat-sheva", "uriyah", "pecado"], "topic": "Bat Sheva e Uriyah" },
    { "id": "sm053", "order": 5, "text": "Natan confronta David com a parábola da ovelha, e David reconhece seu pecado.", "text_he": null, "refs": ["II Samuel 12:1-25"], "ref_start": "II Samuel 12:1", "ref_end": "II Samuel 12:25", "chapter": 12, "verse_start": 1, "verse_end": 25, "sefaria_ref": "II Samuel 12:1-25", "tags": ["natan", "teshuvah", "shalomoh"], "topic": "Repreensão de Natan" },
    { "id": "sm054", "order": 6, "text": "Amnon violenta Tamar, e Avshalom mata Amnon, iniciando a ruptura aberta na casa de David.", "text_he": null, "refs": ["II Samuel 13:1-39"], "ref_start": "II Samuel 13:1", "ref_end": "II Samuel 13:39", "chapter": 13, "verse_start": 1, "verse_end": 39, "sefaria_ref": "II Samuel 13:1-39", "tags": ["amnon", "tamar", "avshalom"], "topic": "Amnon, Tamar e Avshalom" },
