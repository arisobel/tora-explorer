  "timeline": { "period_name": "David entre corte e fuga", "anno_mundi_start": 2885, "anno_mundi_end": 2890, "era": "neviim-rishonim", "position_pct": 50, "description": "David se torna amado e ameaçador; Shaul o persegue enquanto Yonatan e outros o ajudam." },
  "summary": { "short": "David cresce em prestígio, Shaul o persegue, e David se recusa a ferir o ungido de Deus.", "medium": "A vitória contra Golias aproxima David da casa real. Yonatan firma aliança com ele, Michal o ama, e o povo celebra suas vitórias. Isso desperta o ciúme de Shaul.\n\nA perseguição empurra David para fuga, alianças e esconderijos. Mesmo tendo oportunidade de matar Shaul, David poupa sua vida, recusando levantar a mão contra o ungido de Deus.", "characters_main": ["David", "Shaul", "Yonatan", "Michal", "Achimelech"], "characters_secondary": ["Doeg", "Nob", "Gad", "Keilah"], "themes": ["Ciúme", "Aliança", "Fuga", "Ungido", "Misericórdia"] },
  "facts": [
    { "id": "sm025", "order": 1, "text": "Yonatan ama David como sua própria alma e faz aliança com ele.", "text_he": null, "refs": ["I Samuel 18:1-5"], "ref_start": "I Samuel 18:1", "ref_end": "I Samuel 18:5", "chapter": 18, "verse_start": 1, "verse_end": 5, "sefaria_ref": "I Samuel 18:1-5", "tags": ["yonatan", "david", "aliança"], "topic": "Aliança com Yonatan" },
    { "id": "sm026", "order": 2, "text": "As mulheres cantam as vitórias de David, despertando ciúme e medo em Shaul.", "text_he": null, "refs": ["I Samuel 18:6-16"], "ref_start": "I Samuel 18:6", "ref_end": "I Samuel 18:16", "chapter": 18, "verse_start": 6, "verse_end": 16, "sefaria_ref": "I Samuel 18:6-16", "tags": ["ciúme", "shaul", "david"], "topic": "Ciúme de Shaul" },
    { "id": "sm027", "order": 3, "text": "David casa com Michal depois de cumprir a exigência perigosa imposta por Shaul.", "text_he": null, "refs": ["I Samuel 18:17-30"], "ref_start": "I Samuel 18:17", "ref_end": "I Samuel 18:30", "chapter": 18, "verse_start": 17, "verse_end": 30, "sefaria_ref": "I Samuel 18:17-30", "tags": ["michal", "casamento", "pelishtim"], "topic": "David e Michal" },
    { "id": "sm028", "order": 4, "text": "Yonatan e Michal ajudam David a escapar das tentativas de Shaul de matá-lo.", "text_he": null, "refs": ["I Samuel 19:1-24"], "ref_start": "I Samuel 19:1", "ref_end": "I Samuel 19:24", "chapter": 19, "verse_start": 1, "verse_end": 24, "sefaria_ref": "I Samuel 19:1-24", "tags": ["fuga", "michal", "yonatan"], "topic": "Primeiras fugas" },
    { "id": "sm029", "order": 5, "text": "Yonatan confirma a hostilidade de Shaul e se despede de David em aliança e choro.", "text_he": null, "refs": ["I Samuel 20:1-42"], "ref_start": "I Samuel 20:1", "ref_end": "I Samuel 20:42", "chapter": 20, "verse_start": 1, "verse_end": 42, "sefaria_ref": "I Samuel 20:1-42", "tags": ["yonatan", "despedida", "aliança"], "topic": "Despedida de Yonatan" },
    { "id": "sm030", "order": 6, "text": "David recebe pão sagrado e a espada de Golias em Nob, evento que levará à tragédia sacerdotal.", "text_he": null, "refs": ["I Samuel 21:1-22:23"], "ref_start": "I Samuel 21:1", "ref_end": "I Samuel 22:23", "chapter": 21, "verse_start": 1, "verse_end_chapter": 22, "verse_end": 23, "sefaria_ref": "I Samuel 21:1-22:23", "tags": ["nob", "achimelech", "doeg"], "topic": "Nob e Doeg" },
    { "id": "sm031", "order": 7, "text": "David salva Keilah, mas continua fugindo de Shaul no deserto.", "text_he": null, "refs": ["I Samuel 23:1-29"], "ref_start": "I Samuel 23:1", "ref_end": "I Samuel 23:29", "chapter": 23, "verse_start": 1, "verse_end": 29, "sefaria_ref": "I Samuel 23:1-29", "tags": ["keilah", "deserto", "fuga"], "topic": "Fuga no deserto" },
    { "id": "sm032", "order": 8, "text": "David corta a ponta do manto de Shaul, mas poupa sua vida por respeito ao ungido de Deus.", "text_he": null, "refs": ["I Samuel 24:1-23"], "ref_start": "I Samuel 24:1", "ref_end": "I Samuel 24:23", "chapter": 24, "verse_start": 1, "verse_end": 23, "sefaria_ref": "I Samuel 24:1-24:23", "tags": ["manto", "ungido", "misericórdia"], "topic": "David poupa Shaul" }
