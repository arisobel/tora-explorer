  "summary": { "short": "Channah ora por um filho, Shemuel é chamado como profeta, a casa de Eli cai e a arca retorna.", "medium": "Shemuel começa em Shiloh, onde Channah transforma dor em oração e dedica seu filho ao serviço divino. O cântico de Channah antecipa temas de inversão, realeza e julgamento.\n\nEnquanto Shemuel cresce, a casa de Eli se corrompe. A arca é capturada pelos pelishtim, mas a presença divina humilha Dagon e retorna a Israel. Shemuel conduz o povo a teshuvah em Mitzpah.", "characters_main": ["Channah", "Shemuel", "Eli", "Chofni", "Pinchas", "Pelishtim"], "characters_secondary": ["Elkanah", "Peninah", "Dagon", "Bnei Israel"], "themes": ["Oração", "Profecia", "Shiloh", "Arca", "Teshuvah"] },
  "facts": [
    { "id": "sm001", "order": 1, "text": "Channah ora em Shiloh por um filho, derramando sua alma diante de Deus.", "text_he": null, "refs": ["I Samuel 1:1-18"], "ref_start": "I Samuel 1:1", "ref_end": "I Samuel 1:18", "chapter": 1, "verse_start": 1, "verse_end": 18, "sefaria_ref": "I Samuel 1:1-18", "tags": ["channah", "oração", "shiloh"], "topic": "Oração de Channah" },
    { "id": "sm002", "order": 2, "text": "Shemuel nasce e é entregue por Channah ao serviço de Deus em Shiloh.", "text_he": null, "refs": ["I Samuel 1:19-28"], "ref_start": "I Samuel 1:19", "ref_end": "I Samuel 1:28", "chapter": 1, "verse_start": 19, "verse_end": 28, "sefaria_ref": "I Samuel 1:19-28", "tags": ["shemuel", "dedicação", "nascimento"], "topic": "Nascimento de Shemuel" },
    { "id": "sm003", "order": 3, "text": "O cântico de Channah louva Deus que reverte destinos e levanta o humilde.", "text_he": null, "refs": ["I Samuel 2:1-10"], "ref_start": "I Samuel 2:1", "ref_end": "I Samuel 2:10", "chapter": 2, "verse_start": 1, "verse_end": 10, "sefaria_ref": "I Samuel 2:1-10", "tags": ["cântico", "reversão", "realeza"], "topic": "Cântico de Channah" },
    { "id": "sm004", "order": 4, "text": "Os filhos de Eli corrompem o serviço sacerdotal, enquanto Shemuel cresce diante de Deus.", "text_he": null, "refs": ["I Samuel 2:11-36"], "ref_start": "I Samuel 2:11", "ref_end": "I Samuel 2:36", "chapter": 2, "verse_start": 11, "verse_end": 36, "sefaria_ref": "I Samuel 2:11-36", "tags": ["eli", "chofni", "pinchas", "corrupção"], "topic": "Casa de Eli" },
    { "id": "sm005", "order": 5, "text": "Deus chama Shemuel à noite, estabelecendo-o como profeta confiável em Israel.", "text_he": null, "refs": ["I Samuel 3:1-21"], "ref_start": "I Samuel 3:1", "ref_end": "I Samuel 3:21", "chapter": 3, "verse_start": 1, "verse_end": 21, "sefaria_ref": "I Samuel 3:1-21", "tags": ["chamado", "profecia", "shemuel"], "topic": "Chamado profético" },
    { "id": "sm006", "order": 6, "text": "Israel leva a arca à guerra, mas é derrotado; Chofni e Pinchas morrem, e Eli cai ao ouvir a notícia.", "text_he": null, "refs": ["I Samuel 4:1-22"], "ref_start": "I Samuel 4:1", "ref_end": "I Samuel 4:22", "chapter": 4, "verse_start": 1, "verse_end": 22, "sefaria_ref": "I Samuel 4:1-22", "tags": ["arca", "eli", "ichavod"], "topic": "Arca capturada" },
    { "id": "sm007", "order": 7, "text": "A arca entre os pelishtim derruba Dagon e traz pragas até ser devolvida a Israel.", "text_he": null, "refs": ["I Samuel 5:1-6:21"], "ref_start": "I Samuel 5:1", "ref_end": "I Samuel 6:21", "chapter": 5, "verse_start": 1, "verse_end_chapter": 6, "verse_end": 21, "sefaria_ref": "I Samuel 5:1-6:21", "tags": ["dagon", "pelishtim", "arca"], "topic": "Arca entre os pelishtim" },
    { "id": "sm008", "order": 8, "text": "Shemuel reúne Israel em Mitzpah, conduz teshuvah e os pelishtim são derrotados.", "text_he": null, "refs": ["I Samuel 7:1-17"], "ref_start": "I Samuel 7:1", "ref_end": "I Samuel 7:17", "chapter": 7, "verse_start": 1, "verse_end": 17, "sefaria_ref": "I Samuel 7:1-17", "tags": ["mitzpah", "teshuvah", "even-haezer"], "topic": "Teshuvah em Mitzpah" }
