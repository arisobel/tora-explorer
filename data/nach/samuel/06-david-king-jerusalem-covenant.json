  "identity": { "id": "david-king-jerusalem-covenant", "label": "David rei, Jerusalém e aliança", "label_pt": "De Chevron a Jerusalém, arca e promessa davídica", "hebrew": null, "transliteration": "David King, Jerusalem and Covenant" },
