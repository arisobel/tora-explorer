  "timeline": { "period_name": "Consolidação inicial de David", "anno_mundi_start": 2892, "anno_mundi_end": 2900, "era": "neviim-rishonim", "position_pct": 50, "description": "David lamenta Shaul e Yonatan, é coroado, conquista Jerusalém, traz a arca e recebe a promessa dinástica." },
  "summary": { "short": "David lamenta Shaul, torna-se rei, conquista Jerusalém, traz a arca e recebe a promessa da casa davídica.", "medium": "II Samuel abre com David recebendo a notícia da morte de Shaul e respondendo com lamento, não triunfo. Sua ascensão passa por Chevron, conflito com a casa de Shaul e unificação gradual.\n\nA conquista de Jerusalém e a chegada da arca criam um centro político e espiritual. Pela profecia de Natan, Deus promete estabelecer a casa de David, formando eixo central da esperança davídica.", "characters_main": ["David", "Shaul", "Yonatan", "Ish-Boshet", "Yoav", "Michal", "Natan"], "characters_secondary": ["Avner", "Uzzah", "Obed-Edom", "Baal-Peratzim"], "themes": ["Lamento", "Reino", "Jerusalém", "Arca", "Aliança davídica"] },
  "facts": [
    { "id": "sm041", "order": 1, "text": "David recebe a notícia da morte de Shaul e Yonatan e executa o amalekita que afirma ter matado Shaul.", "text_he": null, "refs": ["II Samuel 1:1-16"], "ref_start": "II Samuel 1:1", "ref_end": "II Samuel 1:16", "chapter": 1, "verse_start": 1, "verse_end": 16, "sefaria_ref": "II Samuel 1:1-16", "tags": ["shaul", "yonatan", "amalekita"], "topic": "Notícia de Gilboa" },
    { "id": "sm042", "order": 2, "text": "David compõe um lamento por Shaul e Yonatan, celebrando a beleza e a coragem caídas.", "text_he": null, "refs": ["II Samuel 1:17-27"], "ref_start": "II Samuel 1:17", "ref_end": "II Samuel 1:27", "chapter": 1, "verse_start": 17, "verse_end": 27, "sefaria_ref": "II Samuel 1:17-27", "tags": ["lamento", "yonatan", "shaul"], "topic": "Lamento por Shaul e Yonatan" },
    { "id": "sm043", "order": 3, "text": "David é ungido rei sobre Yehudah em Chevron, enquanto Ish-Boshet reina sobre Israel.", "text_he": null, "refs": ["II Samuel 2:1-11"], "ref_start": "II Samuel 2:1", "ref_end": "II Samuel 2:11", "chapter": 2, "verse_start": 1, "verse_end": 11, "sefaria_ref": "II Samuel 2:1-11", "tags": ["chevron", "yehudah", "ish-boshet"], "topic": "Reino em Chevron" },
    { "id": "sm044", "order": 4, "text": "A guerra entre a casa de Shaul e a casa de David enfraquece Ish-Boshet e fortalece David.", "text_he": null, "refs": ["II Samuel 2:12-4:12"], "ref_start": "II Samuel 2:12", "ref_end": "II Samuel 4:12", "chapter": 2, "verse_start": 12, "verse_end_chapter": 4, "verse_end": 12, "sefaria_ref": "II Samuel 2:12-4:12", "tags": ["avner", "yoav", "ish-boshet"], "topic": "Guerra de casas" },
    { "id": "sm045", "order": 5, "text": "Todas as tribos reconhecem David, que é ungido rei sobre Israel.", "text_he": null, "refs": ["II Samuel 5:1-5"], "ref_start": "II Samuel 5:1", "ref_end": "II Samuel 5:5", "chapter": 5, "verse_start": 1, "verse_end": 5, "sefaria_ref": "II Samuel 5:1-5", "tags": ["tribos", "unificação", "reino"], "topic": "David rei sobre todo Israel" },
    { "id": "sm046", "order": 6, "text": "David conquista Jerusalém, chamada Ir David, e vence os pelishtim em Baal-Peratzim.", "text_he": null, "refs": ["II Samuel 5:6-25"], "ref_start": "II Samuel 5:6", "ref_end": "II Samuel 5:25", "chapter": 5, "verse_start": 6, "verse_end": 25, "sefaria_ref": "II Samuel 5:6-25", "tags": ["jerusalém", "ir-david", "pelishtim"], "topic": "Jerusalém e vitórias" },
    { "id": "sm047", "order": 7, "text": "A arca é trazida a Jerusalém com alegria, mas a morte de Uzzah marca a santidade do processo.", "text_he": null, "refs": ["II Samuel 6:1-23"], "ref_start": "II Samuel 6:1", "ref_end": "II Samuel 6:23", "chapter": 6, "verse_start": 1, "verse_end": 23, "sefaria_ref": "II Samuel 6:1-23", "tags": ["arca", "uzzah", "michal"], "topic": "Arca em Jerusalém" },
    { "id": "sm048", "order": 8, "text": "Por meio de Natan, Deus promete construir uma casa para David e estabelecer seu trono.", "text_he": null, "refs": ["II Samuel 7:1-29"], "ref_start": "II Samuel 7:1", "ref_end": "II Samuel 7:29", "chapter": 7, "verse_start": 1, "verse_end": 29, "sefaria_ref": "II Samuel 7:1-29", "tags": ["natan", "aliança-davídica", "templo"], "topic": "Promessa à casa de David" }
  ]
