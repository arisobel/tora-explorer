  "timeline": { "period_name": "Início da monarquia", "anno_mundi_start": 2881, "anno_mundi_end": 2883, "era": "neviim-rishonim", "position_pct": 50, "description": "Israel pede um rei, Shaul é escolhido e a monarquia nasce sob advertência profética." },
  "summary": { "short": "Israel pede um rei, Shaul é ungido e confirmado, e Shemuel adverte sobre fidelidade.", "medium": "A velhice de Shemuel e a corrupção de seus filhos levam Israel a pedir um rei como as nações. O pedido é ambíguo: Deus permite, mas Shemuel adverte sobre o peso político da monarquia.\n\nShaul aparece procurando jumentas e é ungido em segredo, depois escolhido por sorteio. Sua vitória sobre Nachash confirma o reino, e Shemuel encerra o bloco lembrando que rei e povo continuam subordinados a Deus.", "characters_main": ["Shemuel", "Shaul", "Nachash", "Bnei Israel"], "characters_secondary": ["Filhos de Shemuel", "Kish", "Amon"], "themes": ["Monarquia", "Rei", "Advertência", "Unção", "Gilgal"] },
  "facts": [
    { "id": "sm009", "order": 1, "text": "Israel pede um rei para julgá-los como as demais nações, entristecendo Shemuel.", "text_he": null, "refs": ["I Samuel 8:1-9"], "ref_start": "I Samuel 8:1", "ref_end": "I Samuel 8:9", "chapter": 8, "verse_start": 1, "verse_end": 9, "sefaria_ref": "I Samuel 8:1-9", "tags": ["rei", "pedido", "nações"], "topic": "Pedido por rei" },
    { "id": "sm010", "order": 2, "text": "Shemuel adverte o povo sobre os direitos e custos de um rei humano.", "text_he": null, "refs": ["I Samuel 8:10-22"], "ref_start": "I Samuel 8:10", "ref_end": "I Samuel 8:22", "chapter": 8, "verse_start": 10, "verse_end": 22, "sefaria_ref": "I Samuel 8:10-22", "tags": ["advertência", "poder", "monarquia"], "topic": "Mishpat hamelech" },
    { "id": "sm011", "order": 3, "text": "Shaul procura jumentas perdidas e é conduzido ao encontro com Shemuel.", "text_he": null, "refs": ["I Samuel 9:1-14"], "ref_start": "I Samuel 9:1", "ref_end": "I Samuel 9:14", "chapter": 9, "verse_start": 1, "verse_end": 14, "sefaria_ref": "I Samuel 9:1-14", "tags": ["shaul", "jumentas", "providência"], "topic": "Busca de Shaul" },
    { "id": "sm012", "order": 4, "text": "Shemuel honra Shaul no banquete e depois o unge como príncipe sobre Israel.", "text_he": null, "refs": ["I Samuel 9:15-10:1"], "ref_start": "I Samuel 9:15", "ref_end": "I Samuel 10:1", "chapter": 9, "verse_start": 15, "verse_end_chapter": 10, "verse_end": 1, "sefaria_ref": "I Samuel 9:15-10:1", "tags": ["unção", "shaul", "shemuel"], "topic": "Unção secreta" },
    { "id": "sm013", "order": 5, "text": "Sinais confirmam a escolha de Shaul, e o espírito de Deus o transforma.", "text_he": null, "refs": ["I Samuel 10:2-16"], "ref_start": "I Samuel 10:2", "ref_end": "I Samuel 10:16", "chapter": 10, "verse_start": 2, "verse_end": 16, "sefaria_ref": "I Samuel 10:2-16", "tags": ["sinais", "espírito", "profecia"], "topic": "Sinais de confirmação" },
    { "id": "sm014", "order": 6, "text": "Shaul é escolhido publicamente por sorteio em Mitzpah, mas se esconde entre os objetos.", "text_he": null, "refs": ["I Samuel 10:17-27"], "ref_start": "I Samuel 10:17", "ref_end": "I Samuel 10:27", "chapter": 10, "verse_start": 17, "verse_end": 27, "sefaria_ref": "I Samuel 10:17-27", "tags": ["mitzpah", "sorteio", "humildade"], "topic": "Escolha pública" },
    { "id": "sm015", "order": 7, "text": "Shaul lidera Israel contra Nachash de Amon e salva Yavesh-Gilad.", "text_he": null, "refs": ["I Samuel 11:1-15"], "ref_start": "I Samuel 11:1", "ref_end": "I Samuel 11:15", "chapter": 11, "verse_start": 1, "verse_end": 15, "sefaria_ref": "I Samuel 11:1-15", "tags": ["nachash", "yavesh-gilad", "vitória"], "topic": "Vitória inaugural" },
    { "id": "sm016", "order": 8, "text": "Shemuel faz seu discurso de despedida, reafirmando que rei e povo devem temer e servir a Deus.", "text_he": null, "refs": ["I Samuel 12:1-25"], "ref_start": "I Samuel 12:1", "ref_end": "I Samuel 12:25", "chapter": 12, "verse_start": 1, "verse_end": 25, "sefaria_ref": "I Samuel 12:1-25", "tags": ["gilgal", "discurso", "fidelidade"], "topic": "Renovação em Gilgal" }
