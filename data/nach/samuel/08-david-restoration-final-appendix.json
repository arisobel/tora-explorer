  "summary": { "short": "David retorna após Avshalom, enfrenta novas tensões e o livro fecha com cântico, guerreiros e altar.", "medium": "Depois da morte de Avshalom, David precisa ser trazido de volta ao trono. O retorno revela divisões entre Yehudah, Israel e antigos aliados ou acusadores.\n\nOs capítulos finais funcionam como apêndice teológico: fome ligada a Shaul, guerras contra gigantes, cântico de David, últimas palavras, lista dos valentes e o censo que termina com altar no local que se tornará central para o Templo.", "characters_main": ["David", "Yoav", "Sheva ben Bichri", "Ritzpah", "Gad", "Araunah"], "characters_secondary": ["Barzillai", "Shimi", "Mephiboshet", "Valentes de David"], "themes": ["Retorno", "Tensões tribais", "Cântico", "Valentes", "Altar"] },
  "facts": [
    { "id": "sm057", "order": 1, "text": "David lamenta Avshalom, e Yoav o pressiona a se apresentar ao povo vencedor.", "text_he": null, "refs": ["II Samuel 19:1-8"], "ref_start": "II Samuel 19:1", "ref_end": "II Samuel 19:8", "chapter": 19, "verse_start": 1, "verse_end": 8, "sefaria_ref": "II Samuel 19:1-8", "tags": ["avshalom", "lamento", "yoav"], "topic": "Lamento por Avshalom" },
    { "id": "sm058", "order": 2, "text": "David retorna ao Jordão e lida com Shimi, Mephiboshet e Barzillai.", "text_he": null, "refs": ["II Samuel 19:9-44"], "ref_start": "II Samuel 19:9", "ref_end": "II Samuel 19:44", "chapter": 19, "verse_start": 9, "verse_end": 44, "sefaria_ref": "II Samuel 19:9-44", "tags": ["retorno", "shimi", "barzillai"], "topic": "Retorno de David" },
    { "id": "sm059", "order": 3, "text": "Sheva ben Bichri lidera nova rebelião, encerrada quando uma mulher sábia de Avel negocia sua morte.", "text_he": null, "refs": ["II Samuel 20:1-26"], "ref_start": "II Samuel 20:1", "ref_end": "II Samuel 20:26", "chapter": 20, "verse_start": 1, "verse_end": 26, "sefaria_ref": "II Samuel 20:1-26", "tags": ["sheva", "avel", "mulher-sábia"], "topic": "Rebelião de Sheva" },
    { "id": "sm060", "order": 4, "text": "Uma fome é ligada à violência de Shaul contra os givonitas, e Ritzpah guarda os mortos com fidelidade.", "text_he": null, "refs": ["II Samuel 21:1-14"], "ref_start": "II Samuel 21:1", "ref_end": "II Samuel 21:14", "chapter": 21, "verse_start": 1, "verse_end": 14, "sefaria_ref": "II Samuel 21:1-14", "tags": ["givonitas", "ritzpah", "fome"], "topic": "Ritzpah e os givonitas" },
    { "id": "sm061", "order": 5, "text": "Guerras contra descendentes de gigantes mostram a continuidade das ameaças e a proteção a David.", "text_he": null, "refs": ["II Samuel 21:15-22"], "ref_start": "II Samuel 21:15", "ref_end": "II Samuel 21:22", "chapter": 21, "verse_start": 15, "verse_end": 22, "sefaria_ref": "II Samuel 21:15-22", "tags": ["gigantes", "david", "guerreiros"], "topic": "Guerras contra gigantes" },
    { "id": "sm062", "order": 6, "text": "David canta sua libertação, descrevendo Deus como rocha, escudo e salvador.", "text_he": null, "refs": ["II Samuel 22:1-51"], "ref_start": "II Samuel 22:1", "ref_end": "II Samuel 22:51", "chapter": 22, "verse_start": 1, "verse_end": 51, "sefaria_ref": "II Samuel 22:1-51", "tags": ["cântico", "rocha", "salvação"], "topic": "Cântico de David" },
    { "id": "sm063", "order": 7, "text": "As últimas palavras de David e a lista de seus valentes preservam memória de liderança e coragem.", "text_he": null, "refs": ["II Samuel 23:1-39"], "ref_start": "II Samuel 23:1", "ref_end": "II Samuel 23:39", "chapter": 23, "verse_start": 1, "verse_end": 39, "sefaria_ref": "II Samuel 23:1-39", "tags": ["últimas-palavras", "valentes", "memória"], "topic": "Últimas palavras e valentes" },
    { "id": "sm064", "order": 8, "text": "O censo de David traz praga; por ordem de Gad, David compra a eira de Araunah e constrói um altar.", "text_he": null, "refs": ["II Samuel 24:1-25"], "ref_start": "II Samuel 24:1", "ref_end": "II Samuel 24:25", "chapter": 24, "verse_start": 1, "verse_end": 25, "sefaria_ref": "II Samuel 24:1-25", "tags": ["censo", "gad", "araunah", "altar"], "topic": "Censo e altar de Araunah" }
