  "timeline": { "period_name": "Últimos dias de Shaul", "anno_mundi_start": 2890, "anno_mundi_end": 2892, "era": "neviim-rishonim", "position_pct": 50, "description": "David vive entre risco moral e contenção, enquanto Shaul se isola de Deus e cai em Gilboa." },
  "summary": { "short": "David vive no limite do exílio enquanto Shaul caminha para sua derrota final.", "medium": "Depois da morte de Shemuel, David continua fugitivo. Avigayil impede que ele derrame sangue por vingança, e outra oportunidade de matar Shaul é recusada.\n\nDavid se refugia entre os pelishtim em Ziklag, mas é preservado de lutar contra Israel. Shaul, sem resposta divina, consulta uma necromante em Ein Dor e termina morto em Gilboa com seus filhos.", "characters_main": ["David", "Avigayil", "Naval", "Shaul", "Baalat Ov", "Pelishtim"], "characters_secondary": ["Avishai", "Achish", "Amalekitas", "Yonatan"], "themes": ["Exílio", "Vingança contida", "Ziklag", "Ein Dor", "Gilboa"] },
  "facts": [
    { "id": "sm033", "order": 1, "text": "Shemuel morre, e David encontra Naval e Avigayil no episódio de Carmel.", "text_he": null, "refs": ["I Samuel 25:1-13"], "ref_start": "I Samuel 25:1", "ref_end": "I Samuel 25:13", "chapter": 25, "verse_start": 1, "verse_end": 13, "sefaria_ref": "I Samuel 25:1-13", "tags": ["shemuel", "naval", "avigayil"], "topic": "Morte de Shemuel e Naval" },
    { "id": "sm034", "order": 2, "text": "Avigayil intercede com sabedoria e impede David de vingar-se com sangue.", "text_he": null, "refs": ["I Samuel 25:14-44"], "ref_start": "I Samuel 25:14", "ref_end": "I Samuel 25:44", "chapter": 25, "verse_start": 14, "verse_end": 44, "sefaria_ref": "I Samuel 25:14-44", "tags": ["avigayil", "intercessão", "vingança"], "topic": "Sabedoria de Avigayil" },
    { "id": "sm035", "order": 3, "text": "David poupa Shaul novamente, tomando sua lança e jarro no acampamento.", "text_he": null, "refs": ["I Samuel 26:1-25"], "ref_start": "I Samuel 26:1", "ref_end": "I Samuel 26:25", "chapter": 26, "verse_start": 1, "verse_end": 25, "sefaria_ref": "I Samuel 26:1-25", "tags": ["lança", "shaul", "misericórdia"], "topic": "Segunda vez que David poupa Shaul" },
    { "id": "sm036", "order": 4, "text": "David busca refúgio com Achish em Gat e recebe Ziklag.", "text_he": null, "refs": ["I Samuel 27:1-12"], "ref_start": "I Samuel 27:1", "ref_end": "I Samuel 27:12", "chapter": 27, "verse_start": 1, "verse_end": 12, "sefaria_ref": "I Samuel 27:1-12", "tags": ["achish", "gat", "ziklag"], "topic": "David em Ziklag" },
    { "id": "sm037", "order": 5, "text": "Shaul, sem resposta divina, consulta a mulher de Ein Dor e ouve o anúncio de sua queda.", "text_he": null, "refs": ["I Samuel 28:1-25"], "ref_start": "I Samuel 28:1", "ref_end": "I Samuel 28:25", "chapter": 28, "verse_start": 1, "verse_end": 25, "sefaria_ref": "I Samuel 28:1-25", "tags": ["ein-dor", "shaul", "necromancia"], "topic": "Consulta em Ein Dor" },
    { "id": "sm038", "order": 6, "text": "Os líderes pelishtim rejeitam David na campanha contra Israel, evitando que ele lute contra seu povo.", "text_he": null, "refs": ["I Samuel 29:1-11"], "ref_start": "I Samuel 29:1", "ref_end": "I Samuel 29:11", "chapter": 29, "verse_start": 1, "verse_end": 11, "sefaria_ref": "I Samuel 29:1-11", "tags": ["pelishtim", "achish", "providência"], "topic": "David dispensado da guerra" },
    { "id": "sm039", "order": 7, "text": "Ziklag é saqueada pelos amalekitas, mas David fortalece-se em Deus e recupera tudo.", "text_he": null, "refs": ["I Samuel 30:1-31"], "ref_start": "I Samuel 30:1", "ref_end": "I Samuel 30:31", "chapter": 30, "verse_start": 1, "verse_end": 31, "sefaria_ref": "I Samuel 30:1-31", "tags": ["ziklag", "amalek", "recuperação"], "topic": "Ziklag saqueada e recuperada" },
    { "id": "sm040", "order": 8, "text": "Shaul e seus filhos morrem em Gilboa, e os homens de Yavesh-Gilad resgatam seus corpos.", "text_he": null, "refs": ["I Samuel 31:1-13"], "ref_start": "I Samuel 31:1", "ref_end": "I Samuel 31:13", "chapter": 31, "verse_start": 1, "verse_end": 13, "sefaria_ref": "I Samuel 31:1-13", "tags": ["gilboa", "shaul", "yonatan"], "topic": "Morte de Shaul" }
