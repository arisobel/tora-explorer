  "summary": { "short": "Após a queda, Yechezkel anuncia pastor fiel, novo coração, ossos secos e reunificação de Israel.", "medium": "A crítica se volta aos pastores que exploraram o rebanho. Deus promete buscar as ovelhas e estabelecer um pastor davídico.\n\nA terra será restaurada, o povo receberá novo coração e novo espírito, e o vale de ossos secos simboliza renascimento nacional. Duas varas tornam-se uma.", "characters_main": ["Pastores de Israel", "David", "Casa de Israel", "Yechezkel"], "characters_secondary": ["Edom", "Montes de Israel", "Yehudah", "Yossef"], "themes": ["Pastor", "Novo coração", "Ossos secos", "Unidade"] },
  "facts": [
    { "id": "ez041", "order": 1, "text": "Os pastores de Israel são denunciados por alimentar a si mesmos em vez do rebanho.", "text_he": null, "refs": ["Ezekiel 34:1-10"], "ref_start": "Ezekiel 34:1", "ref_end": "Ezekiel 34:10", "chapter": 34, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Ezekiel 34:1-10", "tags": ["pastores", "liderança", "rebanho"], "topic": "Pastores infiéis" },
    { "id": "ez042", "order": 2, "text": "Deus promete buscar as ovelhas dispersas e estabelecer um pastor, David.", "text_he": null, "refs": ["Ezekiel 34:11-31"], "ref_start": "Ezekiel 34:11", "ref_end": "Ezekiel 34:31", "chapter": 34, "verse_start": 11, "verse_end": 31, "sefaria_ref": "Ezekiel 34:11-31", "tags": ["david", "reunião", "pastor"], "topic": "Pastor davídico" },
    { "id": "ez043", "order": 3, "text": "Edom é julgado por hostilidade, enquanto os montes de Israel são preparados para produzir novamente.", "text_he": null, "refs": ["Ezekiel 35:1-36:15"], "ref_start": "Ezekiel 35:1", "ref_end": "Ezekiel 36:15", "chapter": 35, "verse_start": 1, "verse_end_chapter": 36, "verse_end": 15, "sefaria_ref": "Ezekiel 35:1-36:15", "tags": ["edom", "montes", "terra"], "topic": "Montes restaurados" },
    { "id": "ez044", "order": 4, "text": "A restauração ocorrerá para santificar o nome divino profanado entre as nações.", "text_he": null, "refs": ["Ezekiel 36:16-23"], "ref_start": "Ezekiel 36:16", "ref_end": "Ezekiel 36:23", "chapter": 36, "verse_start": 16, "verse_end": 23, "sefaria_ref": "Ezekiel 36:16-23", "tags": ["nome-divino", "nações", "santificação"], "topic": "Santificação do nome" },
    { "id": "ez045", "order": 5, "text": "Deus promete água pura, novo coração e novo espírito para que Israel viva em fidelidade.", "text_he": null, "refs": ["Ezekiel 36:24-38"], "ref_start": "Ezekiel 36:24", "ref_end": "Ezekiel 36:38", "chapter": 36, "verse_start": 24, "verse_end": 38, "sefaria_ref": "Ezekiel 36:24-38", "tags": ["novo-coração", "espírito", "purificação"], "topic": "Novo coração" },
    { "id": "ez046", "order": 6, "text": "No vale de ossos secos, a palavra e o espírito trazem vida ao que parecia sem esperança.", "text_he": null, "refs": ["Ezekiel 37:1-14"], "ref_start": "Ezekiel 37:1", "ref_end": "Ezekiel 37:14", "chapter": 37, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Ezekiel 37:1-14", "tags": ["ossos-secos", "espírito", "vida"], "topic": "Vale de ossos secos" },
    { "id": "ez047", "order": 7, "text": "As varas de Yehudah e Yossef tornam-se uma na mão de Yechezkel, simbolizando reunificação.", "text_he": null, "refs": ["Ezekiel 37:15-23"], "ref_start": "Ezekiel 37:15", "ref_end": "Ezekiel 37:23", "chapter": 37, "verse_start": 15, "verse_end": 23, "sefaria_ref": "Ezekiel 37:15-23", "tags": ["varas", "yehudah", "yossef"], "topic": "Duas varas" },
    { "id": "ez048", "order": 8, "text": "Um rei davídico, aliança de paz e santuário permanente completam a promessa de restauração.", "text_he": null, "refs": ["Ezekiel 37:24-28"], "ref_start": "Ezekiel 37:24", "ref_end": "Ezekiel 37:28", "chapter": 37, "verse_start": 24, "verse_end": 28, "sefaria_ref": "Ezekiel 37:24-28", "tags": ["david", "aliança-de-paz", "santuário"], "topic": "Aliança de paz" }
