  "timeline": { "period_name": "Partida da glória", "anno_mundi_start": 3332, "anno_mundi_end": 3333, "era": "neviim-acharonim", "position_pct": 58, "description": "A corrupção no Templo explica por que a glória divina abandona Yerushalayim." },
  "summary": { "short": "Yechezkel vê corrupção no Templo e a glória divina deixando Yerushalayim.", "medium": "Transportado em visão a Yerushalayim, Yechezkel vê camadas de idolatria dentro do Templo. O juízo começa no santuário.\n\nA carruagem reaparece, e a glória divina se move progressivamente para fora da cidade. Mesmo assim, há promessa de santuário no exílio e novo coração.", "characters_main": ["Yechezkel", "Anciãos de Yehudá", "Yerushalayim"], "characters_secondary": ["Homem vestido de linho", "Querubins", "Pelatyahu"], "themes": ["Templo", "Idolatria", "Glória divina", "Novo coração"] },
  "facts": [
    { "id": "ez017", "order": 1, "text": "Yechezkel é levado em visão a Yerushalayim, onde vê uma imagem de ciúmes no Templo.", "text_he": null, "refs": ["Ezekiel 8:1-6"], "ref_start": "Ezekiel 8:1", "ref_end": "Ezekiel 8:6", "chapter": 8, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Ezekiel 8:1-6", "tags": ["templo", "visão", "idolatria"], "topic": "Imagem de ciúmes" },
    { "id": "ez018", "order": 2, "text": "Anciãos praticam idolatria em câmaras ocultas, supondo que Deus não vê.", "text_he": null, "refs": ["Ezekiel 8:7-13"], "ref_start": "Ezekiel 8:7", "ref_end": "Ezekiel 8:13", "chapter": 8, "verse_start": 7, "verse_end": 13, "sefaria_ref": "Ezekiel 8:7-13", "tags": ["anciãos", "oculto", "ídolos"], "topic": "Câmaras ocultas" },
    { "id": "ez019", "order": 3, "text": "Mulheres choram por Tamuz e homens adoram o sol no pátio do Templo.", "text_he": null, "refs": ["Ezekiel 8:14-18"], "ref_start": "Ezekiel 8:14", "ref_end": "Ezekiel 8:18", "chapter": 8, "verse_start": 14, "verse_end": 18, "sefaria_ref": "Ezekiel 8:14-18", "tags": ["tamuz", "sol", "templo"], "topic": "Idolatria no pátio" },
    { "id": "ez020", "order": 4, "text": "Um homem vestido de linho marca os que suspiram pelas abominações antes do juízo.", "text_he": null, "refs": ["Ezekiel 9:1-11"], "ref_start": "Ezekiel 9:1", "ref_end": "Ezekiel 9:11", "chapter": 9, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Ezekiel 9:1-11", "tags": ["marca", "remanescente", "juízo"], "topic": "Marca dos que suspiram" },
    { "id": "ez021", "order": 5, "text": "Fogo é tomado entre os querubins e espalhado sobre a cidade.", "text_he": null, "refs": ["Ezekiel 10:1-8"], "ref_start": "Ezekiel 10:1", "ref_end": "Ezekiel 10:8", "chapter": 10, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Ezekiel 10:1-8", "tags": ["querubins", "fogo", "cidade"], "topic": "Fogo sobre a cidade" },
    { "id": "ez022", "order": 6, "text": "A glória divina se move do Templo para a entrada oriental, acompanhada pela carruagem.", "text_he": null, "refs": ["Ezekiel 10:9-22"], "ref_start": "Ezekiel 10:9", "ref_end": "Ezekiel 10:22", "chapter": 10, "verse_start": 9, "verse_end": 22, "sefaria_ref": "Ezekiel 10:9-22", "tags": ["glória", "carruagem", "partida"], "topic": "Glória deixa o Templo" },
    { "id": "ez023", "order": 7, "text": "Líderes de Yerushalayim recebem juízo, e Yechezkel clama pelo remanescente.", "text_he": null, "refs": ["Ezekiel 11:1-13"], "ref_start": "Ezekiel 11:1", "ref_end": "Ezekiel 11:13", "chapter": 11, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Ezekiel 11:1-13", "tags": ["líderes", "remanescente", "clamor"], "topic": "Juízo dos líderes" },
    { "id": "ez024", "order": 8, "text": "Deus promete ser pequeno santuário no exílio, reunir o povo e dar novo coração.", "text_he": null, "refs": ["Ezekiel 11:14-25"], "ref_start": "Ezekiel 11:14", "ref_end": "Ezekiel 11:25", "chapter": 11, "verse_start": 14, "verse_end": 25, "sefaria_ref": "Ezekiel 11:14-25", "tags": ["santuário", "exílio", "novo-coração"], "topic": "Santuário no exílio" }
