  "timeline": { "period_name": "Gog e novo Templo", "anno_mundi_start": 3350, "anno_mundi_end": 5785, "era": "neviim-acharonim", "position_pct": 58, "description": "Uma visão futura conecta derrota de Gog, conhecimento divino e retorno da glória ao Templo." },
  "summary": { "short": "A derrota de Gog abre caminho para uma visão detalhada do Templo e retorno da glória.", "medium": "Gog invade uma Israel restaurada, mas é derrotado para que as nações reconheçam Deus. A casa de Israel entende seu exílio e restauração.\n\nYechezkel é levado a uma montanha elevada e acompanha medidas do complexo sagrado. A glória retorna pelo leste, invertendo sua partida anterior.", "characters_main": ["Gog", "Casa de Israel", "Yechezkel", "Glória divina"], "characters_secondary": ["Homem com cordel de medir", "Nações"], "themes": ["Gog", "Santificação", "Templo", "Retorno da glória"] },
  "facts": [
    { "id": "ez049", "order": 1, "text": "Gog é convocado contra uma Israel restaurada e aparentemente segura.", "text_he": null, "refs": ["Ezekiel 38:1-16"], "ref_start": "Ezekiel 38:1", "ref_end": "Ezekiel 38:16", "chapter": 38, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Ezekiel 38:1-16", "tags": ["gog", "israel", "invasão"], "topic": "Invasão de Gog" },
    { "id": "ez050", "order": 2, "text": "Gog é derrotado por terremoto, espada e elementos, revelando santidade divina às nações.", "text_he": null, "refs": ["Ezekiel 38:17-23"], "ref_start": "Ezekiel 38:17", "ref_end": "Ezekiel 38:23", "chapter": 38, "verse_start": 17, "verse_end": 23, "sefaria_ref": "Ezekiel 38:17-23", "tags": ["gog", "santidade", "nações"], "topic": "Derrota de Gog" },
    { "id": "ez051", "order": 3, "text": "A purificação após Gog demonstra que Israel não voltará a profanar o nome divino.", "text_he": null, "refs": ["Ezekiel 39:1-20"], "ref_start": "Ezekiel 39:1", "ref_end": "Ezekiel 39:20", "chapter": 39, "verse_start": 1, "verse_end": 20, "sefaria_ref": "Ezekiel 39:1-20", "tags": ["purificação", "gog", "nome-divino"], "topic": "Purificação da terra" },
    { "id": "ez052", "order": 4, "text": "Israel e as nações compreendem que o exílio ocorreu por infidelidade e que a restauração revela misericórdia.", "text_he": null, "refs": ["Ezekiel 39:21-29"], "ref_start": "Ezekiel 39:21", "ref_end": "Ezekiel 39:29", "chapter": 39, "verse_start": 21, "verse_end": 29, "sefaria_ref": "Ezekiel 39:21-29", "tags": ["exílio", "misericórdia", "espírito"], "topic": "Sentido do exílio" },
    { "id": "ez053", "order": 5, "text": "Yechezkel é levado a uma montanha elevada e encontra um homem com cordel de medir.", "text_he": null, "refs": ["Ezekiel 40:1-4"], "ref_start": "Ezekiel 40:1", "ref_end": "Ezekiel 40:4", "chapter": 40, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Ezekiel 40:1-4", "tags": ["montanha", "medida", "templo"], "topic": "Início da visão do Templo" },
    { "id": "ez054", "order": 6, "text": "Portões, pátios, câmaras e edifícios do Templo são medidos em detalhe.", "text_he": null, "refs": ["Ezekiel 40:5-42:20"], "ref_start": "Ezekiel 40:5", "ref_end": "Ezekiel 42:20", "chapter": 40, "verse_start": 5, "verse_end_chapter": 42, "verse_end": 20, "sefaria_ref": "Ezekiel 40:5-42:20", "tags": ["medidas", "pátios", "santidade"], "topic": "Medidas do santuário" },
    { "id": "ez055", "order": 7, "text": "A glória divina retorna pelo portão oriental e enche o Templo.", "text_he": null, "refs": ["Ezekiel 43:1-12"], "ref_start": "Ezekiel 43:1", "ref_end": "Ezekiel 43:12", "chapter": 43, "verse_start": 1, "verse_end": 12, "sefaria_ref": "Ezekiel 43:1-12", "tags": ["glória", "portão-oriental", "retorno"], "topic": "Retorno da glória" },
    { "id": "ez056", "order": 8, "text": "O altar é medido e consagrado para renovar o serviço diante de Deus.", "text_he": null, "refs": ["Ezekiel 43:13-27"], "ref_start": "Ezekiel 43:13", "ref_end": "Ezekiel 43:27", "chapter": 43, "verse_start": 13, "verse_end": 27, "sefaria_ref": "Ezekiel 43:13-27", "tags": ["altar", "consagração", "serviço"], "topic": "Consagração do altar" }
