  "identity": { "id": "temple-service-land-river", "label": "Serviço, terra e rio de vida", "label_pt": "Kohanim, príncipe, fluxo do Templo, divisão da terra e cidade renovada", "hebrew": null, "transliteration": "Temple Service Land and River" },
