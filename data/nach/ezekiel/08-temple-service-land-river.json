  "timeline": { "period_name": "Terra e cidade renovadas", "anno_mundi_start": 3350, "anno_mundi_end": 5785, "era": "neviim-acharonim", "position_pct": 58, "description": "A visão final organiza serviço, liderança, terra, água vivificadora e presença divina." },
  "summary": { "short": "Yechezkel encerra com serviço ordenado, rio vivificador, terra repartida e cidade de presença divina.", "medium": "A visão do Templo continua com regras para portões, kohanim, leviim e o príncipe. Santidade e justiça estruturam a comunidade restaurada.\n\nUm rio flui do Templo e transforma o deserto em vida. A terra é repartida entre as tribos, e o nome final da cidade declara que Deus está ali.", "characters_main": ["Kohanim", "Leviim", "Nasi", "Tribos de Israel"], "characters_secondary": ["Estrangeiros residentes", "Pescadores"], "themes": ["Serviço", "Justiça", "Rio de vida", "Terra", "Presença"] },
  "facts": [
    { "id": "ez057", "order": 1, "text": "O portão oriental permanece fechado porque a glória divina entrou por ele.", "text_he": null, "refs": ["Ezekiel 44:1-3"], "ref_start": "Ezekiel 44:1", "ref_end": "Ezekiel 44:3", "chapter": 44, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Ezekiel 44:1-3", "tags": ["portão-oriental", "glória", "nasi"], "topic": "Portão fechado" },
    { "id": "ez058", "order": 2, "text": "Kohanim descendentes de Tzadok recebem responsabilidade especial pelo serviço sagrado.", "text_he": null, "refs": ["Ezekiel 44:4-31"], "ref_start": "Ezekiel 44:4", "ref_end": "Ezekiel 44:31", "chapter": 44, "verse_start": 4, "verse_end": 31, "sefaria_ref": "Ezekiel 44:4-31", "tags": ["kohanim", "tzadok", "serviço"], "topic": "Kohanim de Tzadok" },
    { "id": "ez059", "order": 3, "text": "Uma porção sagrada da terra é separada para o Templo, kohanim, leviim e cidade.", "text_he": null, "refs": ["Ezekiel 45:1-8"], "ref_start": "Ezekiel 45:1", "ref_end": "Ezekiel 45:8", "chapter": 45, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Ezekiel 45:1-8", "tags": ["porção-sagrada", "terra", "cidade"], "topic": "Porção sagrada" },
    { "id": "ez060", "order": 4, "text": "Príncipes são chamados a abandonar violência e usar medidas justas.", "text_he": null, "refs": ["Ezekiel 45:9-25"], "ref_start": "Ezekiel 45:9", "ref_end": "Ezekiel 45:25", "chapter": 45, "verse_start": 9, "verse_end": 25, "sefaria_ref": "Ezekiel 45:9-25", "tags": ["príncipes", "justiça", "medidas"], "topic": "Justiça do príncipe" },
    { "id": "ez061", "order": 5, "text": "O serviço do príncipe e do povo é organizado para Shabat, lua nova e festas.", "text_he": null, "refs": ["Ezekiel 46:1-24"], "ref_start": "Ezekiel 46:1", "ref_end": "Ezekiel 46:24", "chapter": 46, "verse_start": 1, "verse_end": 24, "sefaria_ref": "Ezekiel 46:1-24", "tags": ["shabat", "festas", "serviço"], "topic": "Ordem do serviço" },
    { "id": "ez062", "order": 6, "text": "Água flui do Templo, cresce em profundidade e transforma o mar em fonte de vida.", "text_he": null, "refs": ["Ezekiel 47:1-12"], "ref_start": "Ezekiel 47:1", "ref_end": "Ezekiel 47:12", "chapter": 47, "verse_start": 1, "verse_end": 12, "sefaria_ref": "Ezekiel 47:1-12", "tags": ["rio", "templo", "vida"], "topic": "Rio de vida" },
    { "id": "ez063", "order": 7, "text": "A terra é repartida, incluindo herança para estrangeiros residentes entre as tribos.", "text_he": null, "refs": ["Ezekiel 47:13-48:29"], "ref_start": "Ezekiel 47:13", "ref_end": "Ezekiel 48:29", "chapter": 47, "verse_start": 13, "verse_end_chapter": 48, "verse_end": 29, "sefaria_ref": "Ezekiel 47:13-48:29", "tags": ["terra", "tribos", "estrangeiros"], "topic": "Divisão da terra" },
    { "id": "ez064", "order": 8, "text": "A cidade renovada recebe o nome 'Deus está ali', encerrando o livro com presença restaurada.", "text_he": null, "refs": ["Ezekiel 48:30-35"], "ref_start": "Ezekiel 48:30", "ref_end": "Ezekiel 48:35", "chapter": 48, "verse_start": 30, "verse_end": 35, "sefaria_ref": "Ezekiel 48:30-35", "tags": ["cidade", "presença", "nome"], "topic": "Deus está ali" }
