  "identity": { "id": "siege-signs-judgment", "label": "Sinais do cerco e julgamento", "label_pt": "Tijolo, deitar-se, fome, espada e denúncia contra a terra", "hebrew": null, "transliteration": "Siege Signs and Judgment" },
