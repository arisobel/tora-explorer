  "timeline": { "period_name": "Sinais do cerco", "anno_mundi_start": 3327, "anno_mundi_end": 3333, "era": "neviim-acharonim", "position_pct": 58, "description": "Yechezkel dramatiza o cerco e a fome que atingirão Yerushalayim." },
  "summary": { "short": "Sinais dramáticos anunciam cerco, fome, espada e fim da falsa segurança de Yehudá.", "medium": "Yechezkel transforma seu corpo e objetos cotidianos em sinais proféticos: tijolo, placa de ferro, alimento racionado e cabelo dividido.\n\nA mensagem alcança os montes de Israel e anuncia que o fim chegou por causa da idolatria e violência.", "characters_main": ["Yechezkel", "Yerushalayim", "Montes de Israel"], "characters_secondary": ["Casa de Israel", "Remanescente"], "themes": ["Cerco", "Fome", "Espada", "Julgamento"] },
  "facts": [
    { "id": "ez009", "order": 1, "text": "Yechezkel desenha Yerushalayim num tijolo e representa um cerco contra ela.", "text_he": null, "refs": ["Ezekiel 4:1-3"], "ref_start": "Ezekiel 4:1", "ref_end": "Ezekiel 4:3", "chapter": 4, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Ezekiel 4:1-3", "tags": ["tijolo", "cerco", "yerushalayim"], "topic": "Tijolo do cerco" },
    { "id": "ez010", "order": 2, "text": "O profeta se deita sobre os lados para carregar simbolicamente a iniquidade de Israel e Yehudá.", "text_he": null, "refs": ["Ezekiel 4:4-8"], "ref_start": "Ezekiel 4:4", "ref_end": "Ezekiel 4:8", "chapter": 4, "verse_start": 4, "verse_end": 8, "sefaria_ref": "Ezekiel 4:4-8", "tags": ["sinal", "iniquidade", "israel"], "topic": "Dias sobre os lados" },
    { "id": "ez011", "order": 3, "text": "Alimento e água são racionados para representar fome e ansiedade durante o cerco.", "text_he": null, "refs": ["Ezekiel 4:9-17"], "ref_start": "Ezekiel 4:9", "ref_end": "Ezekiel 4:17", "chapter": 4, "verse_start": 9, "verse_end": 17, "sefaria_ref": "Ezekiel 4:9-17", "tags": ["fome", "racionamento", "cerco"], "topic": "Alimento racionado" },
    { "id": "ez012", "order": 4, "text": "Cabelo cortado e dividido simboliza morte por peste, espada e dispersão.", "text_he": null, "refs": ["Ezekiel 5:1-4"], "ref_start": "Ezekiel 5:1", "ref_end": "Ezekiel 5:4", "chapter": 5, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Ezekiel 5:1-4", "tags": ["cabelo", "espada", "dispersão"], "topic": "Cabelo dividido" },
    { "id": "ez013", "order": 5, "text": "Yerushalayim é julgada por se rebelar mais intensamente que as nações ao redor.", "text_he": null, "refs": ["Ezekiel 5:5-17"], "ref_start": "Ezekiel 5:5", "ref_end": "Ezekiel 5:17", "chapter": 5, "verse_start": 5, "verse_end": 17, "sefaria_ref": "Ezekiel 5:5-17", "tags": ["yerushalayim", "rebeldia", "juízo"], "topic": "Cidade no centro" },
    { "id": "ez014", "order": 6, "text": "Os montes de Israel são denunciados por altares e idolatria espalhados pela terra.", "text_he": null, "refs": ["Ezekiel 6:1-7"], "ref_start": "Ezekiel 6:1", "ref_end": "Ezekiel 6:7", "chapter": 6, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Ezekiel 6:1-7", "tags": ["montes", "altares", "idolatria"], "topic": "Montes de Israel" },
    { "id": "ez015", "order": 7, "text": "Um remanescente lembrará Deus entre as nações e reconhecerá a gravidade de sua infidelidade.", "text_he": null, "refs": ["Ezekiel 6:8-14"], "ref_start": "Ezekiel 6:8", "ref_end": "Ezekiel 6:14", "chapter": 6, "verse_start": 8, "verse_end": 14, "sefaria_ref": "Ezekiel 6:8-14", "tags": ["remanescente", "nações", "memória"], "topic": "Remanescente disperso" },
    { "id": "ez016", "order": 8, "text": "O fim chegou: riqueza e comércio não poderão salvar a terra de violência e juízo.", "text_he": null, "refs": ["Ezekiel 7:1-27"], "ref_start": "Ezekiel 7:1", "ref_end": "Ezekiel 7:27", "chapter": 7, "verse_start": 1, "verse_end": 27, "sefaria_ref": "Ezekiel 7:1-27", "tags": ["fim", "riqueza", "violência"], "topic": "O fim chegou" }
  ]
