  "timeline": { "period_name": "Parábolas e responsabilidade", "anno_mundi_start": 3333, "anno_mundi_end": 3336, "era": "neviim-acharonim", "position_pct": 58, "description": "Sinais e parábolas desmontam falsas expectativas e enfatizam responsabilidade individual." },
  "summary": { "short": "Parábolas e sinais explicam o exílio e afirmam responsabilidade moral individual.", "medium": "Yechezkel encena a saída do exílio e denuncia profetas que constroem paredes frágeis de esperança falsa.\n\nParábolas da videira, da esposa infiel, das águias e dos leões interpretam a história de Yerushalayim. O capítulo 18 afirma que cada pessoa responde por seu caminho.", "characters_main": ["Yechezkel", "Príncipe de Yerushalayim", "Casa de Israel"], "characters_secondary": ["Falsos profetas", "Águias", "Leões"], "themes": ["Exílio", "Falsos profetas", "Parábola", "Responsabilidade"] },
  "facts": [
    { "id": "ez025", "order": 1, "text": "Yechezkel prepara bagagem e sai por um buraco no muro como sinal do exílio do príncipe.", "text_he": null, "refs": ["Ezekiel 12:1-16"], "ref_start": "Ezekiel 12:1", "ref_end": "Ezekiel 12:16", "chapter": 12, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Ezekiel 12:1-16", "tags": ["bagagem", "exílio", "príncipe"], "topic": "Bagagem do exílio" },
    { "id": "ez026", "order": 2, "text": "Comer com tremor representa ansiedade e desolação que atingirão a terra.", "text_he": null, "refs": ["Ezekiel 12:17-28"], "ref_start": "Ezekiel 12:17", "ref_end": "Ezekiel 12:28", "chapter": 12, "verse_start": 17, "verse_end": 28, "sefaria_ref": "Ezekiel 12:17-28", "tags": ["tremor", "desolação", "palavra"], "topic": "Alimento com temor" },
    { "id": "ez027", "order": 3, "text": "Falsos profetas são comparados a quem reboca uma parede frágil que cairá.", "text_he": null, "refs": ["Ezekiel 13:1-23"], "ref_start": "Ezekiel 13:1", "ref_end": "Ezekiel 13:23", "chapter": 13, "verse_start": 1, "verse_end": 23, "sefaria_ref": "Ezekiel 13:1-23", "tags": ["falsos-profetas", "parede", "falsa-paz"], "topic": "Parede rebocada" },
    { "id": "ez028", "order": 4, "text": "Anciãos com ídolos no coração são confrontados, e responsabilidade não pode ser terceirizada.", "text_he": null, "refs": ["Ezekiel 14:1-23"], "ref_start": "Ezekiel 14:1", "ref_end": "Ezekiel 14:23", "chapter": 14, "verse_start": 1, "verse_end": 23, "sefaria_ref": "Ezekiel 14:1-23", "tags": ["anciãos", "coração", "responsabilidade"], "topic": "Ídolos no coração" },
    { "id": "ez029", "order": 5, "text": "Yerushalayim é comparada a madeira de videira inútil quando não produz fruto.", "text_he": null, "refs": ["Ezekiel 15:1-8"], "ref_start": "Ezekiel 15:1", "ref_end": "Ezekiel 15:8", "chapter": 15, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Ezekiel 15:1-8", "tags": ["videira", "fruto", "yerushalayim"], "topic": "Madeira da videira" },
    { "id": "ez030", "order": 6, "text": "A história de Yerushalayim é contada como esposa resgatada que se torna infiel.", "text_he": null, "refs": ["Ezekiel 16:1-63"], "ref_start": "Ezekiel 16:1", "ref_end": "Ezekiel 16:63", "chapter": 16, "verse_start": 1, "verse_end": 63, "sefaria_ref": "Ezekiel 16:1-63", "tags": ["yerushalayim", "aliança", "infidelidade"], "topic": "Esposa infiel" },
    { "id": "ez031", "order": 7, "text": "A parábola das duas águias interpreta alianças políticas e rebelião contra Bavel.", "text_he": null, "refs": ["Ezekiel 17:1-24"], "ref_start": "Ezekiel 17:1", "ref_end": "Ezekiel 17:24", "chapter": 17, "verse_start": 1, "verse_end": 24, "sefaria_ref": "Ezekiel 17:1-24", "tags": ["águias", "bavel", "aliança"], "topic": "Duas águias" },
    { "id": "ez032", "order": 8, "text": "Yechezkel afirma que a pessoa que peca morrerá e que Deus deseja retorno, não morte.", "text_he": null, "refs": ["Ezekiel 18:1-19:14"], "ref_start": "Ezekiel 18:1", "ref_end": "Ezekiel 19:14", "chapter": 18, "verse_start": 1, "verse_end_chapter": 19, "verse_end": 14, "sefaria_ref": "Ezekiel 18:1-19:14", "tags": ["responsabilidade", "teshuvah", "vida"], "topic": "Responsabilidade individual" }
  ]
