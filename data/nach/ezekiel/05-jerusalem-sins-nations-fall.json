  "summary": { "short": "Yechezkel revisa a rebeldia de Israel, anuncia juízo às nações e recebe a notícia da queda.", "medium": "A história de Israel é recontada como persistente rebeldia, e Yerushalayim aparece como cidade sanguinária. A espada de Bavel se aproxima.\n\nApós sinais dolorosos e oráculos contra nações, um fugitivo chega com a notícia: a cidade caiu. A função de sentinela é renovada.", "characters_main": ["Yechezkel", "Anciãos de Israel", "Yerushalayim", "Tzor", "Egito"], "characters_secondary": ["Oholah", "Oholivah", "Faraó", "Fugitivo"], "themes": ["Rebeldia", "Espada", "Nações", "Queda"] },
  "facts": [
    { "id": "ez033", "order": 1, "text": "Yechezkel revisa a história de Israel como série de rebeliões desde o Egito e o deserto.", "text_he": null, "refs": ["Ezekiel 20:1-44"], "ref_start": "Ezekiel 20:1", "ref_end": "Ezekiel 20:44", "chapter": 20, "verse_start": 1, "verse_end": 44, "sefaria_ref": "Ezekiel 20:1-44", "tags": ["história", "rebeldia", "deserto"], "topic": "História de rebeldia" },
    { "id": "ez034", "order": 2, "text": "A espada de Bavel é afiada e aponta para Yerushalayim por meio de adivinhação do rei.", "text_he": null, "refs": ["Ezekiel 21:1-37"], "ref_start": "Ezekiel 21:1", "ref_end": "Ezekiel 21:37", "chapter": 21, "verse_start": 1, "verse_end": 37, "sefaria_ref": "Ezekiel 21:1-37", "tags": ["espada", "bavel", "yerushalayim"], "topic": "Espada contra a cidade" },
    { "id": "ez035", "order": 3, "text": "Yerushalayim é chamada cidade sanguinária por violência, idolatria e injustiça social.", "text_he": null, "refs": ["Ezekiel 22:1-31"], "ref_start": "Ezekiel 22:1", "ref_end": "Ezekiel 22:31", "chapter": 22, "verse_start": 1, "verse_end": 31, "sefaria_ref": "Ezekiel 22:1-31", "tags": ["cidade-sanguinária", "violência", "injustiça"], "topic": "Cidade sanguinária" },
    { "id": "ez036", "order": 4, "text": "Oholah e Oholivah simbolizam Shomron e Yerushalayim em alianças infiéis.", "text_he": null, "refs": ["Ezekiel 23:1-49"], "ref_start": "Ezekiel 23:1", "ref_end": "Ezekiel 23:49", "chapter": 23, "verse_start": 1, "verse_end": 49, "sefaria_ref": "Ezekiel 23:1-49", "tags": ["shomron", "yerushalayim", "alianças"], "topic": "Oholah e Oholivah" },
    { "id": "ez037", "order": 5, "text": "A panela enferrujada representa Yerushalayim no dia em que começa o cerco.", "text_he": null, "refs": ["Ezekiel 24:1-14"], "ref_start": "Ezekiel 24:1", "ref_end": "Ezekiel 24:14", "chapter": 24, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Ezekiel 24:1-14", "tags": ["panela", "cerco", "ferrugem"], "topic": "Panela enferrujada" },
    { "id": "ez038", "order": 6, "text": "A morte da esposa de Yechezkel torna-se sinal da perda do santuário amado.", "text_he": null, "refs": ["Ezekiel 24:15-27"], "ref_start": "Ezekiel 24:15", "ref_end": "Ezekiel 24:27", "chapter": 24, "verse_start": 15, "verse_end": 27, "sefaria_ref": "Ezekiel 24:15-27", "tags": ["esposa", "santuário", "sinal"], "topic": "Sinal da perda" },
    { "id": "ez039", "order": 7, "text": "Oráculos contra Amon, Moav, Edom, Pelishtim, Tzor e Egito mostram que as nações também são julgadas.", "text_he": null, "refs": ["Ezekiel 25:1-32:32"], "ref_start": "Ezekiel 25:1", "ref_end": "Ezekiel 32:32", "chapter": 25, "verse_start": 1, "verse_end_chapter": 32, "verse_end": 32, "sefaria_ref": "Ezekiel 25:1-32:32", "tags": ["nações", "tzor", "egito"], "topic": "Juízo das nações" },
    { "id": "ez040", "order": 8, "text": "Um fugitivo anuncia que Yerushalayim caiu, e Yechezkel retoma sua função de sentinela.", "text_he": null, "refs": ["Ezekiel 33:1-33"], "ref_start": "Ezekiel 33:1", "ref_end": "Ezekiel 33:33", "chapter": 33, "verse_start": 1, "verse_end": 33, "sefaria_ref": "Ezekiel 33:1-33", "tags": ["fugitivo", "queda", "sentinela"], "topic": "A cidade caiu" }
