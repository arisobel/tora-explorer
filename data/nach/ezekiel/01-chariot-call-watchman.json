  "summary": { "short": "Yechezkel vê a glória divina na Babilônia, come o rolo e é estabelecido como sentinela.", "medium": "O livro começa junto ao rio Kevar, entre os exilados. A presença divina não está limitada a Yerushalayim: Yechezkel vê seres viventes, rodas e uma semelhança de trono.\n\nO profeta recebe um rolo de lamentações, deve comê-lo e falar a uma casa rebelde. Sua função é descrita como sentinela responsável por advertir.", "characters_main": ["Yechezkel", "Exilados", "Seres viventes"], "characters_secondary": ["Casa de Israel"], "themes": ["Glória divina", "Chamado", "Rolo", "Sentinela"] },
  "facts": [
    { "id": "ez001", "order": 1, "text": "Yechezkel está entre os exilados junto ao rio Kevar quando os céus se abrem.", "text_he": null, "refs": ["Ezekiel 1:1-3"], "ref_start": "Ezekiel 1:1", "ref_end": "Ezekiel 1:3", "chapter": 1, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Ezekiel 1:1-3", "tags": ["kevar", "exílio", "visão"], "topic": "Abertura no exílio" },
    { "id": "ez002", "order": 2, "text": "Uma tempestade revela quatro seres viventes com movimento coordenado pelo espírito.", "text_he": null, "refs": ["Ezekiel 1:4-14"], "ref_start": "Ezekiel 1:4", "ref_end": "Ezekiel 1:14", "chapter": 1, "verse_start": 4, "verse_end": 14, "sefaria_ref": "Ezekiel 1:4-14", "tags": ["seres-viventes", "espírito", "visão"], "topic": "Seres viventes" },
    { "id": "ez003", "order": 3, "text": "Rodas cheias de olhos acompanham os seres, indicando mobilidade da presença divina.", "text_he": null, "refs": ["Ezekiel 1:15-21"], "ref_start": "Ezekiel 1:15", "ref_end": "Ezekiel 1:21", "chapter": 1, "verse_start": 15, "verse_end": 21, "sefaria_ref": "Ezekiel 1:15-21", "tags": ["rodas", "olhos", "presença"], "topic": "Rodas da carruagem" },
    { "id": "ez004", "order": 4, "text": "Acima do firmamento aparece semelhança de trono e de glória divina, cercada como arco-íris.", "text_he": null, "refs": ["Ezekiel 1:22-28"], "ref_start": "Ezekiel 1:22", "ref_end": "Ezekiel 1:28", "chapter": 1, "verse_start": 22, "verse_end": 28, "sefaria_ref": "Ezekiel 1:22-28", "tags": ["trono", "glória", "arco-íris"], "topic": "Visão da glória" },
    { "id": "ez005", "order": 5, "text": "Yechezkel é enviado a uma casa rebelde e deve falar mesmo que não ouçam.", "text_he": null, "refs": ["Ezekiel 2:1-7"], "ref_start": "Ezekiel 2:1", "ref_end": "Ezekiel 2:7", "chapter": 2, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Ezekiel 2:1-7", "tags": ["missão", "rebeldia", "profecia"], "topic": "Casa rebelde" },
    { "id": "ez006", "order": 6, "text": "O profeta come um rolo escrito com lamentações, que se torna doce em sua boca.", "text_he": null, "refs": ["Ezekiel 2:8-3:3"], "ref_start": "Ezekiel 2:8", "ref_end": "Ezekiel 3:3", "chapter": 2, "verse_start": 8, "verse_end_chapter": 3, "verse_end": 3, "sefaria_ref": "Ezekiel 2:8-3:3", "tags": ["rolo", "palavra", "doçura"], "topic": "Rolo comido" },
    { "id": "ez007", "order": 7, "text": "Yechezkel se senta atônito entre os exilados em Tel-Aviv por sete dias.", "text_he": null, "refs": ["Ezekiel 3:4-15"], "ref_start": "Ezekiel 3:4", "ref_end": "Ezekiel 3:15", "chapter": 3, "verse_start": 4, "verse_end": 15, "sefaria_ref": "Ezekiel 3:4-15", "tags": ["tel-aviv", "exilados", "silêncio"], "topic": "Entre os exilados" },
    { "id": "ez008", "order": 8, "text": "Deus estabelece Yechezkel como sentinela responsável por advertir justo e ímpio.", "text_he": null, "refs": ["Ezekiel 3:16-27"], "ref_start": "Ezekiel 3:16", "ref_end": "Ezekiel 3:27", "chapter": 3, "verse_start": 16, "verse_end": 27, "sefaria_ref": "Ezekiel 3:16-27", "tags": ["sentinela", "responsabilidade", "advertência"], "topic": "Sentinela de Israel" }
