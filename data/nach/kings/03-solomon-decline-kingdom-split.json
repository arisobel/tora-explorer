  "timeline": { "period_name": "Declínio de Shlomo e divisão", "anno_mundi_start": 2935, "anno_mundi_end": 2964, "era": "neviim-rishonim", "position_pct": 70, "description": "A grandeza de Shlomo é seguida por erosão espiritual e ruptura política entre os reinos." },
  "summary": { "short": "O reinado de Shlomo termina em tensão espiritual e política, levando à divisão entre norte e sul.", "medium": "Após a dedicação, Deus reafirma promessa e responsabilidade. A narrativa mostra a riqueza internacional de Shlomo, mas também seu desvio por alianças e cultos estrangeiros.\n\nA profecia a Yeravam anuncia ruptura. Depois da morte de Shlomo, a dureza de Rechavam desencadeia a separação de Israel e Yehudá.", "characters_main": ["Shlomo", "Rainha de Sheva", "Achiyah", "Yeravam", "Rechavam"], "characters_secondary": ["Hadad", "Rezon", "Adoram"], "themes": ["Aliança", "Riqueza", "Idolatria", "Divisão"] },
  "facts": [
    { "id": "kg017", "order": 1, "text": "Deus aparece novamente a Shlomo, ligando a permanência da casa real à fidelidade.", "text_he": null, "refs": ["I Kings 9:1-9"], "ref_start": "I Kings 9:1", "ref_end": "I Kings 9:9", "chapter": 9, "verse_start": 1, "verse_end": 9, "sefaria_ref": "I Kings 9:1-9", "tags": ["aliança", "fidelidade", "advertência"], "topic": "Promessa e advertência" },
    { "id": "kg018", "order": 2, "text": "Shlomo desenvolve cidades, frota e comércio em escala internacional.", "text_he": null, "refs": ["I Kings 9:10-28"], "ref_start": "I Kings 9:10", "ref_end": "I Kings 9:28", "chapter": 9, "verse_start": 10, "verse_end": 28, "sefaria_ref": "I Kings 9:10-28", "tags": ["obras", "comércio", "riqueza"], "topic": "Expansão econômica" },
    { "id": "kg019", "order": 3, "text": "A rainha de Sheva visita Shlomo e reconhece sua sabedoria e prosperidade.", "text_he": null, "refs": ["I Kings 10:1-13"], "ref_start": "I Kings 10:1", "ref_end": "I Kings 10:13", "chapter": 10, "verse_start": 1, "verse_end": 13, "sefaria_ref": "I Kings 10:1-13", "tags": ["sheva", "sabedoria", "nações"], "topic": "Visita de Sheva" },
    { "id": "kg020", "order": 4, "text": "A riqueza de Shlomo é descrita em ouro, cavalos, tronos e prestígio externo.", "text_he": null, "refs": ["I Kings 10:14-29"], "ref_start": "I Kings 10:14", "ref_end": "I Kings 10:29", "chapter": 10, "verse_start": 14, "verse_end": 29, "sefaria_ref": "I Kings 10:14-29", "tags": ["ouro", "cavalos", "poder"], "topic": "Apogeu material" },
    { "id": "kg021", "order": 5, "text": "Mulheres estrangeiras desviam o coração de Shlomo para cultos idólatras.", "text_he": null, "refs": ["I Kings 11:1-13"], "ref_start": "I Kings 11:1", "ref_end": "I Kings 11:13", "chapter": 11, "verse_start": 1, "verse_end": 13, "sefaria_ref": "I Kings 11:1-13", "tags": ["idolatria", "alianças", "declínio"], "topic": "Desvio espiritual" },
    { "id": "kg022", "order": 6, "text": "Adversários externos e internos surgem como sinal de enfraquecimento do reino.", "text_he": null, "refs": ["I Kings 11:14-25"], "ref_start": "I Kings 11:14", "ref_end": "I Kings 11:25", "chapter": 11, "verse_start": 14, "verse_end": 25, "sefaria_ref": "I Kings 11:14-25", "tags": ["adversários", "juízo", "política"], "topic": "Oposição a Shlomo" },
    { "id": "kg023", "order": 7, "text": "Achiyah rasga a capa em doze partes e anuncia que Yeravam governará dez tribos.", "text_he": null, "refs": ["I Kings 11:26-40"], "ref_start": "I Kings 11:26", "ref_end": "I Kings 11:40", "chapter": 11, "verse_start": 26, "verse_end": 40, "sefaria_ref": "I Kings 11:26-40", "tags": ["achiyah", "yeravam", "profecia"], "topic": "Profecia da ruptura" },
    { "id": "kg024", "order": 8, "text": "Rechavam rejeita o conselho dos anciãos, e o reino se divide entre Yehudá e Israel.", "text_he": null, "refs": ["I Kings 12:1-33"], "ref_start": "I Kings 12:1", "ref_end": "I Kings 12:33", "chapter": 12, "verse_start": 1, "verse_end": 33, "sefaria_ref": "I Kings 12:1-33", "tags": ["rechavam", "yeravam", "divisão"], "topic": "Cisão do reino" }
