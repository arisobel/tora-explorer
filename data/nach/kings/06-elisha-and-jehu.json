  "identity": { "id": "elisha-and-jehu", "label": "Elisha e a revolução de Yehu", "label_pt": "Milagres de Elisha, Naaman, cerco de Shomron e queda da casa de Achav", "hebrew": null, "transliteration": "Elisha and Jehu" },
  "range": { "ref_start": "II Kings 3:1", "ref_end": "II Kings 10:36", "sefaria_ref": "II Kings 3:1-10:36", "chapters_covered": [3,4,5,6,7,8,9,10], "chapter_start": 3, "chapter_end": 10, "verse_start": 1, "verse_end_chapter": 10, "verse_end": 36 },
  "timeline": { "period_name": "Elisha e Yehu", "anno_mundi_start": 3053, "anno_mundi_end": 3065, "era": "neviim-rishonim", "position_pct": 75, "description": "Elisha revela cuidado e juízo em meio a guerras, fome e transformação política." },
  "summary": { "short": "Elisha atua entre cura, sustento e guerra, enquanto Yehu executa juízo sobre a casa de Achav.", "medium": "Elisha intervém em crise militar, pobreza, morte, fome e doença. Seus sinais mostram uma presença profética que sustenta e corrige Israel em meio à instabilidade.\n\nA unção de Yehu leva ao fim violento da casa de Achav. A idolatria de Baal é atacada, mas o reino do norte continua preso ao pecado estrutural de Yeravam.", "characters_main": ["Elisha", "Yehoram", "Naaman", "Chazael", "Yehu"], "characters_secondary": ["Shunamit", "Gechazi", "Izevel", "Yehonadav"], "themes": ["Milagre", "Cura", "Juízo", "Revolução"] },
  "facts": [
    { "id": "kg041", "order": 1, "text": "Elisha orienta reis em guerra contra Moav, e água aparece no deserto.", "text_he": null, "refs": ["II Kings 3:1-27"], "ref_start": "II Kings 3:1", "ref_end": "II Kings 3:27", "chapter": 3, "verse_start": 1, "verse_end": 27, "sefaria_ref": "II Kings 3:1-27", "tags": ["moav", "elisha", "água"], "topic": "Guerra contra Moav" },
    { "id": "kg042", "order": 2, "text": "Elisha multiplica azeite para a viúva e promete filho à mulher de Shunem.", "text_he": null, "refs": ["II Kings 4:1-17"], "ref_start": "II Kings 4:1", "ref_end": "II Kings 4:17", "chapter": 4, "verse_start": 1, "verse_end": 17, "sefaria_ref": "II Kings 4:1-17", "tags": ["azeite", "shunem", "sustento"], "topic": "Sustento e promessa" },
    { "id": "kg043", "order": 3, "text": "Elisha revive o filho da Shunamit e transforma morte em vida.", "text_he": null, "refs": ["II Kings 4:18-37"], "ref_start": "II Kings 4:18", "ref_end": "II Kings 4:37", "chapter": 4, "verse_start": 18, "verse_end": 37, "sefaria_ref": "II Kings 4:18-37", "tags": ["shunamit", "vida", "milagre"], "topic": "Filho da Shunamit" },
    { "id": "kg044", "order": 4, "text": "Elisha cura alimento envenenado e multiplica pães para os discípulos dos profetas.", "text_he": null, "refs": ["II Kings 4:38-44"], "ref_start": "II Kings 4:38", "ref_end": "II Kings 4:44", "chapter": 4, "verse_start": 38, "verse_end": 44, "sefaria_ref": "II Kings 4:38-44", "tags": ["alimento", "profetas", "multiplicação"], "topic": "Sinais de provisão" },
    { "id": "kg045", "order": 5, "text": "Naaman é curado da tzaraat ao mergulhar no Yarden, aprendendo humildade.", "text_he": null, "refs": ["II Kings 5:1-27"], "ref_start": "II Kings 5:1", "ref_end": "II Kings 5:27", "chapter": 5, "verse_start": 1, "verse_end": 27, "sefaria_ref": "II Kings 5:1-27", "tags": ["naaman", "yarden", "cura"], "topic": "Cura de Naaman" },
    { "id": "kg046", "order": 6, "text": "Elisha revela movimentos de Aram, mostra carros de fogo e conduz inimigos a Shomron.", "text_he": null, "refs": ["II Kings 6:1-23"], "ref_start": "II Kings 6:1", "ref_end": "II Kings 6:23", "chapter": 6, "verse_start": 1, "verse_end": 23, "sefaria_ref": "II Kings 6:1-23", "tags": ["aram", "carros-de-fogo", "visão"], "topic": "Proteção profética" },
    { "id": "kg047", "order": 7, "text": "Durante o cerco de Shomron, Elisha anuncia reversão da fome e salvação inesperada.", "text_he": null, "refs": ["II Kings 6:24-7:20"], "ref_start": "II Kings 6:24", "ref_end": "II Kings 7:20", "chapter": 6, "verse_start": 24, "verse_end_chapter": 7, "verse_end": 20, "sefaria_ref": "II Kings 6:24-7:20", "tags": ["shomron", "fome", "salvação"], "topic": "Cerco de Shomron" },
    { "id": "kg048", "order": 8, "text": "Yehu é ungido, mata Yoram e Izevel, e destrói a casa de Achav e o culto de Baal.", "text_he": null, "refs": ["II Kings 8:1-10:36"], "ref_start": "II Kings 8:1", "ref_end": "II Kings 10:36", "chapter": 8, "verse_start": 1, "verse_end_chapter": 10, "verse_end": 36, "sefaria_ref": "II Kings 8:1-10:36", "tags": ["yehu", "izevel", "baal"], "topic": "Revolução de Yehu" }
  ]
