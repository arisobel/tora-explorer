  "identity": { "id": "solomon-consolidation-wisdom", "label": "Shlomo consolida o reino", "label_pt": "Sucessão de David, sabedoria de Shlomo e organização do reino", "hebrew": null, "transliteration": "Solomon Consolidation and Wisdom" },
  "range": { "ref_start": "I Kings 1:1", "ref_end": "I Kings 4:34", "sefaria_ref": "I Kings 1:1-4:34", "chapters_covered": [1,2,3,4], "chapter_start": 1, "chapter_end": 4, "verse_start": 1, "verse_end_chapter": 4, "verse_end": 34 },
  "timeline": { "period_name": "Sucessão e sabedoria de Shlomo", "anno_mundi_start": 2924, "anno_mundi_end": 2928, "era": "neviim-rishonim", "position_pct": 68, "description": "A transição de David para Shlomo estabelece a monarquia davídica em sua fase de estabilidade e sabedoria." },
  "summary": { "short": "Shlomo sucede David, pede sabedoria e organiza um reino amplo e próspero.", "medium": "Melachim começa com a fragilidade final de David e a disputa sucessória. Bat Sheva e Natan garantem a coroação de Shlomo, que recebe instruções finais de David e consolida o trono.\n\nEm Givon, Shlomo pede discernimento para julgar o povo. A narrativa mostra sua sabedoria por meio do julgamento das duas mulheres e descreve a ordem administrativa do reino.", "characters_main": ["David", "Shlomo", "Bat Sheva", "Natan", "Adoniyahu"], "characters_secondary": ["Tzadok", "Benayahu", "Yoav", "Shimi"], "themes": ["Sucessão", "Sabedoria", "Justiça", "Reino"] },
  "facts": [
    { "id": "kg001", "order": 1, "text": "David envelhece, e Adoniyahu tenta assumir o trono sem o aval profético e sacerdotal.", "text_he": null, "refs": ["I Kings 1:1-10"], "ref_start": "I Kings 1:1", "ref_end": "I Kings 1:10", "chapter": 1, "verse_start": 1, "verse_end": 10, "sefaria_ref": "I Kings 1:1-10", "tags": ["david", "adoniyahu", "sucessão"], "topic": "Disputa sucessória" },
    { "id": "kg002", "order": 2, "text": "Natan e Bat Sheva alertam David, que confirma Shlomo como sucessor.", "text_he": null, "refs": ["I Kings 1:11-31"], "ref_start": "I Kings 1:11", "ref_end": "I Kings 1:31", "chapter": 1, "verse_start": 11, "verse_end": 31, "sefaria_ref": "I Kings 1:11-31", "tags": ["natan", "bat-sheva", "shlomo"], "topic": "Confirmação de Shlomo" },
    { "id": "kg003", "order": 3, "text": "Shlomo é ungido em Gichon, e o povo celebra sua ascensão ao trono.", "text_he": null, "refs": ["I Kings 1:32-40"], "ref_start": "I Kings 1:32", "ref_end": "I Kings 1:40", "chapter": 1, "verse_start": 32, "verse_end": 40, "sefaria_ref": "I Kings 1:32-40", "tags": ["gichon", "unção", "reino"], "topic": "Unção em Gichon" },
    { "id": "kg004", "order": 4, "text": "David orienta Shlomo a guardar a Torá e a lidar com pendências políticas do reino.", "text_he": null, "refs": ["I Kings 2:1-12"], "ref_start": "I Kings 2:1", "ref_end": "I Kings 2:12", "chapter": 2, "verse_start": 1, "verse_end": 12, "sefaria_ref": "I Kings 2:1-12", "tags": ["david", "torá", "testamento"], "topic": "Instruções finais de David" },
    { "id": "kg005", "order": 5, "text": "Shlomo consolida o trono ao resolver ameaças internas ligadas a Adoniyahu, Yoav e Shimi.", "text_he": null, "refs": ["I Kings 2:13-46"], "ref_start": "I Kings 2:13", "ref_end": "I Kings 2:46", "chapter": 2, "verse_start": 13, "verse_end": 46, "sefaria_ref": "I Kings 2:13-46", "tags": ["consolidação", "justiça", "trono"], "topic": "Estabilização do reino" },
    { "id": "kg006", "order": 6, "text": "Em Givon, Shlomo pede coração capaz de ouvir e julgar o povo com discernimento.", "text_he": null, "refs": ["I Kings 3:1-15"], "ref_start": "I Kings 3:1", "ref_end": "I Kings 3:15", "chapter": 3, "verse_start": 1, "verse_end": 15, "sefaria_ref": "I Kings 3:1-15", "tags": ["givon", "sabedoria", "oração"], "topic": "Pedido de sabedoria" },
    { "id": "kg007", "order": 7, "text": "O julgamento das duas mulheres revela a sabedoria de Shlomo diante de Israel.", "text_he": null, "refs": ["I Kings 3:16-28"], "ref_start": "I Kings 3:16", "ref_end": "I Kings 3:28", "chapter": 3, "verse_start": 16, "verse_end": 28, "sefaria_ref": "I Kings 3:16-28", "tags": ["julgamento", "maternidade", "sabedoria"], "topic": "Julgamento exemplar" },
    { "id": "kg008", "order": 8, "text": "O reino é descrito com administração, abundância e sabedoria reconhecida entre os povos.", "text_he": null, "refs": ["I Kings 4:1-34"], "ref_start": "I Kings 4:1", "ref_end": "I Kings 4:34", "chapter": 4, "verse_start": 1, "verse_end": 34, "sefaria_ref": "I Kings 4:1-34", "tags": ["administração", "prosperidade", "sabedoria"], "topic": "Ordem do reino" }
  ]
