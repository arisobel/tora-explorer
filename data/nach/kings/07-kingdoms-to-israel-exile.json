  "identity": { "id": "kingdoms-to-israel-exile", "label": "Dos reis posteriores ao exílio de Israel", "label_pt": "Atalyah, Yoash, instabilidade dos reinos e queda de Shomron", "hebrew": null, "transliteration": "Kingdoms to Israel Exile" },
  "range": { "ref_start": "II Kings 11:1", "ref_end": "II Kings 17:41", "sefaria_ref": "II Kings 11:1-17:41", "chapters_covered": [11,12,13,14,15,16,17], "chapter_start": 11, "chapter_end": 17, "verse_start": 1, "verse_end_chapter": 17, "verse_end": 41 },
  "timeline": { "period_name": "Instabilidade e exílio de Israel", "anno_mundi_start": 3065, "anno_mundi_end": 3205, "era": "neviim-rishonim", "position_pct": 77, "description": "A continuidade dos reinos mostra reformas parciais, decadência persistente e o exílio assírio do norte." },
  "summary": { "short": "A alternância de reis culmina no exílio assírio do reino do norte.", "medium": "Yehudá passa por uma crise dinástica com Atalyah e pela restauração de Yoash sob Yehoyada. Reformas e falhas se alternam.\n\nNo norte, a instabilidade política e o pecado de Yeravam persistem. A Assíria conquista Shomron e exila Israel, interpretado como consequência da rejeição da aliança.", "characters_main": ["Atalyah", "Yoash", "Yehoyada", "Yeravam II", "Hoshea"], "characters_secondary": ["Yehoachaz", "Amaziah", "Azariah", "Achaz", "Shalmaneser"], "themes": ["Reforma", "Instabilidade", "Assíria", "Exílio"] },
  "facts": [
    { "id": "kg049", "order": 1, "text": "Atalyah toma o poder em Yehudá, mas Yoash é preservado no Templo.", "text_he": null, "refs": ["II Kings 11:1-3"], "ref_start": "II Kings 11:1", "ref_end": "II Kings 11:3", "chapter": 11, "verse_start": 1, "verse_end": 3, "sefaria_ref": "II Kings 11:1-3", "tags": ["atalyah", "yoash", "templo"], "topic": "Yoash preservado" },
    { "id": "kg050", "order": 2, "text": "Yehoyada coroa Yoash, renova a aliança e remove o culto de Baal em Yehudá.", "text_he": null, "refs": ["II Kings 11:4-21"], "ref_start": "II Kings 11:4", "ref_end": "II Kings 11:21", "chapter": 11, "verse_start": 4, "verse_end": 21, "sefaria_ref": "II Kings 11:4-21", "tags": ["yehoyada", "aliança", "baal"], "topic": "Renovação em Yehudá" },
    { "id": "kg051", "order": 3, "text": "Yoash reforma o Templo, mas sua trajetória depende fortemente da orientação sacerdotal.", "text_he": null, "refs": ["II Kings 12:1-22"], "ref_start": "II Kings 12:1", "ref_end": "II Kings 12:22", "chapter": 12, "verse_start": 1, "verse_end": 22, "sefaria_ref": "II Kings 12:1-22", "tags": ["yoash", "reforma", "templo"], "topic": "Reforma do Templo" },
    { "id": "kg052", "order": 4, "text": "Elisha morre, e até após sua morte um sinal confirma a força de sua missão profética.", "text_he": null, "refs": ["II Kings 13:1-25"], "ref_start": "II Kings 13:1", "ref_end": "II Kings 13:25", "chapter": 13, "verse_start": 1, "verse_end": 25, "sefaria_ref": "II Kings 13:1-25", "tags": ["elisha", "morte", "profecia"], "topic": "Fim de Elisha" },
    { "id": "kg053", "order": 5, "text": "Amaziah de Yehudá e Yoash de Israel entram em conflito, revelando rivalidade entre os reinos.", "text_he": null, "refs": ["II Kings 14:1-22"], "ref_start": "II Kings 14:1", "ref_end": "II Kings 14:22", "chapter": 14, "verse_start": 1, "verse_end": 22, "sefaria_ref": "II Kings 14:1-22", "tags": ["amaziah", "yoash", "rivalidade"], "topic": "Conflito entre reinos" },
    { "id": "kg054", "order": 6, "text": "Yeravam II restaura fronteiras de Israel, mas o norte continua preso ao pecado estrutural.", "text_he": null, "refs": ["II Kings 14:23-29"], "ref_start": "II Kings 14:23", "ref_end": "II Kings 14:29", "chapter": 14, "verse_start": 23, "verse_end": 29, "sefaria_ref": "II Kings 14:23-29", "tags": ["yeravam-ii", "fronteiras", "israel"], "topic": "Expansão do norte" },
    { "id": "kg055", "order": 7, "text": "A sequência de reis em Israel e Yehudá mostra golpes, alianças e pressão assíria crescente.", "text_he": null, "refs": ["II Kings 15:1-16:20"], "ref_start": "II Kings 15:1", "ref_end": "II Kings 16:20", "chapter": 15, "verse_start": 1, "verse_end_chapter": 16, "verse_end": 20, "sefaria_ref": "II Kings 15:1-16:20", "tags": ["assíria", "golpes", "achaz"], "topic": "Pressão assíria" },
    { "id": "kg056", "order": 8, "text": "Shomron cai, Israel é exilado pela Assíria, e o texto explica a queda como infidelidade à aliança.", "text_he": null, "refs": ["II Kings 17:1-41"], "ref_start": "II Kings 17:1", "ref_end": "II Kings 17:41", "chapter": 17, "verse_start": 1, "verse_end": 41, "sefaria_ref": "II Kings 17:1-41", "tags": ["shomron", "assíria", "exílio"], "topic": "Exílio do reino do norte" }
  ]
