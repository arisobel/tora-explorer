  "identity": { "id": "judah-reform-exile", "label": "Yehudá: reformas, cerco e exílio", "label_pt": "Chizkiyahu, Menashe, Yoshiyahu, queda de Yerushalayim e exílio babilônico", "hebrew": null, "transliteration": "Judah Reform and Exile" },
  "range": { "ref_start": "II Kings 18:1", "ref_end": "II Kings 25:30", "sefaria_ref": "II Kings 18:1-25:30", "chapters_covered": [18,19,20,21,22,23,24,25], "chapter_start": 18, "chapter_end": 25, "verse_start": 1, "verse_end_chapter": 25, "verse_end": 30 },
  "timeline": { "period_name": "Yehudá até o exílio babilônico", "anno_mundi_start": 3205, "anno_mundi_end": 3339, "era": "neviim-rishonim", "position_pct": 80, "description": "O reino remanescente vive reformas marcantes, mas termina com cerco, destruição do Templo e exílio." },
  "summary": { "short": "Yehudá alterna fidelidade e queda até Bavel destruir o Templo e exilar a elite do povo.", "medium": "Chizkiyahu resiste à Assíria com confiança em Deus e recebe a intervenção profética de Yeshayahu. Menashe, em contraste, aprofunda a culpa de Yehudá.\n\nYoshiyahu reencontra o livro da Torá e lidera reforma profunda, mas a trajetória nacional já caminha para o exílio. Bavel conquista Yerushalayim, destrói o Templo e leva o povo ao exílio.", "characters_main": ["Chizkiyahu", "Yeshayahu", "Menashe", "Yoshiyahu", "Tzidkiyahu", "Nevuchadnetzar"], "characters_secondary": ["Ravshakeh", "Chuldah", "Yehoyakim", "Yehoyachin", "Gedalyahu"], "themes": ["Reforma", "Confiança", "Torá", "Destruição", "Exílio"] },
  "facts": [
    { "id": "kg057", "order": 1, "text": "Chizkiyahu remove altos, quebra símbolos idólatras e confia em Deus diante da Assíria.", "text_he": null, "refs": ["II Kings 18:1-16"], "ref_start": "II Kings 18:1", "ref_end": "II Kings 18:16", "chapter": 18, "verse_start": 1, "verse_end": 16, "sefaria_ref": "II Kings 18:1-16", "tags": ["chizkiyahu", "reforma", "assíria"], "topic": "Reforma de Chizkiyahu" },
    { "id": "kg058", "order": 2, "text": "Ravshakeh ameaça Yerushalayim, mas Yeshayahu anuncia salvação contra Sancheriv.", "text_he": null, "refs": ["II Kings 18:17-19:37"], "ref_start": "II Kings 18:17", "ref_end": "II Kings 19:37", "chapter": 18, "verse_start": 17, "verse_end_chapter": 19, "verse_end": 37, "sefaria_ref": "II Kings 18:17-19:37", "tags": ["sancheriv", "yeshayahu", "yerushalayim"], "topic": "Cerco assírio" },
    { "id": "kg059", "order": 3, "text": "Chizkiyahu adoece, ora, recebe extensão de vida e depois mostra tesouros a emissários de Bavel.", "text_he": null, "refs": ["II Kings 20:1-21"], "ref_start": "II Kings 20:1", "ref_end": "II Kings 20:21", "chapter": 20, "verse_start": 1, "verse_end": 21, "sefaria_ref": "II Kings 20:1-21", "tags": ["chizkiyahu", "bavel", "sinal"], "topic": "Doença e sinal" },
    { "id": "kg060", "order": 4, "text": "Menashe introduz idolatria severa em Yehudá, tornando inevitável o juízo sobre Yerushalayim.", "text_he": null, "refs": ["II Kings 21:1-18"], "ref_start": "II Kings 21:1", "ref_end": "II Kings 21:18", "chapter": 21, "verse_start": 1, "verse_end": 18, "sefaria_ref": "II Kings 21:1-18", "tags": ["menashe", "idolatria", "juízo"], "topic": "Pecado de Menashe" },
    { "id": "kg061", "order": 5, "text": "O livro da Torá é encontrado no Templo, e Chuldah confirma a seriedade da palavra divina.", "text_he": null, "refs": ["II Kings 22:1-20"], "ref_start": "II Kings 22:1", "ref_end": "II Kings 22:20", "chapter": 22, "verse_start": 1, "verse_end": 20, "sefaria_ref": "II Kings 22:1-20", "tags": ["yoshiyahu", "torá", "chuldah"], "topic": "Livro da Torá" },
    { "id": "kg062", "order": 6, "text": "Yoshiyahu renova a aliança, purifica o culto e celebra Pessach de forma marcante.", "text_he": null, "refs": ["II Kings 23:1-30"], "ref_start": "II Kings 23:1", "ref_end": "II Kings 23:30", "chapter": 23, "verse_start": 1, "verse_end": 30, "sefaria_ref": "II Kings 23:1-30", "tags": ["yoshiyahu", "pessach", "reforma"], "topic": "Reforma de Yoshiyahu" },
    { "id": "kg063", "order": 7, "text": "Yehoyakim e Yehoyachin ficam sob domínio babilônico, e o primeiro exílio leva elite e tesouros.", "text_he": null, "refs": ["II Kings 23:31-24:17"], "ref_start": "II Kings 23:31", "ref_end": "II Kings 24:17", "chapter": 23, "verse_start": 31, "verse_end_chapter": 24, "verse_end": 17, "sefaria_ref": "II Kings 23:31-24:17", "tags": ["bavel", "yehoyachin", "exílio"], "topic": "Domínio babilônico" },
    { "id": "kg064", "order": 8, "text": "Tzidkiyahu se rebela, Yerushalayim cai, o Templo é queimado e o livro termina com esperança mínima para Yehoyachin.", "text_he": null, "refs": ["II Kings 24:18-25:30"], "ref_start": "II Kings 24:18", "ref_end": "II Kings 25:30", "chapter": 24, "verse_start": 18, "verse_end_chapter": 25, "verse_end": 30, "sefaria_ref": "II Kings 24:18-25:30", "tags": ["tzidkiyahu", "destruição", "templo"], "topic": "Queda de Yerushalayim" }
  ]
