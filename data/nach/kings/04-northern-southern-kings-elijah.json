  "timeline": { "period_name": "Reinos divididos e Eliyahu", "anno_mundi_start": 2964, "anno_mundi_end": 3043, "era": "neviim-rishonim", "position_pct": 72, "description": "A monarquia dividida se degrada espiritualmente, e Eliyahu aparece como profeta de confronto e retorno." },
  "summary": { "short": "A narrativa alterna reis do norte e do sul até Eliyahu confrontar Baal no Monte Carmel.", "medium": "Depois da divisão, o norte estabelece culto rival e recebe denúncias proféticas. A sucessão de reis mostra instabilidade e idolatria crescente.\n\nCom Achav e Izevel, o culto a Baal se torna crise nacional. Eliyahu anuncia seca, é sustentado de modo milagroso e convoca Israel a escolher entre Deus e Baal.", "characters_main": ["Yeravam", "Asa", "Omri", "Achav", "Izevel", "Eliyahu"], "characters_secondary": ["Achiyah", "Ovadiah", "Viúva de Tzarfat", "Elisha"], "themes": ["Profecia", "Idolatria", "Baal", "Carmel", "Teshuvah"] },
  "facts": [
    { "id": "kg025", "order": 1, "text": "Um homem de Deus denuncia o altar de Beit-El, sinalizando oposição profética ao culto de Yeravam.", "text_he": null, "refs": ["I Kings 13:1-34"], "ref_start": "I Kings 13:1", "ref_end": "I Kings 13:34", "chapter": 13, "verse_start": 1, "verse_end": 34, "sefaria_ref": "I Kings 13:1-34", "tags": ["beit-el", "yeravam", "profecia"], "topic": "Denúncia em Beit-El" },
    { "id": "kg026", "order": 2, "text": "Achiyah anuncia juízo contra a casa de Yeravam, enquanto Yehudá também se corrompe.", "text_he": null, "refs": ["I Kings 14:1-31"], "ref_start": "I Kings 14:1", "ref_end": "I Kings 14:31", "chapter": 14, "verse_start": 1, "verse_end": 31, "sefaria_ref": "I Kings 14:1-31", "tags": ["achiyah", "juízo", "yeravam"], "topic": "Juízo sobre Yeravam" },
    { "id": "kg027", "order": 3, "text": "Os reinados de Asa em Yehudá e de reis sucessivos em Israel mostram caminhos contrastantes.", "text_he": null, "refs": ["I Kings 15:1-34"], "ref_start": "I Kings 15:1", "ref_end": "I Kings 15:34", "chapter": 15, "verse_start": 1, "verse_end": 34, "sefaria_ref": "I Kings 15:1-34", "tags": ["asa", "judá", "israel"], "topic": "Reis contrastantes" },
    { "id": "kg028", "order": 4, "text": "Omri funda uma dinastia forte, e Achav intensifica a idolatria com Izevel e Baal.", "text_he": null, "refs": ["I Kings 16:1-34"], "ref_start": "I Kings 16:1", "ref_end": "I Kings 16:34", "chapter": 16, "verse_start": 1, "verse_end": 34, "sefaria_ref": "I Kings 16:1-34", "tags": ["omri", "achav", "baal"], "topic": "Ascensão de Achav" },
    { "id": "kg029", "order": 5, "text": "Eliyahu anuncia seca e é sustentado junto ao riacho Kerit e pela viúva de Tzarfat.", "text_he": null, "refs": ["I Kings 17:1-16"], "ref_start": "I Kings 17:1", "ref_end": "I Kings 17:16", "chapter": 17, "verse_start": 1, "verse_end": 16, "sefaria_ref": "I Kings 17:1-16", "tags": ["eliyahu", "seca", "tzarfat"], "topic": "Seca e sustento" },
    { "id": "kg030", "order": 6, "text": "Eliyahu revive o filho da viúva, e ela reconhece a verdade da palavra divina em sua boca.", "text_he": null, "refs": ["I Kings 17:17-24"], "ref_start": "I Kings 17:17", "ref_end": "I Kings 17:24", "chapter": 17, "verse_start": 17, "verse_end": 24, "sefaria_ref": "I Kings 17:17-24", "tags": ["vida", "milagre", "profecia"], "topic": "Filho da viúva" },
    { "id": "kg031", "order": 7, "text": "No Carmel, Eliyahu confronta os profetas de Baal, e fogo do céu confirma Deus diante do povo.", "text_he": null, "refs": ["I Kings 18:1-40"], "ref_start": "I Kings 18:1", "ref_end": "I Kings 18:40", "chapter": 18, "verse_start": 1, "verse_end": 40, "sefaria_ref": "I Kings 18:1-40", "tags": ["carmel", "baal", "fogo"], "topic": "Desafio no Carmel" },
    { "id": "kg032", "order": 8, "text": "Eliyahu foge ao Chorev, encontra Deus em voz fina e unge continuidade profética em Elisha.", "text_he": null, "refs": ["I Kings 18:41-19:21"], "ref_start": "I Kings 18:41", "ref_end": "I Kings 19:21", "chapter": 18, "verse_start": 41, "verse_end_chapter": 19, "verse_end": 21, "sefaria_ref": "I Kings 18:41-19:21", "tags": ["chorev", "elisha", "continuidade"], "topic": "Chorev e Elisha" }
  ]
