  "identity": { "id": "northern-southern-kings-elijah", "label": "Reinos divididos e Eliyahu", "label_pt": "Profetas, reis de Yehudá e Israel, Achav, Izevel e o desafio no Carmel", "hebrew": null, "transliteration": "Divided Kingdoms and Elijah" },
