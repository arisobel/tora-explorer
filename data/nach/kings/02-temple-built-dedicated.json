  "identity": { "id": "temple-built-dedicated", "label": "Construção e dedicação do Templo", "label_pt": "Aliança com Chiram, construção, objetos sagrados e oração de dedicação", "hebrew": null, "transliteration": "Temple Built and Dedicated" },
  "range": { "ref_start": "I Kings 5:1", "ref_end": "I Kings 8:66", "sefaria_ref": "I Kings 5:1-8:66", "chapters_covered": [5,6,7,8], "chapter_start": 5, "chapter_end": 8, "verse_start": 1, "verse_end_chapter": 8, "verse_end": 66 },
  "timeline": { "period_name": "Construção do Primeiro Templo", "anno_mundi_start": 2928, "anno_mundi_end": 2935, "era": "neviim-rishonim", "position_pct": 69, "description": "O centro espiritual de Israel se fixa em Yerushalayim com a construção e dedicação do Beit HaMikdash." },
  "summary": { "short": "Shlomo constrói o Beit HaMikdash, instala a arca e dedica o Templo em oração nacional.", "medium": "A construção do Templo é apresentada como cumprimento do desejo de David e como marco de presença divina em Israel. A cooperação com Chiram fornece materiais e artesãos.\n\nA dedicação culmina com a arca no Santo dos Santos, a nuvem de glória e a oração de Shlomo, que transforma o Templo em eixo de oração, arrependimento e retorno.", "characters_main": ["Shlomo", "Chiram", "Kohanim", "Leviim"], "characters_secondary": ["Bnei Israel", "Anciãos de Israel"], "themes": ["Templo", "Arca", "Oração", "Aliança"] },
  "facts": [
    { "id": "kg009", "order": 1, "text": "Shlomo e Chiram de Tzor firmam cooperação para madeira, trabalho e construção.", "text_he": null, "refs": ["I Kings 5:1-18"], "ref_start": "I Kings 5:1", "ref_end": "I Kings 5:18", "chapter": 5, "verse_start": 1, "verse_end": 18, "sefaria_ref": "I Kings 5:1-18", "tags": ["chiram", "título", "construção"], "topic": "Preparação do Templo" },
    { "id": "kg010", "order": 2, "text": "A construção do Templo começa no quarto ano de Shlomo, 480 anos após a saída do Egito.", "text_he": null, "refs": ["I Kings 6:1"], "ref_start": "I Kings 6:1", "ref_end": "I Kings 6:1", "chapter": 6, "verse_start": 1, "verse_end": 1, "sefaria_ref": "I Kings 6:1", "tags": ["templo", "êxodo", "cronologia"], "topic": "Início da construção" },
    { "id": "kg011", "order": 3, "text": "O edifício do Templo é descrito com medidas, câmaras, revestimento e o Santo dos Santos.", "text_he": null, "refs": ["I Kings 6:2-38"], "ref_start": "I Kings 6:2", "ref_end": "I Kings 6:38", "chapter": 6, "verse_start": 2, "verse_end": 38, "sefaria_ref": "I Kings 6:2-38", "tags": ["santo-dos-santos", "arquitetura", "kedushah"], "topic": "Estrutura do Templo" },
    { "id": "kg012", "order": 4, "text": "Shlomo também constrói estruturas reais, mostrando a integração entre governo e centro cultual.", "text_he": null, "refs": ["I Kings 7:1-12"], "ref_start": "I Kings 7:1", "ref_end": "I Kings 7:12", "chapter": 7, "verse_start": 1, "verse_end": 12, "sefaria_ref": "I Kings 7:1-12", "tags": ["palácio", "governo", "jerusalém"], "topic": "Construções reais" },
    { "id": "kg013", "order": 5, "text": "Chiram, artesão de bronze, produz colunas, mar, bases e utensílios para o serviço.", "text_he": null, "refs": ["I Kings 7:13-51"], "ref_start": "I Kings 7:13", "ref_end": "I Kings 7:51", "chapter": 7, "verse_start": 13, "verse_end": 51, "sefaria_ref": "I Kings 7:13-51", "tags": ["utensílios", "bronze", "serviço"], "topic": "Utensílios sagrados" },
    { "id": "kg014", "order": 6, "text": "A arca é trazida para o Templo, e a nuvem enche a casa de Deus.", "text_he": null, "refs": ["I Kings 8:1-13"], "ref_start": "I Kings 8:1", "ref_end": "I Kings 8:13", "chapter": 8, "verse_start": 1, "verse_end": 13, "sefaria_ref": "I Kings 8:1-13", "tags": ["arca", "nuvem", "presença"], "topic": "Arca no Templo" },
    { "id": "kg015", "order": 7, "text": "Shlomo ora para que o Templo seja foco de escuta, perdão, justiça e retorno.", "text_he": null, "refs": ["I Kings 8:22-53"], "ref_start": "I Kings 8:22", "ref_end": "I Kings 8:53", "chapter": 8, "verse_start": 22, "verse_end": 53, "sefaria_ref": "I Kings 8:22-53", "tags": ["oração", "teshuvah", "perdão"], "topic": "Oração de dedicação" },
    { "id": "kg016", "order": 8, "text": "A dedicação termina com bênção, sacrifícios e festa nacional diante de Deus.", "text_he": null, "refs": ["I Kings 8:54-66"], "ref_start": "I Kings 8:54", "ref_end": "I Kings 8:66", "chapter": 8, "verse_start": 54, "verse_end": 66, "sefaria_ref": "I Kings 8:54-66", "tags": ["dedicação", "festa", "sacrifícios"], "topic": "Celebração nacional" }
  ]
}
