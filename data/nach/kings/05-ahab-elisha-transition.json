  "identity": { "id": "ahab-elisha-transition", "label": "Achav, queda e transição para Elisha", "label_pt": "Guerras de Achav, vinha de Navot, morte de Achav e ascensão de Elisha", "hebrew": null, "transliteration": "Ahab and Elisha Transition" },
