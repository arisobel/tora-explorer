  "timeline": { "period_name": "Achav e transição profética", "anno_mundi_start": 3043, "anno_mundi_end": 3053, "era": "neviim-rishonim", "position_pct": 74, "description": "A queda da casa de Achav começa enquanto a missão profética passa de Eliyahu para Elisha." },
  "summary": { "short": "A casa de Achav é julgada, Eliyahu sobe em tempestade e Elisha recebe continuidade profética.", "medium": "Achav vence Aram, mas sua desobediência e a injustiça contra Navot revelam decadência moral. A palavra profética anuncia julgamento sobre sua casa.\n\nApós a morte de Achav, Achazyahu repete padrões de idolatria. Eliyahu é levado em tempestade, e Elisha recebe seu manto como sucessor profético.", "characters_main": ["Achav", "Izevel", "Navot", "Eliyahu", "Elisha"], "characters_secondary": ["Ben-Hadad", "Micaiah", "Yehoshafat", "Achazyahu"], "themes": ["Justiça", "Profecia", "Violência", "Sucessão profética"] },
  "facts": [
    { "id": "kg033", "order": 1, "text": "Achav vence Ben-Hadad, mas poupa o rei inimigo contra a palavra profética.", "text_he": null, "refs": ["I Kings 20:1-43"], "ref_start": "I Kings 20:1", "ref_end": "I Kings 20:43", "chapter": 20, "verse_start": 1, "verse_end": 43, "sefaria_ref": "I Kings 20:1-43", "tags": ["achav", "aram", "profecia"], "topic": "Guerras contra Aram" },
    { "id": "kg034", "order": 2, "text": "Izevel arma a morte de Navot para tomar sua vinha, expondo abuso real de poder.", "text_he": null, "refs": ["I Kings 21:1-16"], "ref_start": "I Kings 21:1", "ref_end": "I Kings 21:16", "chapter": 21, "verse_start": 1, "verse_end": 16, "sefaria_ref": "I Kings 21:1-16", "tags": ["navot", "izevel", "injustiça"], "topic": "Vinha de Navot" },
    { "id": "kg035", "order": 3, "text": "Eliyahu confronta Achav e anuncia juízo sobre sua casa por causa de Navot.", "text_he": null, "refs": ["I Kings 21:17-29"], "ref_start": "I Kings 21:17", "ref_end": "I Kings 21:29", "chapter": 21, "verse_start": 17, "verse_end": 29, "sefaria_ref": "I Kings 21:17-29", "tags": ["eliyahu", "juízo", "teshuvah"], "topic": "Juízo sobre Achav" },
    { "id": "kg036", "order": 4, "text": "Micaiah ben Imlah profetiza derrota, contrariando profetas favoráveis ao rei.", "text_he": null, "refs": ["I Kings 22:1-28"], "ref_start": "I Kings 22:1", "ref_end": "I Kings 22:28", "chapter": 22, "verse_start": 1, "verse_end": 28, "sefaria_ref": "I Kings 22:1-28", "tags": ["micaiah", "verdade", "profecia"], "topic": "Micaiah contra o consenso" },
    { "id": "kg037", "order": 5, "text": "Achav morre em Ramot-Gilad, cumprindo a palavra profética apesar de seu disfarce.", "text_he": null, "refs": ["I Kings 22:29-40"], "ref_start": "I Kings 22:29", "ref_end": "I Kings 22:40", "chapter": 22, "verse_start": 29, "verse_end": 40, "sefaria_ref": "I Kings 22:29-40", "tags": ["achav", "morte", "cumprimento"], "topic": "Morte de Achav" },
    { "id": "kg038", "order": 6, "text": "Achazyahu busca Baal-Zevuv, e Eliyahu denuncia sua infidelidade.", "text_he": null, "refs": ["II Kings 1:1-18"], "ref_start": "II Kings 1:1", "ref_end": "II Kings 1:18", "chapter": 1, "verse_start": 1, "verse_end": 18, "sefaria_ref": "II Kings 1:1-18", "tags": ["achazyahu", "baal-zevuv", "eliyahu"], "topic": "Achazyahu e Baal-Zevuv" },
    { "id": "kg039", "order": 7, "text": "Eliyahu é levado em tempestade, e Elisha recebe porção dobrada de seu espírito.", "text_he": null, "refs": ["II Kings 2:1-18"], "ref_start": "II Kings 2:1", "ref_end": "II Kings 2:18", "chapter": 2, "verse_start": 1, "verse_end": 18, "sefaria_ref": "II Kings 2:1-18", "tags": ["eliyahu", "elisha", "manto"], "topic": "Transição para Elisha" },
    { "id": "kg040", "order": 8, "text": "Elisha cura águas em Yericho e sua autoridade profética é reconhecida.", "text_he": null, "refs": ["II Kings 2:19-25"], "ref_start": "II Kings 2:19", "ref_end": "II Kings 2:25", "chapter": 2, "verse_start": 19, "verse_end": 25, "sefaria_ref": "II Kings 2:19-25", "tags": ["elisha", "yericho", "autoridade"], "topic": "Primeiros sinais de Elisha" }
