  "identity": { "id": "abimelech-minor-judges-jephthah", "label": "Avimelech, juízes menores e Yiftach", "label_pt": "Violência interna, crise com Amon e voto de Yiftach", "hebrew": null, "transliteration": "Abimelech, Minor Judges and Jephthah" },
