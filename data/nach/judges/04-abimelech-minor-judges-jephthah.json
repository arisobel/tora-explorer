  "timeline": { "period_name": "Crise de poder e Yiftach", "anno_mundi_start": 2710, "anno_mundi_end": 2810, "era": "neviim-rishonim", "position_pct": 49, "description": "Avimelech antecipa a crise da realeza sem aliança, e Yiftach liberta Israel com tragédia familiar e conflito tribal." },
  "summary": { "short": "Avimelech mostra a corrupção do poder, e Yiftach liberta Israel com consequências trágicas.", "medium": "Após Gidon, Avimelech tenta transformar prestígio familiar em poder violento. O resultado é fratricídio, governo instável e destruição mútua em Shechem.\n\nDepois de juízes menores, a opressão de Amon leva Israel a chamar Yiftach, um líder marginalizado. Ele vence Amon, mas seu voto precipitado e a guerra contra Efraim mostram a deterioração moral do período.", "characters_main": ["Avimelech", "Yotam", "Tola", "Yair", "Yiftach", "Bnei Amon", "Efraim"], "characters_secondary": ["Gaal", "Filha de Yiftach", "Ibzan", "Elon", "Avdon"], "themes": ["Poder", "Fratricídio", "Voto", "Amon", "Guerra civil"] },
  "facts": [
    { "id": "jd025", "order": 1, "text": "Avimelech persuade Shechem a apoiá-lo e mata seus irmãos, exceto Yotam.", "text_he": null, "refs": ["Judges 9:1-6"], "ref_start": "Judges 9:1", "ref_end": "Judges 9:6", "chapter": 9, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Judges 9:1-6", "tags": ["avimelech", "shechem", "fratricídio"], "topic": "Ascensão de Avimelech" },
    { "id": "jd026", "order": 2, "text": "Yotam proclama a parábola das árvores, denunciando a escolha de Avimelech como arbusto espinhoso.", "text_he": null, "refs": ["Judges 9:7-21"], "ref_start": "Judges 9:7", "ref_end": "Judges 9:21", "chapter": 9, "verse_start": 7, "verse_end": 21, "sefaria_ref": "Judges 9:7-21", "tags": ["yotam", "parábola", "árvores"], "topic": "Parábola de Yotam" },
    { "id": "jd027", "order": 3, "text": "Shechem se volta contra Avimelech, e a violência termina com destruição mútua.", "text_he": null, "refs": ["Judges 9:22-57"], "ref_start": "Judges 9:22", "ref_end": "Judges 9:57", "chapter": 9, "verse_start": 22, "verse_end": 57, "sefaria_ref": "Judges 9:22-57", "tags": ["shechem", "violência", "julgamento"], "topic": "Queda de Avimelech" },
    { "id": "jd028", "order": 4, "text": "Tola e Yair julgam Israel, funcionando como transição entre crises maiores.", "text_he": null, "refs": ["Judges 10:1-5"], "ref_start": "Judges 10:1", "ref_end": "Judges 10:5", "chapter": 10, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Judges 10:1-5", "tags": ["tola", "yair", "juízes-menores"], "topic": "Tola e Yair" },
    { "id": "jd029", "order": 5, "text": "Israel serve muitos deuses, sofre opressão de Amon e Pelishtim, e clama a Deus.", "text_he": null, "refs": ["Judges 10:6-18"], "ref_start": "Judges 10:6", "ref_end": "Judges 10:18", "chapter": 10, "verse_start": 6, "verse_end": 18, "sefaria_ref": "Judges 10:6-18", "tags": ["amon", "pelishtim", "clamor"], "topic": "Opressão de Amon" },
    { "id": "jd030", "order": 6, "text": "Yiftach, filho rejeitado, é chamado pelos anciãos de Gilad para liderar contra Amon.", "text_he": null, "refs": ["Judges 11:1-11"], "ref_start": "Judges 11:1", "ref_end": "Judges 11:11", "chapter": 11, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Judges 11:1-11", "tags": ["yiftach", "gilad", "liderança"], "topic": "Chamado de Yiftach" },
    { "id": "jd031", "order": 7, "text": "Yiftach argumenta historicamente com Amon e depois vence a guerra, mas faz um voto trágico.", "text_he": null, "refs": ["Judges 11:12-40"], "ref_start": "Judges 11:12", "ref_end": "Judges 11:40", "chapter": 11, "verse_start": 12, "verse_end": 40, "sefaria_ref": "Judges 11:12-40", "tags": ["amon", "voto", "filha-de-yiftach"], "topic": "Vitória e voto de Yiftach" },
    { "id": "jd032", "order": 8, "text": "Efraim confronta Yiftach, a guerra civil explode, e depois aparecem Ibzan, Elon e Avdon.", "text_he": null, "refs": ["Judges 12:1-15"], "ref_start": "Judges 12:1", "ref_end": "Judges 12:15", "chapter": 12, "verse_start": 1, "verse_end": 15, "sefaria_ref": "Judges 12:1-15", "tags": ["efraim", "shibolet", "juízes-menores"], "topic": "Conflito com Efraim" }
