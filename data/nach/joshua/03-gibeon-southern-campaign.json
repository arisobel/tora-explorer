  "timeline": { "period_name": "Givon e coalizão do sul", "anno_mundi_start": 2488, "anno_mundi_end": 2489, "era": "entrada-terra", "position_pct": 43, "description": "A diplomacia enganosa de Givon e a guerra contra reis do sul ampliam a presença de Israel na terra." },
  "summary": { "short": "Givon engana Israel, cinco reis atacam, e Yehoshua vence a campanha do sul.", "medium": "Depois de Jericó e Ai, os povos da terra reagem. Givon escolhe astúcia em vez de guerra, obtendo uma aliança por engano porque Israel não consulta Deus.\n\nQuando cinco reis amorreus atacam Givon, Yehoshua sobe para defendê-los. A campanha do sul inclui uma intervenção extraordinária no céu e uma sequência de vitórias sobre cidades estratégicas.", "characters_main": ["Yehoshua", "Givonim", "Adoni-Tzedek", "Bnei Israel"], "characters_secondary": ["Cinco reis", "Cohanim", "Homens de Givon"], "themes": ["Givon", "Aliança", "Consulta a Deus", "Campanha sul", "Milagre cósmico"] },
  "facts": [
    { "id": "js017", "order": 1, "text": "Os povos da terra ouvem as vitórias de Israel e começam a se organizar contra Yehoshua.", "text_he": null, "refs": ["Joshua 9:1-2"], "ref_start": "Joshua 9:1", "ref_end": "Joshua 9:2", "chapter": 9, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Joshua 9:1-2", "tags": ["coalizão", "povos", "conquista"], "topic": "Reação dos povos" },
    { "id": "js018", "order": 2, "text": "Os moradores de Givon fingem vir de terra distante para fazer aliança com Israel.", "text_he": null, "refs": ["Joshua 9:3-13"], "ref_start": "Joshua 9:3", "ref_end": "Joshua 9:13", "chapter": 9, "verse_start": 3, "verse_end": 13, "sefaria_ref": "Joshua 9:3-13", "tags": ["givon", "engano", "aliança"], "topic": "Estratégia de Givon" },
    { "id": "js019", "order": 3, "text": "Israel aceita o acordo sem consultar Deus, e depois descobre que Givon era vizinha.", "text_he": null, "refs": ["Joshua 9:14-21"], "ref_start": "Joshua 9:14", "ref_end": "Joshua 9:21", "chapter": 9, "verse_start": 14, "verse_end": 21, "sefaria_ref": "Joshua 9:14-21", "tags": ["consulta", "juramento", "erro"], "topic": "Aliança sem consulta" },
    { "id": "js020", "order": 4, "text": "Givon é poupada por causa do juramento, mas recebe serviço ligado a lenha e água para o altar.", "text_he": null, "refs": ["Joshua 9:22-27"], "ref_start": "Joshua 9:22", "ref_end": "Joshua 9:27", "chapter": 9, "verse_start": 22, "verse_end": 27, "sefaria_ref": "Joshua 9:22-27", "tags": ["juramento", "altar", "serviço"], "topic": "Destino dos givonitas" },
    { "id": "js021", "order": 5, "text": "Cinco reis amorreus atacam Givon por sua aliança com Israel.", "text_he": null, "refs": ["Joshua 10:1-5"], "ref_start": "Joshua 10:1", "ref_end": "Joshua 10:5", "chapter": 10, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Joshua 10:1-5", "tags": ["amorreus", "givon", "cinco-reis"], "topic": "Ataque contra Givon" },
    { "id": "js022", "order": 6, "text": "Yehoshua marcha de Gilgal, Deus lança confusão nos inimigos e grandes pedras caem do céu.", "text_he": null, "refs": ["Joshua 10:6-11"], "ref_start": "Joshua 10:6", "ref_end": "Joshua 10:11", "chapter": 10, "verse_start": 6, "verse_end": 11, "sefaria_ref": "Joshua 10:6-11", "tags": ["gilgal", "granizo", "guerra"], "topic": "Socorro a Givon" },
    { "id": "js023", "order": 7, "text": "Yehoshua pede que sol e lua parem, prolongando o dia da batalha.", "text_he": null, "refs": ["Joshua 10:12-15"], "ref_start": "Joshua 10:12", "ref_end": "Joshua 10:15", "chapter": 10, "verse_start": 12, "verse_end": 15, "sefaria_ref": "Joshua 10:12-15", "tags": ["sol", "lua", "milagre"], "topic": "Sol em Givon" },
