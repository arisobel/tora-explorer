  "summary": { "short": "A coalizão do norte é derrotada e o livro lista os reis vencidos por Moshe e Yehoshua.", "medium": "A campanha do norte apresenta uma coalizão poderosa liderada por Yavin de Chatzor. Deus orienta Yehoshua a não temer, e Israel vence no norte como havia vencido no sul.\n\nO texto resume a extensão da conquista, destaca que Yehoshua cumpriu a ordem recebida por Moshe e lista reis derrotados em ambos os lados do Jordão.", "characters_main": ["Yehoshua", "Yavin", "Moshe", "Bnei Israel"], "characters_secondary": ["Reis do norte", "Anakim", "Sichon", "Og"], "themes": ["Campanha norte", "Chatzor", "Cumprimento", "Reis derrotados", "Herança"] },
  "facts": [
    { "id": "js025", "order": 1, "text": "Yavin de Chatzor reúne uma grande coalizão de reis do norte contra Israel.", "text_he": null, "refs": ["Joshua 11:1-5"], "ref_start": "Joshua 11:1", "ref_end": "Joshua 11:5", "chapter": 11, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Joshua 11:1-5", "tags": ["yavin", "chatzor", "coalizão"], "topic": "Coalizão do norte" },
    { "id": "js026", "order": 2, "text": "Deus encoraja Yehoshua a não temer e promete entregar os inimigos.", "text_he": null, "refs": ["Joshua 11:6"], "ref_start": "Joshua 11:6", "ref_end": "Joshua 11:6", "chapter": 11, "verse_start": 6, "verse_end": 6, "sefaria_ref": "Joshua 11:6", "tags": ["coragem", "promessa", "guerra"], "topic": "Não temas" },
    { "id": "js027", "order": 3, "text": "Yehoshua ataca de surpresa nas águas de Merom e derrota a coalizão.", "text_he": null, "refs": ["Joshua 11:7-9"], "ref_start": "Joshua 11:7", "ref_end": "Joshua 11:9", "chapter": 11, "verse_start": 7, "verse_end": 9, "sefaria_ref": "Joshua 11:7-9", "tags": ["merom", "ataque", "vitória"], "topic": "Águas de Merom" },
    { "id": "js028", "order": 4, "text": "Chatzor é queimada por ser cabeça dos reinos, enquanto outras cidades são tomadas.", "text_he": null, "refs": ["Joshua 11:10-15"], "ref_start": "Joshua 11:10", "ref_end": "Joshua 11:15", "chapter": 11, "verse_start": 10, "verse_end": 15, "sefaria_ref": "Joshua 11:10-15", "tags": ["chatzor", "cidade", "moshe"], "topic": "Queda de Chatzor" },
    { "id": "js029", "order": 5, "text": "Yehoshua toma as regiões principais da terra e remove os anakim de suas cidades.", "text_he": null, "refs": ["Joshua 11:16-23"], "ref_start": "Joshua 11:16", "ref_end": "Joshua 11:23", "chapter": 11, "verse_start": 16, "verse_end": 23, "sefaria_ref": "Joshua 11:16-23", "tags": ["anakim", "regiões", "terra"], "topic": "Resumo da conquista" },
    { "id": "js030", "order": 6, "text": "O texto relembra os reis que Moshe derrotou a leste do Jordão.", "text_he": null, "refs": ["Joshua 12:1-6"], "ref_start": "Joshua 12:1", "ref_end": "Joshua 12:6", "chapter": 12, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Joshua 12:1-6", "tags": ["moshe", "sichon", "og"], "topic": "Reis vencidos por Moshe" },
    { "id": "js031", "order": 7, "text": "São listados os reis derrotados por Yehoshua a oeste do Jordão.", "text_he": null, "refs": ["Joshua 12:7-24"], "ref_start": "Joshua 12:7", "ref_end": "Joshua 12:24", "chapter": 12, "verse_start": 7, "verse_end": 24, "sefaria_ref": "Joshua 12:7-24", "tags": ["reis", "jordão", "yehoshua"], "topic": "Reis vencidos por Yehoshua" },
    { "id": "js032", "order": 8, "text": "A lista de trinta e um reis funciona como marco entre a conquista militar e a divisão da herança.", "text_he": null, "refs": ["Joshua 12:24"], "ref_start": "Joshua 12:24", "ref_end": "Joshua 12:24", "chapter": 12, "verse_start": 24, "verse_end": 24, "sefaria_ref": "Joshua 12:24", "tags": ["trinta-e-um-reis", "herança", "transição"], "topic": "Marco da conquista" }
