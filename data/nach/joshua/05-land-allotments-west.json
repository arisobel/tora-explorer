  "timeline": { "period_name": "Início da divisão territorial", "anno_mundi_start": 2495, "anno_mundi_end": 2502, "era": "entrada-terra", "position_pct": 43, "description": "A terra passa da conquista à herança, com lotes tribais e cumprimento de promessas pessoais." },
  "summary": { "short": "A terra começa a ser distribuída entre as tribos, incluindo Calev e as filhas de Tzelofchad.", "medium": "Depois das campanhas, Josué já está idoso e ainda resta terra a possuir. O foco se desloca da guerra para a herança, começando pelas terras a leste e pelos primeiros lotes a oeste.\n\nCalev recebe Chevron por sua fidelidade desde os espiões. Yehudah, Efraim e Menashe recebem porções, e as filhas de Tzelofchad reaparecem como marco de justiça hereditária.", "characters_main": ["Yehoshua", "Elazar", "Calev", "Bnot Tzelofchad", "Yehudah", "Yosef"], "characters_secondary": ["Reuven", "Gad", "Menashe", "Otniel", "Achsah"], "themes": ["Herança", "Calev", "Terras tribais", "Tzelofchad", "Yehudah e Yosef"] },
  "facts": [
    { "id": "js033", "order": 1, "text": "Deus diz a Yehoshua que ele envelheceu e que ainda resta muita terra a ser possuída.", "text_he": null, "refs": ["Joshua 13:1-7"], "ref_start": "Joshua 13:1", "ref_end": "Joshua 13:7", "chapter": 13, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Joshua 13:1-7", "tags": ["terra", "velhice", "missão-incompleta"], "topic": "Terra ainda restante" },
    { "id": "js034", "order": 2, "text": "As heranças de Reuven, Gad e meia tribo de Menashe a leste do Jordão são recapituladas.", "text_he": null, "refs": ["Joshua 13:8-33"], "ref_start": "Joshua 13:8", "ref_end": "Joshua 13:33", "chapter": 13, "verse_start": 8, "verse_end": 33, "sefaria_ref": "Joshua 13:8-33", "tags": ["reuven", "gad", "menashe", "jordão"], "topic": "Herança a leste" },
    { "id": "js035", "order": 3, "text": "Elazar, Yehoshua e os chefes tribais iniciam a distribuição da terra por sorteio.", "text_he": null, "refs": ["Joshua 14:1-5"], "ref_start": "Joshua 14:1", "ref_end": "Joshua 14:5", "chapter": 14, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Joshua 14:1-5", "tags": ["elazar", "sorteio", "herança"], "topic": "Distribuição por sorteio" },
    { "id": "js036", "order": 4, "text": "Calev reivindica Chevron, lembrando sua fidelidade quando foi enviado como espião.", "text_he": null, "refs": ["Joshua 14:6-15"], "ref_start": "Joshua 14:6", "ref_end": "Joshua 14:15", "chapter": 14, "verse_start": 6, "verse_end": 15, "sefaria_ref": "Joshua 14:6-15", "tags": ["calev", "chevron", "espiões"], "topic": "Herança de Calev" },
    { "id": "js037", "order": 5, "text": "O território de Yehudah é delimitado com fronteiras, cidades e regiões.", "text_he": null, "refs": ["Joshua 15:1-63"], "ref_start": "Joshua 15:1", "ref_end": "Joshua 15:63", "chapter": 15, "verse_start": 1, "verse_end": 63, "sefaria_ref": "Joshua 15:1-63", "tags": ["yehudah", "fronteiras", "cidades"], "topic": "Território de Yehudah" },
    { "id": "js038", "order": 6, "text": "Otniel conquista Kiryat-Sefer e Achsah pede fontes de água, mostrando a herança em nível familiar.", "text_he": null, "refs": ["Joshua 15:13-19"], "ref_start": "Joshua 15:13", "ref_end": "Joshua 15:19", "chapter": 15, "verse_start": 13, "verse_end": 19, "sefaria_ref": "Joshua 15:13-19", "tags": ["otniel", "achsah", "água"], "topic": "Otniel e Achsah" },
    { "id": "js039", "order": 7, "text": "Efraim e Menashe recebem territórios ligados à casa de Yosef.", "text_he": null, "refs": ["Joshua 16:1-10"], "ref_start": "Joshua 16:1", "ref_end": "Joshua 16:10", "chapter": 16, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Joshua 16:1-10", "tags": ["efraim", "menashe", "yosef"], "topic": "Casa de Yosef" },
    { "id": "js040", "order": 8, "text": "As filhas de Tzelofchad recebem herança entre os filhos de Menashe, e a casa de Yosef pede mais espaço.", "text_he": null, "refs": ["Joshua 17:1-18"], "ref_start": "Joshua 17:1", "ref_end": "Joshua 17:18", "chapter": 17, "verse_start": 1, "verse_end": 18, "sefaria_ref": "Joshua 17:1-18", "tags": ["bnot-tzelofchad", "menashe", "herança"], "topic": "Tzelofchad e expansão" }
