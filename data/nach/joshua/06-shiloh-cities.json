  "timeline": { "period_name": "Shiloh e conclusão da distribuição", "anno_mundi_start": 2502, "anno_mundi_end": 2510, "era": "entrada-terra", "position_pct": 43, "description": "O Mishkan é estabelecido em Shiloh e a distribuição territorial chega às cidades de refúgio e levíticas." },
  "summary": { "short": "O Mishkan é estabelecido em Shiloh e a distribuição territorial se completa.", "medium": "Com a Tenda do Encontro em Shiloh, a vida nacional ganha um centro de culto dentro da terra. As tribos restantes são convocadas a mapear e receber suas porções.\n\nO bloco conclui com cidades de refúgio e cidades levíticas, mostrando que a herança não é apenas espaço tribal, mas também justiça, presença levítica e cumprimento das promessas.", "characters_main": ["Yehoshua", "Elazar", "Leviim", "Bnei Israel"], "characters_secondary": ["Binyamin", "Shimon", "Zevulun", "Yissachar", "Asher", "Naftali", "Dan"], "themes": ["Shiloh", "Herança", "Cidades de refúgio", "Leviim", "Cumprimento"] },
  "facts": [
    { "id": "js041", "order": 1, "text": "A congregação se reúne em Shiloh e estabelece ali a Tenda do Encontro.", "text_he": null, "refs": ["Joshua 18:1"], "ref_start": "Joshua 18:1", "ref_end": "Joshua 18:1", "chapter": 18, "verse_start": 1, "verse_end": 1, "sefaria_ref": "Joshua 18:1", "tags": ["shiloh", "mishkan", "assembleia"], "topic": "Mishkan em Shiloh" },
    { "id": "js042", "order": 2, "text": "Yehoshua repreende as sete tribos que ainda não haviam tomado sua herança.", "text_he": null, "refs": ["Joshua 18:2-10"], "ref_start": "Joshua 18:2", "ref_end": "Joshua 18:10", "chapter": 18, "verse_start": 2, "verse_end": 10, "sefaria_ref": "Joshua 18:2-10", "tags": ["sete-tribos", "herança", "mapa"], "topic": "Sete tribos restantes" },
    { "id": "js043", "order": 3, "text": "Binyamin recebe sua porção entre Yehudah e Yosef.", "text_he": null, "refs": ["Joshua 18:11-28"], "ref_start": "Joshua 18:11", "ref_end": "Joshua 18:28", "chapter": 18, "verse_start": 11, "verse_end": 28, "sefaria_ref": "Joshua 18:11-28", "tags": ["binyamin", "herança", "fronteiras"], "topic": "Porção de Binyamin" },
    { "id": "js044", "order": 4, "text": "Shimon, Zevulun, Yissachar, Asher, Naftali e Dan recebem suas heranças.", "text_he": null, "refs": ["Joshua 19:1-48"], "ref_start": "Joshua 19:1", "ref_end": "Joshua 19:48", "chapter": 19, "verse_start": 1, "verse_end": 48, "sefaria_ref": "Joshua 19:1-48", "tags": ["tribos", "sorteio", "herança"], "topic": "Demais porções tribais" },
    { "id": "js045", "order": 5, "text": "Yehoshua recebe Timnat-Serach como herança, encerrando a distribuição principal.", "text_he": null, "refs": ["Joshua 19:49-51"], "ref_start": "Joshua 19:49", "ref_end": "Joshua 19:51", "chapter": 19, "verse_start": 49, "verse_end": 51, "sefaria_ref": "Joshua 19:49-51", "tags": ["yehoshua", "timnat-serach", "conclusão"], "topic": "Herança de Yehoshua" },
    { "id": "js046", "order": 6, "text": "As cidades de refúgio são designadas para proteger quem matou sem intenção até julgamento.", "text_he": null, "refs": ["Joshua 20:1-9"], "ref_start": "Joshua 20:1", "ref_end": "Joshua 20:9", "chapter": 20, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Joshua 20:1-9", "tags": ["cidades-de-refúgio", "justiça", "homicídio"], "topic": "Cidades de refúgio" },
    { "id": "js047", "order": 7, "text": "Os levitas recebem cidades entre as tribos, incluindo cidades para as famílias de Kehat, Gershon e Merari.", "text_he": null, "refs": ["Joshua 21:1-42"], "ref_start": "Joshua 21:1", "ref_end": "Joshua 21:42", "chapter": 21, "verse_start": 1, "verse_end": 42, "sefaria_ref": "Joshua 21:1-42", "tags": ["leviim", "kehat", "gershon", "merari"], "topic": "Cidades levíticas" },
