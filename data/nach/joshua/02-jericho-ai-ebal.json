  "timeline": { "period_name": "Primeiras batalhas e responsabilidade coletiva", "anno_mundi_start": 2488, "anno_mundi_end": 2488, "era": "entrada-terra", "position_pct": 43, "description": "Jericó cai por ordem divina, mas Ai revela que a conquista depende de santidade comunitária." },
  "summary": { "short": "Jericó cai, o pecado de Achan causa derrota em Ai, e a Torá é lida em Eival e Gerizim.", "medium": "A primeira conquista mostra que a terra não é tomada apenas por força militar. Jericó cai através de uma liturgia de obediência, enquanto Rahav e sua família são preservadas.\n\nA derrota em Ai expõe o pecado de Achan e a responsabilidade coletiva. Depois da vitória, Yehoshua constrói um altar no monte Eival e lê a Torá diante de todo Israel.", "characters_main": ["Yehoshua", "Rahav", "Achan", "Bnei Israel"], "characters_secondary": ["Cohanim", "Homens de Ai", "Leviim"], "themes": ["Jericó", "Responsabilidade", "Achan", "Ai", "Eival e Gerizim"] },
  "facts": [
    { "id": "js009", "order": 1, "text": "Jericó é fechada diante de Israel, e Deus entrega a cidade a Yehoshua.", "text_he": null, "refs": ["Joshua 6:1-5"], "ref_start": "Joshua 6:1", "ref_end": "Joshua 6:5", "chapter": 6, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Joshua 6:1-5", "tags": ["jericó", "conquista", "ordem-divina"], "topic": "Jericó entregue" },
    { "id": "js010", "order": 2, "text": "Israel marcha ao redor da cidade com a arca, cohanim e shofarot durante sete dias.", "text_he": null, "refs": ["Joshua 6:6-16"], "ref_start": "Joshua 6:6", "ref_end": "Joshua 6:16", "chapter": 6, "verse_start": 6, "verse_end": 16, "sefaria_ref": "Joshua 6:6-16", "tags": ["arca", "shofar", "sete-dias"], "topic": "Marchas ao redor da cidade" },
    { "id": "js011", "order": 3, "text": "As muralhas de Jericó caem, a cidade é consagrada à destruição, e Rahav é salva com sua família.", "text_he": null, "refs": ["Joshua 6:17-27"], "ref_start": "Joshua 6:17", "ref_end": "Joshua 6:27", "chapter": 6, "verse_start": 17, "verse_end": 27, "sefaria_ref": "Joshua 6:17-27", "tags": ["muralhas", "rahav", "cherem"], "topic": "Queda de Jericó" },
    { "id": "js012", "order": 4, "text": "Achan toma do cherem, e Israel sofre derrota inesperada diante de Ai.", "text_he": null, "refs": ["Joshua 7:1-9"], "ref_start": "Joshua 7:1", "ref_end": "Joshua 7:9", "chapter": 7, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Joshua 7:1-9", "tags": ["achan", "cherem", "ai"], "topic": "Pecado oculto e derrota" },
    { "id": "js013", "order": 5, "text": "Deus revela que a derrota veio por violação da aliança, e Achan é identificado por etapas.", "text_he": null, "refs": ["Joshua 7:10-23"], "ref_start": "Joshua 7:10", "ref_end": "Joshua 7:23", "chapter": 7, "verse_start": 10, "verse_end": 23, "sefaria_ref": "Joshua 7:10-23", "tags": ["aliança", "responsabilidade", "sorteio"], "topic": "Achan identificado" },
    { "id": "js014", "order": 6, "text": "Achan é julgado no vale de Achor, removendo a ira que recaía sobre Israel.", "text_he": null, "refs": ["Joshua 7:24-26"], "ref_start": "Joshua 7:24", "ref_end": "Joshua 7:26", "chapter": 7, "verse_start": 24, "verse_end": 26, "sefaria_ref": "Joshua 7:24-26", "tags": ["achor", "julgamento", "purificação"], "topic": "Julgamento de Achan" },
    { "id": "js015", "order": 7, "text": "Yehoshua arma emboscada e conquista Ai, transformando a derrota anterior em vitória ordenada.", "text_he": null, "refs": ["Joshua 8:1-29"], "ref_start": "Joshua 8:1", "ref_end": "Joshua 8:29", "chapter": 8, "verse_start": 1, "verse_end": 29, "sefaria_ref": "Joshua 8:1-29", "tags": ["ai", "emboscada", "vitória"], "topic": "Conquista de Ai" },
    { "id": "js016", "order": 8, "text": "Yehoshua constrói altar no monte Eival, escreve a Torá em pedras e lê bênçãos e maldições diante de Israel.", "text_he": null, "refs": ["Joshua 8:30-35"], "ref_start": "Joshua 8:30", "ref_end": "Joshua 8:35", "chapter": 8, "verse_start": 30, "verse_end": 35, "sefaria_ref": "Joshua 8:30-35", "tags": ["eival", "gerizim", "torá"], "topic": "Torá em Eival" }
