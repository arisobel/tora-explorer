  "facts": [
    { "id": "tzv001", "order": 1, "text": "A torat ha-olah determina que o fogo do altar permaneça aceso continuamente e que as cinzas sejam retiradas com vestes sacerdotais.", "text_he": null, "refs": ["Leviticus 6:1-6"], "ref_start": "Leviticus 6:1", "ref_end": "Leviticus 6:6", "chapter": 6, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Leviticus 6:1-6", "day_of_creation": null, "tags": ["olah", "altar", "fogo-contínuo"], "topic": "Fogo contínuo do altar", "visual": { "marker_type": "icon", "icon": "fire", "asset": "assets/icons/fire.svg", "caption": "O fogo perpétuo", "importance": 5 } },
    { "id": "tzv002", "order": 2, "text": "A minchah dos cohanim é comida em lugar santo, sem fermento, e tratada como santidade elevada.", "text_he": null, "refs": ["Leviticus 6:7-16"], "ref_start": "Leviticus 6:7", "ref_end": "Leviticus 6:16", "chapter": 6, "verse_start": 7, "verse_end": 16, "sefaria_ref": "Leviticus 6:7-16", "day_of_creation": null, "tags": ["minchah", "cohanim", "santidade"], "topic": "Minchah sacerdotal" },
    { "id": "tzv003", "order": 3, "text": "A chatat deve ser abatida no lugar da olah; seu sangue e carne possuem regras rigorosas de santidade.", "text_he": null, "refs": ["Leviticus 6:17-23"], "ref_start": "Leviticus 6:17", "ref_end": "Leviticus 6:23", "chapter": 6, "verse_start": 17, "verse_end": 23, "sefaria_ref": "Leviticus 6:17-23", "day_of_creation": null, "tags": ["chatat", "sangue", "santidade"], "topic": "Chatat no serviço dos cohanim" },
    { "id": "tzv004", "order": 4, "text": "A asham é tratada como santidade elevada; partes específicas são dadas aos cohanim.", "text_he": null, "refs": ["Leviticus 7:1-10"], "ref_start": "Leviticus 7:1", "ref_end": "Leviticus 7:10", "chapter": 7, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Leviticus 7:1-10", "day_of_creation": null, "tags": ["asham", "cohanim", "reparação"], "topic": "Asham e porções sacerdotais" },
    { "id": "tzv005", "order": 5, "text": "Os shelamim incluem formas de agradecimento, voto e oferta voluntária, com prazos distintos para consumo.", "text_he": null, "refs": ["Leviticus 7:11-21"], "ref_start": "Leviticus 7:11", "ref_end": "Leviticus 7:21", "chapter": 7, "verse_start": 11, "verse_end": 21, "sefaria_ref": "Leviticus 7:11-21", "day_of_creation": null, "tags": ["shelamim", "todah", "voto"], "topic": "Shelamim, todah e votos" },
    { "id": "tzv006", "order": 6, "text": "A gordura sacrificial e o sangue são proibidos ao consumo, preservando a distinção entre vida, altar e alimentação humana.", "text_he": null, "refs": ["Leviticus 7:22-27"], "ref_start": "Leviticus 7:22", "ref_end": "Leviticus 7:27", "chapter": 7, "verse_start": 22, "verse_end": 27, "sefaria_ref": "Leviticus 7:22-27", "day_of_creation": null, "tags": ["sangue", "gordura", "proibição"], "topic": "Proibição de sangue e gordura" },
    { "id": "tzv007", "order": 7, "text": "O peito e a coxa dos shelamim são separados como porções sacerdotais, estabelecendo sustento e honra aos cohanim.", "text_he": null, "refs": ["Leviticus 7:28-38"], "ref_start": "Leviticus 7:28", "ref_end": "Leviticus 7:38", "chapter": 7, "verse_start": 28, "verse_end": 38, "sefaria_ref": "Leviticus 7:28-38", "day_of_creation": null, "tags": ["porções", "cohanim", "shelamim"], "topic": "Porções dos cohanim" },
    { "id": "tzv008", "order": 8, "text": "Moshe reúne a comunidade, veste Aharon e seus filhos, unge o Mishkan e realiza os sacrifícios dos sete dias de consagração.", "text_he": null, "refs": ["Leviticus 8:1-36"], "ref_start": "Leviticus 8:1", "ref_end": "Leviticus 8:36", "chapter": 8, "verse_start": 1, "verse_end": 36, "sefaria_ref": "Leviticus 8:1-36", "day_of_creation": null, "tags": ["inauguração", "aharon", "cohanim"], "topic": "Miluim — Sete dias de consagração", "visual": { "marker_type": "icon", "icon": "crown", "asset": "assets/icons/crown.svg", "caption": "Os Miluim", "importance": 3 } }
  ],
