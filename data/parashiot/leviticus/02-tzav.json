  "timeline": { "period_name": "Serviço sacerdotal e inauguração", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "A parashá ensina o lado sacerdotal dos korbanot e narra a consagração de Aharon e seus filhos durante sete dias." },
  "summary": { "short": "Instruções sacerdotais dos korbanot e os sete dias de inauguração dos cohanim.", "medium": "Tzav desloca o foco do ofertante para os cohanim. O fogo do altar deve permanecer aceso; os sacrifícios recebem regras precisas de consumo, queima e santidade.\n\nA segunda metade descreve a consagração de Aharon e seus filhos. Moshe veste, unge e purifica os cohanim, inaugurando uma liderança ritual que deve servir com disciplina e santidade.", "characters_main": ["Moshe", "Aharon", "Nadav", "Avihu", "Elazar", "Itamar"], "characters_secondary": ["Bnei Israel", "Cohanim"], "themes": ["Cohanim", "Korbanot", "Fogo contínuo", "Consagração", "Disciplina"] },
