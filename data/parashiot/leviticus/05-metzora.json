  "timeline": { "period_name": "Purificação do metzora e impurezas corporais", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "A parashá descreve a volta do metzora à comunidade, a purificação de casas afetadas e leis de fluxos corporais." },
  "summary": { "short": "Purificação do metzora, tzaraat nas casas e impurezas corporais.", "medium": "Metzora mostra que o diagnóstico de impureza não é o fim da história. O processo de purificação conduz a pessoa de volta ao acampamento e ao Mishkan.\n\nA parashá também trata de casas atingidas por tzaraat e de fluxos corporais masculinos e femininos, mantendo a fronteira entre vida íntima, corpo e santidade do santuário.", "characters_main": ["Moshe", "Aharon", "Cohanim", "Metzora"], "characters_secondary": ["Bnei Israel"], "themes": ["Purificação", "Retorno", "Casa", "Corpo", "Santidade"] },
