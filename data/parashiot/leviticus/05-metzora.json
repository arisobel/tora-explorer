  "facts": [
    { "id": "mtz001", "order": 1, "text": "O metzora purificado é levado ao cohen fora do acampamento para iniciar seu retorno.", "text_he": null, "refs": ["Leviticus 14:1-3"], "ref_start": "Leviticus 14:1", "ref_end": "Leviticus 14:3", "chapter": 14, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Leviticus 14:1-3", "day_of_creation": null, "tags": ["metzora", "cohen", "retorno"], "topic": "O cohen sai ao encontro" },
    { "id": "mtz002", "order": 2, "text": "Duas aves, madeira de cedro, lã escarlate e hissopo formam o primeiro rito de purificação.", "text_he": null, "refs": ["Leviticus 14:4-9"], "ref_start": "Leviticus 14:4", "ref_end": "Leviticus 14:9", "chapter": 14, "verse_start": 4, "verse_end": 9, "sefaria_ref": "Leviticus 14:4-9", "day_of_creation": null, "tags": ["aves", "hissopo", "purificação"], "topic": "Aves e símbolos de purificação" },
    { "id": "mtz003", "order": 3, "text": "No oitavo dia, o metzora traz korbanot; sangue e azeite são colocados na orelha, polegar e dedo do pé.", "text_he": null, "refs": ["Leviticus 14:10-20"], "ref_start": "Leviticus 14:10", "ref_end": "Leviticus 14:20", "chapter": 14, "verse_start": 10, "verse_end": 20, "sefaria_ref": "Leviticus 14:10-20", "day_of_creation": null, "tags": ["oitavo-dia", "azeite", "korbanot"], "topic": "Rito final de retorno" },
    { "id": "mtz004", "order": 4, "text": "A pessoa pobre recebe uma alternativa reduzida de korbanot, preservando o acesso à purificação.", "text_he": null, "refs": ["Leviticus 14:21-32"], "ref_start": "Leviticus 14:21", "ref_end": "Leviticus 14:32", "chapter": 14, "verse_start": 21, "verse_end": 32, "sefaria_ref": "Leviticus 14:21-32", "day_of_creation": null, "tags": ["pobre", "acessibilidade", "korban"], "topic": "Purificação acessível ao pobre" },
    { "id": "mtz005", "order": 5, "text": "Ao entrar na terra, uma casa pode apresentar sinais de tzaraat; o cohen esvazia, observa e decide o processo.", "text_he": null, "refs": ["Leviticus 14:33-42"], "ref_start": "Leviticus 14:33", "ref_end": "Leviticus 14:42", "chapter": 14, "verse_start": 33, "verse_end": 42, "sefaria_ref": "Leviticus 14:33-42", "day_of_creation": null, "tags": ["casa", "terra", "tzaraat"], "topic": "Tzaraat nas casas" },
    { "id": "mtz006", "order": 6, "text": "Se a praga retorna, a casa é demolida; se cessa, a casa passa por rito de purificação semelhante ao do metzora.", "text_he": null, "refs": ["Leviticus 14:43-57"], "ref_start": "Leviticus 14:43", "ref_end": "Leviticus 14:57", "chapter": 14, "verse_start": 43, "verse_end": 57, "sefaria_ref": "Leviticus 14:43-57", "day_of_creation": null, "tags": ["casa", "demolição", "purificação"], "topic": "Destino da casa afetada" },
    { "id": "mtz007", "order": 7, "text": "Fluxos masculinos produzem impureza ritual em pessoa, objetos e contato, exigindo imersão e korban ao final.", "text_he": null, "refs": ["Leviticus 15:1-18"], "ref_start": "Leviticus 15:1", "ref_end": "Leviticus 15:18", "chapter": 15, "verse_start": 1, "verse_end": 18, "sefaria_ref": "Leviticus 15:1-18", "day_of_creation": null, "tags": ["zav", "corpo", "pureza"], "topic": "Fluxos masculinos" },
    { "id": "mtz008", "order": 8, "text": "A niddah e outros fluxos femininos possuem regras de impureza, purificação e korban, protegendo a santidade do Mishkan.", "text_he": null, "refs": ["Leviticus 15:19-33"], "ref_start": "Leviticus 15:19", "ref_end": "Leviticus 15:33", "chapter": 15, "verse_start": 19, "verse_end": 33, "sefaria_ref": "Leviticus 15:19-33", "day_of_creation": null, "tags": ["niddah", "zavah", "mishkan"], "topic": "Fluxos femininos e santidade" }
  ],
