  "facts": [
    { "id": "shm001", "order": 1, "text": "No oitavo dia, Moshe chama Aharon, seus filhos e os anciãos para iniciar o serviço público do Mishkan.", "text_he": null, "refs": ["Leviticus 9:1-7"], "ref_start": "Leviticus 9:1", "ref_end": "Leviticus 9:7", "chapter": 9, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Leviticus 9:1-7", "day_of_creation": null, "tags": ["oitavo-dia", "mishkan", "inauguração"], "topic": "O oitavo dia" },
    { "id": "shm002", "order": 2, "text": "Aharon oferece sua chatat e sua olah, iniciando o serviço sacerdotal em nome próprio.", "text_he": null, "refs": ["Leviticus 9:8-14"], "ref_start": "Leviticus 9:8", "ref_end": "Leviticus 9:14", "chapter": 9, "verse_start": 8, "verse_end": 14, "sefaria_ref": "Leviticus 9:8-14", "day_of_creation": null, "tags": ["aharon", "chatat", "olah"], "topic": "Korbanot de Aharon" },
    { "id": "shm003", "order": 3, "text": "Aharon oferece os korbanot do povo: chatat, olah, minchah e shelamim.", "text_he": null, "refs": ["Leviticus 9:15-21"], "ref_start": "Leviticus 9:15", "ref_end": "Leviticus 9:21", "chapter": 9, "verse_start": 15, "verse_end": 21, "sefaria_ref": "Leviticus 9:15-21", "day_of_creation": null, "tags": ["bnei-israel", "korbanot", "cohen-gadol"], "topic": "Korbanot do povo" },
    { "id": "shm004", "order": 4, "text": "A glória de Deus aparece, fogo sai de diante de Deus e consome o korban no altar; o povo cai sobre o rosto.", "text_he": null, "refs": ["Leviticus 9:22-24"], "ref_start": "Leviticus 9:22", "ref_end": "Leviticus 9:24", "chapter": 9, "verse_start": 22, "verse_end": 24, "sefaria_ref": "Leviticus 9:22-24", "day_of_creation": null, "tags": ["glória", "fogo", "presença"], "topic": "A Presença aparece" },
    { "id": "shm005", "order": 5, "text": "Nadav e Avihu trazem fogo estranho que Deus não havia ordenado; fogo sai de diante de Deus e eles morrem.", "text_he": null, "refs": ["Leviticus 10:1-3"], "ref_start": "Leviticus 10:1", "ref_end": "Leviticus 10:3", "chapter": 10, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Leviticus 10:1-3", "day_of_creation": null, "tags": ["nadav", "avihu", "fogo-estranho"], "topic": "Fogo estranho" },
    { "id": "shm006", "order": 6, "text": "Moshe instrui Aharon e seus filhos a manterem a dignidade sacerdotal diante da tragédia e a não abandonarem o Mishkan.", "text_he": null, "refs": ["Leviticus 10:4-11"], "ref_start": "Leviticus 10:4", "ref_end": "Leviticus 10:11", "chapter": 10, "verse_start": 4, "verse_end": 11, "sefaria_ref": "Leviticus 10:4-11", "day_of_creation": null, "tags": ["luto", "cohanim", "vinho"], "topic": "Santidade sacerdotal após a tragédia" },
    { "id": "shm007", "order": 7, "text": "Moshe e Aharon discutem a chatat não comida; Moshe aceita a explicação de Aharon em meio ao luto.", "text_he": null, "refs": ["Leviticus 10:12-20"], "ref_start": "Leviticus 10:12", "ref_end": "Leviticus 10:20", "chapter": 10, "verse_start": 12, "verse_end": 20, "sefaria_ref": "Leviticus 10:12-20", "day_of_creation": null, "tags": ["chatat", "luto", "halacha"], "topic": "A pergunta de Moshe e resposta de Aharon" },
    { "id": "shm008", "order": 8, "text": "Deus ensina os sinais dos animais permitidos e proibidos, encerrando com o chamado a distinguir puro e impuro.", "text_he": null, "refs": ["Leviticus 11:1-47"], "ref_start": "Leviticus 11:1", "ref_end": "Leviticus 11:47", "chapter": 11, "verse_start": 1, "verse_end": 47, "sefaria_ref": "Leviticus 11:1-47", "day_of_creation": null, "tags": ["kashrut", "animais", "pureza"], "topic": "Kashrut — Animais permitidos e proibidos" }
  ],
