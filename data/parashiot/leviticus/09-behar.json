  "timeline": { "period_name": "Shemitá, Yovel e liberdade econômica", "anno_mundi_start": 2449, "anno_mundi_end": 2450, "era": "saida-egito", "position_pct": 42, "description": "No Sinai, a Torá estabelece ciclos de descanso da terra, liberação, redenção patrimonial e cuidado econômico." },
  "summary": { "short": "Shemitá, Yovel, redenção da terra, apoio ao pobre e liberdade.", "medium": "Behar amplia a santidade para a economia e a terra. A terra descansa no sétimo ano, e no Yovel propriedades retornam e servidão é limitada.\n\nA parashá insiste que a terra pertence a Deus e que Israel vive nela como residente e guardião. Por isso, comércio, empréstimo e trabalho devem refletir liberdade e responsabilidade.", "characters_main": ["Moshe", "Bnei Israel"], "characters_secondary": ["Pobre", "Parente redentor", "Servo hebreu"], "themes": ["Shemitá", "Yovel", "Terra", "Liberdade", "Justiça econômica"] },
