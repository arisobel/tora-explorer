  "facts": [
    { "id": "bh001", "order": 1, "text": "No Sinai, Deus ordena que a terra descanse no sétimo ano: é Shabat para a terra.", "text_he": null, "refs": ["Leviticus 25:1-7"], "ref_start": "Leviticus 25:1", "ref_end": "Leviticus 25:7", "chapter": 25, "verse_start": 1, "verse_end": 7, "sefaria_ref": "Leviticus 25:1-7", "day_of_creation": null, "tags": ["shemitá", "terra", "shabat"], "topic": "Shemitá — Descanso da terra", "visual": { "marker_type": "icon", "icon": "wheat", "asset": "assets/icons/wheat.svg", "caption": "A Shemitá", "importance": 4 } },
    { "id": "bh002", "order": 2, "text": "Após sete ciclos de sete anos, o Yovel é proclamado com shofar no Yom Kippur.", "text_he": null, "refs": ["Leviticus 25:8-10"], "ref_start": "Leviticus 25:8", "ref_end": "Leviticus 25:10", "chapter": 25, "verse_start": 8, "verse_end": 10, "sefaria_ref": "Leviticus 25:8-10", "day_of_creation": null, "tags": ["yovel", "shofar", "yom-kippur"], "topic": "Yovel — Liberdade proclamada", "visual": { "marker_type": "icon", "icon": "shofar", "asset": "assets/icons/shofar.svg", "caption": "O Yovel", "importance": 5 } },
    { "id": "bh003", "order": 3, "text": "No Yovel, a terra retorna às famílias e a compra de campos é calculada pelos anos de colheita até o jubileu.", "text_he": null, "refs": ["Leviticus 25:11-17"], "ref_start": "Leviticus 25:11", "ref_end": "Leviticus 25:17", "chapter": 25, "verse_start": 11, "verse_end": 17, "sefaria_ref": "Leviticus 25:11-17", "day_of_creation": null, "tags": ["terra", "propriedade", "preço-justo"], "topic": "Retorno da terra" },
    { "id": "bh004", "order": 4, "text": "Deus promete bênção especial no sexto ano para sustentar Shemitá e o período seguinte.", "text_he": null, "refs": ["Leviticus 25:18-22"], "ref_start": "Leviticus 25:18", "ref_end": "Leviticus 25:22", "chapter": 25, "verse_start": 18, "verse_end": 22, "sefaria_ref": "Leviticus 25:18-22", "day_of_creation": null, "tags": ["confiança", "bênção", "shemitá"], "topic": "Confiança na bênção" },
    { "id": "bh005", "order": 5, "text": "A terra não pode ser vendida definitivamente, pois pertence a Deus; Israel é residente e peregrino com Ele.", "text_he": null, "refs": ["Leviticus 25:23-28"], "ref_start": "Leviticus 25:23", "ref_end": "Leviticus 25:28", "chapter": 25, "verse_start": 23, "verse_end": 28, "sefaria_ref": "Leviticus 25:23-28", "day_of_creation": null, "tags": ["terra-de-deus", "redenção", "posse"], "topic": "A terra pertence a Deus" },
    { "id": "bh006", "order": 6, "text": "Casas em cidades muradas e casas dos levitas recebem regras específicas de venda e redenção.", "text_he": null, "refs": ["Leviticus 25:29-34"], "ref_start": "Leviticus 25:29", "ref_end": "Leviticus 25:34", "chapter": 25, "verse_start": 29, "verse_end": 34, "sefaria_ref": "Leviticus 25:29-34", "day_of_creation": null, "tags": ["casas", "levitas", "redenção"], "topic": "Casas e cidades levíticas" },
    { "id": "bh007", "order": 7, "text": "Quando o irmão empobrece, deve ser sustentado; juros e exploração são proibidos.", "text_he": null, "refs": ["Leviticus 25:35-38"], "ref_start": "Leviticus 25:35", "ref_end": "Leviticus 25:38", "chapter": 25, "verse_start": 35, "verse_end": 38, "sefaria_ref": "Leviticus 25:35-38", "day_of_creation": null, "tags": ["pobre", "juros", "apoio"], "topic": "Fortalecer o irmão pobre" },
    { "id": "bh008", "order": 8, "text": "A servidão hebraica é limitada e orientada à redenção; Israel é servo de Deus, não propriedade humana definitiva.", "text_he": null, "refs": ["Leviticus 25:39-26:2"], "ref_start": "Leviticus 25:39", "ref_end": "Leviticus 26:2", "chapter": 25, "verse_start": 39, "verse_end": 2, "sefaria_ref": "Leviticus 25:39-26:2", "day_of_creation": null, "tags": ["servidão", "redenção", "liberdade"], "topic": "Servos de Deus, não de homens" }
  ],
