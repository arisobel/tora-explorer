    "caption": "Yom Kipur — expiação"
  },

  "facts": [
    { "id": "am001", "order": 1, "text": "Após a morte de Nadav e Avihu, Aharon é advertido a não entrar livremente no Santo dos Santos.", "text_he": null, "refs": ["Leviticus 16:1-2"], "ref_start": "Leviticus 16:1", "ref_end": "Leviticus 16:2", "chapter": 16, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Leviticus 16:1-2", "day_of_creation": null, "tags": ["nadav-avihu", "santo-dos-santos", "limite"], "topic": "Limite de entrada no sagrado" },
    { "id": "am002", "order": 2, "text": "O Cohen Gadol entra com vestes especiais, imersão e korbanot próprios para iniciar o serviço de Yom Kippur.", "text_he": null, "refs": ["Leviticus 16:3-10"], "ref_start": "Leviticus 16:3", "ref_end": "Leviticus 16:10", "chapter": 16, "verse_start": 3, "verse_end": 10, "sefaria_ref": "Leviticus 16:3-10", "day_of_creation": null, "tags": ["cohen-gadol", "yom-kippur", "vestes"], "topic": "Preparação do Cohen Gadol" },
    { "id": "am003", "order": 3, "text": "O incenso é levado para dentro do véu, criando nuvem sobre o Kapporet antes da aspersão do sangue.", "text_he": null, "refs": ["Leviticus 16:11-17"], "ref_start": "Leviticus 16:11", "ref_end": "Leviticus 16:17", "chapter": 16, "verse_start": 11, "verse_end": 17, "sefaria_ref": "Leviticus 16:11-17", "day_of_creation": null, "tags": ["ketoret", "kapporet", "sangue"], "topic": "Ketoret e aspersão interior" },
    { "id": "am004", "order": 4, "text": "O altar e o santuário são purificados das impurezas de Israel por meio das aspersões.", "text_he": null, "refs": ["Leviticus 16:18-19"], "ref_start": "Leviticus 16:18", "ref_end": "Leviticus 16:19", "chapter": 16, "verse_start": 18, "verse_end": 19, "sefaria_ref": "Leviticus 16:18-19", "day_of_creation": null, "tags": ["altar", "purificação", "santuário"], "topic": "Purificação do altar" },
    { "id": "am005", "order": 5, "text": "O bode para Azazel carrega simbolicamente as transgressões de Israel para o deserto.", "text_he": null, "refs": ["Leviticus 16:20-28"], "ref_start": "Leviticus 16:20", "ref_end": "Leviticus 16:28", "chapter": 16, "verse_start": 20, "verse_end": 28, "sefaria_ref": "Leviticus 16:20-28", "day_of_creation": null, "tags": ["azazel", "confissão", "deserto"], "topic": "O bode para Azazel", "visual": { "marker_type": "icon", "icon": "mountains", "asset": "assets/icons/mountains.svg", "caption": "O bode para Azazel", "importance": 4 } },
    { "id": "am006", "order": 6, "text": "Yom Kippur é fixado como estatuto eterno: aflição da alma, cessação de trabalho e expiação anual.", "text_he": null, "refs": ["Leviticus 16:29-34"], "ref_start": "Leviticus 16:29", "ref_end": "Leviticus 16:34", "chapter": 16, "verse_start": 29, "verse_end": 34, "sefaria_ref": "Leviticus 16:29-34", "day_of_creation": null, "tags": ["yom-kippur", "estatuto", "expiação"], "topic": "Yom Kippur para todas as gerações", "visual": { "marker_type": "icon", "icon": "shofar", "asset": "assets/icons/shofar.svg", "caption": "Yom Kipur", "importance": 5 } },
    { "id": "am007", "order": 7, "text": "Sacrifícios devem ser trazidos ao local designado, e o consumo de sangue é proibido porque a vida está no sangue.", "text_he": null, "refs": ["Leviticus 17:1-16"], "ref_start": "Leviticus 17:1", "ref_end": "Leviticus 17:16", "chapter": 17, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Leviticus 17:1-16", "day_of_creation": null, "tags": ["sangue", "sacrifício", "vida"], "topic": "Sangue e local do serviço" },
    { "id": "am008", "order": 8, "text": "Israel é advertido a não seguir práticas do Egito e de Canaã, e recebe uma lista de relações proibidas.", "text_he": null, "refs": ["Leviticus 18:1-30"], "ref_start": "Leviticus 18:1", "ref_end": "Leviticus 18:30", "chapter": 18, "verse_start": 1, "verse_end": 30, "sefaria_ref": "Leviticus 18:1-30", "day_of_creation": null, "tags": ["relações-proibidas", "egito", "canaã"], "topic": "Santidade sexual e separação" }
  ],
