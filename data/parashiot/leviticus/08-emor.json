  "timeline": { "period_name": "Cohanim, festas e santidade pública", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "Emor organiza a santidade dos cohanim, a integridade dos korbanot, o calendário das festas e casos públicos de luz, pão e blasfêmia." },
  "summary": { "short": "Santidade dos cohanim, festas do calendário, Menorá, lechem hapanim e blasfêmia.", "medium": "Emor começa com a santidade especial dos cohanim e do Cohen Gadol, incluindo limites de impureza e casamento. Também regula quem pode comer das porções sagradas e que tipo de animal pode ser oferecido.\n\nO centro da parashá é o calendário: Shabat, Pessach, Omer, Shavuot, Rosh Hashaná, Yom Kippur e Sukkot. A santidade ganha ritmo no tempo.", "characters_main": ["Moshe", "Aharon", "Cohanim", "Bnei Israel"], "characters_secondary": ["Cohen Gadol", "Blasfemador"], "themes": ["Cohanim", "Moedim", "Tempo sagrado", "Korbanot", "Justiça"] },
