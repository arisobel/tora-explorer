  "facts": [
    { "id": "em001", "order": 1, "text": "Os cohanim recebem limites específicos de impureza por contato com mortos, preservando sua função no serviço.", "text_he": null, "refs": ["Leviticus 21:1-9"], "ref_start": "Leviticus 21:1", "ref_end": "Leviticus 21:9", "chapter": 21, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Leviticus 21:1-9", "day_of_creation": null, "tags": ["cohanim", "impureza", "luto"], "topic": "Santidade dos cohanim" },
    { "id": "em002", "order": 2, "text": "O Cohen Gadol recebe exigências ainda mais elevadas, por carregar a unção e as vestes sagradas.", "text_he": null, "refs": ["Leviticus 21:10-15"], "ref_start": "Leviticus 21:10", "ref_end": "Leviticus 21:15", "chapter": 21, "verse_start": 10, "verse_end": 15, "sefaria_ref": "Leviticus 21:10-15", "day_of_creation": null, "tags": ["cohen-gadol", "unção", "santidade"], "topic": "Santidade do Cohen Gadol" },
    { "id": "em003", "order": 3, "text": "Defeitos físicos limitam o serviço no altar, mas não removem o pertencimento às porções sagradas.", "text_he": null, "refs": ["Leviticus 21:16-24"], "ref_start": "Leviticus 21:16", "ref_end": "Leviticus 21:24", "chapter": 21, "verse_start": 16, "verse_end": 24, "sefaria_ref": "Leviticus 21:16-24", "day_of_creation": null, "tags": ["altar", "cohanim", "defeitos"], "topic": "Integridade ritual no serviço" },
    { "id": "em004", "order": 4, "text": "As porções sagradas só podem ser comidas em estado de pureza e por quem pertence ao círculo sacerdotal permitido.", "text_he": null, "refs": ["Leviticus 22:1-16"], "ref_start": "Leviticus 22:1", "ref_end": "Leviticus 22:16", "chapter": 22, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Leviticus 22:1-16", "day_of_creation": null, "tags": ["terumah", "pureza", "cohanim"], "topic": "Comer santidade com pureza" },
    { "id": "em005", "order": 5, "text": "Korbanot devem ser íntegros; animais defeituosos ou muito jovens não são aceitos.", "text_he": null, "refs": ["Leviticus 22:17-33"], "ref_start": "Leviticus 22:17", "ref_end": "Leviticus 22:33", "chapter": 22, "verse_start": 17, "verse_end": 33, "sefaria_ref": "Leviticus 22:17-33", "day_of_creation": null, "tags": ["korban", "integridade", "animal"], "topic": "Integridade dos korbanot" },
    { "id": "em006", "order": 6, "text": "O calendário sagrado é apresentado: Shabat, Pessach, Omer, Shavuot, Rosh Hashaná, Yom Kippur e Sukkot.", "text_he": null, "refs": ["Leviticus 23:1-44"], "ref_start": "Leviticus 23:1", "ref_end": "Leviticus 23:44", "chapter": 23, "verse_start": 1, "verse_end": 44, "sefaria_ref": "Leviticus 23:1-44", "day_of_creation": null, "tags": ["moedim", "festas", "calendário"], "topic": "Moedim — Tempos sagrados" },
    { "id": "em007", "order": 7, "text": "A Menorá deve ser acesa continuamente e o lechem hapanim colocado regularmente diante de Deus.", "text_he": null, "refs": ["Leviticus 24:1-9"], "ref_start": "Leviticus 24:1", "ref_end": "Leviticus 24:9", "chapter": 24, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Leviticus 24:1-9", "day_of_creation": null, "tags": ["menorá", "lechem-hapanim", "mishkan"], "topic": "Luz e pão diante de Deus" },
    { "id": "em008", "order": 8, "text": "O caso do blasfemador leva a leis sobre blasfêmia, homicídio, dano corporal e igualdade jurídica para cidadão e estrangeiro.", "text_he": null, "refs": ["Leviticus 24:10-23"], "ref_start": "Leviticus 24:10", "ref_end": "Leviticus 24:23", "chapter": 24, "verse_start": 10, "verse_end": 23, "sefaria_ref": "Leviticus 24:10-23", "day_of_creation": null, "tags": ["blasfêmia", "justiça", "estrangeiro"], "topic": "Blasfêmia e justiça pública" }
  ],
