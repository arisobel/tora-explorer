  "facts": [
    { "id": "bc001", "order": 1, "text": "Se Israel andar nos estatutos de Deus, a chuva virá no tempo certo e a terra dará sua produção.", "text_he": null, "refs": ["Leviticus 26:3-5"], "ref_start": "Leviticus 26:3", "ref_end": "Leviticus 26:5", "chapter": 26, "verse_start": 3, "verse_end": 5, "sefaria_ref": "Leviticus 26:3-5", "day_of_creation": null, "tags": ["bênção", "chuva", "terra"], "topic": "Chuva e abundância" },
    { "id": "bc002", "order": 2, "text": "A bênção inclui paz na terra, segurança, vitória sobre inimigos e ausência de medo.", "text_he": null, "refs": ["Leviticus 26:6-8"], "ref_start": "Leviticus 26:6", "ref_end": "Leviticus 26:8", "chapter": 26, "verse_start": 6, "verse_end": 8, "sefaria_ref": "Leviticus 26:6-8", "day_of_creation": null, "tags": ["paz", "segurança", "vitória"], "topic": "Paz e proteção" },
    { "id": "bc003", "order": 3, "text": "Deus promete voltar-Se para Israel, fazê-lo frutificar e estabelecer Sua morada no meio do povo.", "text_he": null, "refs": ["Leviticus 26:9-13"], "ref_start": "Leviticus 26:9", "ref_end": "Leviticus 26:13", "chapter": 26, "verse_start": 9, "verse_end": 13, "sefaria_ref": "Leviticus 26:9-13", "day_of_creation": null, "tags": ["presença", "aliança", "liberdade"], "topic": "Presença divina no meio de Israel" },
    { "id": "bc004", "order": 4, "text": "Se Israel rejeitar os mandamentos, virão medo, doença, derrota e frustração agrícola.", "text_he": null, "refs": ["Leviticus 26:14-17"], "ref_start": "Leviticus 26:14", "ref_end": "Leviticus 26:17", "chapter": 26, "verse_start": 14, "verse_end": 17, "sefaria_ref": "Leviticus 26:14-17", "day_of_creation": null, "tags": ["advertência", "rejeição", "derrota"], "topic": "Primeiro ciclo de advertência" },
    { "id": "bc005", "order": 5, "text": "A punição se intensifica em ciclos caso o povo continue andando em oposição a Deus.", "text_he": null, "refs": ["Leviticus 26:18-33"], "ref_start": "Leviticus 26:18", "ref_end": "Leviticus 26:33", "chapter": 26, "verse_start": 18, "verse_end": 33, "sefaria_ref": "Leviticus 26:18-33", "day_of_creation": null, "tags": ["tochachah", "oposição", "exílio"], "topic": "Escalada da Tochachah" },
    { "id": "bc006", "order": 6, "text": "No exílio, a terra descansará seus Shabatot enquanto o povo estiver fora dela.", "text_he": null, "refs": ["Leviticus 26:34-39"], "ref_start": "Leviticus 26:34", "ref_end": "Leviticus 26:39", "chapter": 26, "verse_start": 34, "verse_end": 39, "sefaria_ref": "Leviticus 26:34-39", "day_of_creation": null, "tags": ["exílio", "shemitá", "terra"], "topic": "A terra cobra seus descansos" },
    { "id": "bc007", "order": 7, "text": "Quando Israel confessar sua culpa, Deus lembrará a aliança com Yaakov, Yitzchak, Avraham e a terra.", "text_he": null, "refs": ["Leviticus 26:40-46"], "ref_start": "Leviticus 26:40", "ref_end": "Leviticus 26:46", "chapter": 26, "verse_start": 40, "verse_end": 46, "sefaria_ref": "Leviticus 26:40-46", "day_of_creation": null, "tags": ["teshuvá", "avot", "aliança"], "topic": "Memória da aliança" },
    { "id": "bc008", "order": 8, "text": "O livro termina com leis de votos, avaliações, consagrações, redenções, dízimos e coisas dedicadas a Deus.", "text_he": null, "refs": ["Leviticus 27:1-34"], "ref_start": "Leviticus 27:1", "ref_end": "Leviticus 27:34", "chapter": 27, "verse_start": 1, "verse_end": 34, "sefaria_ref": "Leviticus 27:1-34", "day_of_creation": null, "tags": ["votos", "consagração", "dízimo"], "topic": "Votos e consagrações" }
