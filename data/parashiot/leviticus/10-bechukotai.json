  "timeline": { "period_name": "Bênçãos, advertências e votos", "anno_mundi_start": 2450, "anno_mundi_end": 2450, "era": "saida-egito", "position_pct": 42, "description": "O livro de Vayikrá se encerra com bênçãos por fidelidade, advertências por abandono da aliança, lembrança dos patriarcas e leis de consagrações." },
  "summary": { "short": "Bênçãos, advertências da aliança, arrependimento e leis de votos/consagrações.", "medium": "Bechukotai apresenta o horizonte da aliança: se Israel anda nos estatutos de Deus, a terra dá fruto, há paz e a Presença divina habita no meio do povo.\n\nA parashá também descreve consequências crescentes de abandono, exílio e desolação da terra. Mesmo assim, termina com memória da aliança e leis de votos, mostrando que retorno e consagração continuam possíveis.", "characters_main": ["Moshe", "Bnei Israel"], "characters_secondary": ["Avot"], "themes": ["Aliança", "Bênção", "Advertência", "Teshuvá", "Votos"] },
