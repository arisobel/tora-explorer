  "timeline": { "period_name": "Nascimento, brit milah e diagnóstico de tzaraat", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "A parashá conecta nascimento, retorno à pureza ritual e procedimentos cuidadosos para diagnosticar tzaraat no corpo, cabelo, pele e roupas." },
  "summary": { "short": "Pureza após o parto, brit milah e diagnóstico de tzaraat.", "medium": "Tazria começa com as leis da mulher que dá à luz e inclui a mitzvá da brit milah no oitavo dia. O nascimento é tratado dentro do sistema de pureza e retorno ao santuário.\n\nDepois, a parashá apresenta longos procedimentos de diagnóstico de tzaraat. O cohen não é apenas julgador; ele observa, espera, isola e distingue entre sintomas, cura e impureza.", "characters_main": ["Moshe", "Aharon", "Cohanim", "Bnei Israel"], "characters_secondary": ["Yoledet", "Metzora"], "themes": ["Nascimento", "Brit Milah", "Pureza", "Tzaraat", "Diagnóstico"] },
