  "facts": [
    { "id": "tzr001", "order": 1, "text": "Após o nascimento de um menino ou menina, a mãe entra em um processo de pureza ritual com tempos diferentes até trazer seu korban.", "text_he": null, "refs": ["Leviticus 12:1-5"], "ref_start": "Leviticus 12:1", "ref_end": "Leviticus 12:5", "chapter": 12, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Leviticus 12:1-5", "day_of_creation": null, "tags": ["parto", "pureza", "yoledet"], "topic": "Pureza após o nascimento" },
    { "id": "tzr002", "order": 2, "text": "A brit milah é ordenada para o oitavo dia de vida do menino.", "text_he": null, "refs": ["Leviticus 12:3"], "ref_start": "Leviticus 12:3", "ref_end": "Leviticus 12:3", "chapter": 12, "verse_start": 3, "verse_end": 3, "sefaria_ref": "Leviticus 12:3", "day_of_creation": null, "tags": ["brit-milah", "oitavo-dia", "aliança"], "topic": "Brit Milah no oitavo dia" },
    { "id": "tzr003", "order": 3, "text": "Ao completar os dias de purificação, a mãe traz uma olah e uma chatat; se for pobre, pode trazer aves.", "text_he": null, "refs": ["Leviticus 12:6-8"], "ref_start": "Leviticus 12:6", "ref_end": "Leviticus 12:8", "chapter": 12, "verse_start": 6, "verse_end": 8, "sefaria_ref": "Leviticus 12:6-8", "day_of_creation": null, "tags": ["korban", "yoledet", "acessibilidade"], "topic": "Korban da mãe" },
    { "id": "tzr004", "order": 4, "text": "Quando surge uma lesão na pele, a pessoa é levada ao cohen para avaliação.", "text_he": null, "refs": ["Leviticus 13:1-8"], "ref_start": "Leviticus 13:1", "ref_end": "Leviticus 13:8", "chapter": 13, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Leviticus 13:1-8", "day_of_creation": null, "tags": ["tzaraat", "pele", "cohen"], "topic": "Primeiro diagnóstico de tzaraat" },
    { "id": "tzr005", "order": 5, "text": "O cohen distingue sinais de tzaraat antiga, carne viva, cura e mudança de cor.", "text_he": null, "refs": ["Leviticus 13:9-17"], "ref_start": "Leviticus 13:9", "ref_end": "Leviticus 13:17", "chapter": 13, "verse_start": 9, "verse_end": 17, "sefaria_ref": "Leviticus 13:9-17", "day_of_creation": null, "tags": ["diagnóstico", "tzaraat", "cura"], "topic": "Sinais complexos na pele" },
    { "id": "tzr006", "order": 6, "text": "Feridas, queimaduras e manchas também são examinadas com períodos de isolamento e reavaliação.", "text_he": null, "refs": ["Leviticus 13:18-28"], "ref_start": "Leviticus 13:18", "ref_end": "Leviticus 13:28", "chapter": 13, "verse_start": 18, "verse_end": 28, "sefaria_ref": "Leviticus 13:18-28", "day_of_creation": null, "tags": ["isolamento", "ferida", "queimadura"], "topic": "Feridas e queimaduras" },
    { "id": "tzr007", "order": 7, "text": "A tzaraat do couro cabeludo ou barba recebe regras próprias, incluindo sinais no cabelo e raspagem controlada.", "text_he": null, "refs": ["Leviticus 13:29-44"], "ref_start": "Leviticus 13:29", "ref_end": "Leviticus 13:44", "chapter": 13, "verse_start": 29, "verse_end": 44, "sefaria_ref": "Leviticus 13:29-44", "day_of_creation": null, "tags": ["cabelo", "barba", "netek"], "topic": "Tzaraat em cabelo e barba" },
    { "id": "tzr008", "order": 8, "text": "Roupas de lã, linho ou couro também podem receber sinais de tzaraat e passam por lavagem, isolamento ou queima.", "text_he": null, "refs": ["Leviticus 13:45-59"], "ref_start": "Leviticus 13:45", "ref_end": "Leviticus 13:59", "chapter": 13, "verse_start": 45, "verse_end": 59, "sefaria_ref": "Leviticus 13:45-59", "day_of_creation": null, "tags": ["roupas", "tzaraat", "purificação"], "topic": "Tzaraat em roupas" }
  ],
