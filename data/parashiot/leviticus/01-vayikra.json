  "facts": [
    { "id": "vy001", "order": 1, "text": "Deus chama Moshe da Tenda do Encontro e introduz as leis dos korbanot que Israel trará ao Mishkan.", "text_he": null, "refs": ["Leviticus 1:1-2"], "ref_start": "Leviticus 1:1", "ref_end": "Leviticus 1:2", "chapter": 1, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Leviticus 1:1-2", "day_of_creation": null, "tags": ["mishkan", "revelação", "korbanot"], "topic": "Chamado da Tenda do Encontro" },
    { "id": "vy002", "order": 2, "text": "A olah de gado é apresentada como oferta totalmente queimada no altar, símbolo de entrega integral diante de Deus.", "text_he": null, "refs": ["Leviticus 1:3-9"], "ref_start": "Leviticus 1:3", "ref_end": "Leviticus 1:9", "chapter": 1, "verse_start": 3, "verse_end": 9, "sefaria_ref": "Leviticus 1:3-9", "day_of_creation": null, "tags": ["olah", "gado", "altar"], "topic": "Olah — Entrega total", "visual": { "marker_type": "icon", "icon": "altar", "asset": "assets/icons/altar.svg", "caption": "A Olah", "importance": 4 } },
    { "id": "vy003", "order": 3, "text": "A olah também pode vir de rebanho ou aves, abrindo espaço para diferentes capacidades econômicas.", "text_he": null, "refs": ["Leviticus 1:10-17"], "ref_start": "Leviticus 1:10", "ref_end": "Leviticus 1:17", "chapter": 1, "verse_start": 10, "verse_end": 17, "sefaria_ref": "Leviticus 1:10-17", "day_of_creation": null, "tags": ["olah", "aves", "acessibilidade"], "topic": "Olah de rebanho ou aves" },
    { "id": "vy004", "order": 4, "text": "A minchah é oferta de farinha, azeite e incenso; uma parte vai ao altar e o restante pertence aos cohanim.", "text_he": null, "refs": ["Leviticus 2:1-16"], "ref_start": "Leviticus 2:1", "ref_end": "Leviticus 2:16", "chapter": 2, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Leviticus 2:1-16", "day_of_creation": null, "tags": ["minchah", "farinha", "cohanim"], "topic": "Minchah — Oferta vegetal", "visual": { "marker_type": "icon", "icon": "wheat", "asset": "assets/icons/wheat.svg", "caption": "A Minchá", "importance": 3 } },
    { "id": "vy005", "order": 5, "text": "A oferta de shelamim expressa paz e comunhão; partes são queimadas, partes dadas aos cohanim e partes comidas pelo ofertante.", "text_he": null, "refs": ["Leviticus 3:1-17"], "ref_start": "Leviticus 3:1", "ref_end": "Leviticus 3:17", "chapter": 3, "verse_start": 1, "verse_end": 17, "sefaria_ref": "Leviticus 3:1-17", "day_of_creation": null, "tags": ["shelamim", "paz", "comunhão"], "topic": "Shelamim — Paz e gratidão" },
    { "id": "vy006", "order": 6, "text": "A chatat é trazida por erros não intencionais, distinguindo responsabilidades do cohen ungido, da comunidade, do nasi e do indivíduo.", "text_he": null, "refs": ["Leviticus 4:1-35"], "ref_start": "Leviticus 4:1", "ref_end": "Leviticus 4:35", "chapter": 4, "verse_start": 1, "verse_end": 35, "sefaria_ref": "Leviticus 4:1-35", "day_of_creation": null, "tags": ["chatat", "erro", "responsabilidade"], "topic": "Chatat — Erro e expiação" },
    { "id": "vy007", "order": 7, "text": "Casos específicos de culpa incluem silêncio de testemunha, contato com impureza e juramento precipitado.", "text_he": null, "refs": ["Leviticus 5:1-13"], "ref_start": "Leviticus 5:1", "ref_end": "Leviticus 5:13", "chapter": 5, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Leviticus 5:1-13", "day_of_creation": null, "tags": ["testemunho", "impureza", "juramento"], "topic": "Culpa em fala, silêncio e impureza" },
    { "id": "vy008", "order": 8, "text": "A asham trata de profanação de coisas sagradas, dúvida de culpa e roubo ou fraude; exige reparação e acréscimo.", "text_he": null, "refs": ["Leviticus 5:14-26"], "ref_start": "Leviticus 5:14", "ref_end": "Leviticus 5:26", "chapter": 5, "verse_start": 14, "verse_end": 26, "sefaria_ref": "Leviticus 5:14-26", "day_of_creation": null, "tags": ["asham", "restituição", "fraude"], "topic": "Asham — Reparação e restituição" }
  ],
