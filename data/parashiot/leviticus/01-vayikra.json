  "timeline": { "period_name": "Korbanot e aproximação ao Mishkan", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "Deus chama Moshe da Tenda do Encontro e ensina as principais categorias de korbanot, organizando aproximação, gratidão, expiação e reparação." },
  "summary": { "short": "Os principais korbanot: olah, minchah, shelamim, chatat e asham.", "medium": "Vayikra abre com Deus chamando Moshe da Tenda do Encontro. A parashá apresenta o sistema de korbanot como linguagem de aproximação: ofertas voluntárias, ofertas de paz, ofertas por erro e reparações por culpa.\n\nO foco não é apenas ritual. Cada korban organiza uma relação: entrega total, gratidão, responsabilidade moral, purificação comunitária e restituição quando há dano ou profanação.", "characters_main": ["Moshe", "Aharon", "Cohanim", "Bnei Israel"], "characters_secondary": ["Nasi", "Testemunha", "Pessoa pobre"], "themes": ["Korbanot", "Aproximação", "Expiação", "Responsabilidade", "Mishkan"] },
