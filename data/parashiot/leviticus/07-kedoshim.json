  "facts": [
    { "id": "kd001", "order": 1, "text": "Deus ordena que Israel seja santo porque Ele é santo.", "text_he": null, "refs": ["Leviticus 19:1-2"], "ref_start": "Leviticus 19:1", "ref_end": "Leviticus 19:2", "chapter": 19, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Leviticus 19:1-2", "day_of_creation": null, "tags": ["santidade", "imitação-de-deus"], "topic": "Kedoshim tihyu", "visual": { "marker_type": "icon", "icon": "tzaddik", "asset": "assets/icons/tzaddik.svg", "caption": "Sede santos", "importance": 5 } },
    { "id": "kd002", "order": 2, "text": "A santidade começa com reverência aos pais, guarda do Shabat e rejeição de ídolos.", "text_he": null, "refs": ["Leviticus 19:3-8"], "ref_start": "Leviticus 19:3", "ref_end": "Leviticus 19:8", "chapter": 19, "verse_start": 3, "verse_end": 8, "sefaria_ref": "Leviticus 19:3-8", "day_of_creation": null, "tags": ["pais", "shabat", "idolatria"], "topic": "Família, Shabat e culto" },
    { "id": "kd003", "order": 3, "text": "O campo não deve ser colhido até o fim; cantos e restos ficam para o pobre e o estrangeiro.", "text_he": null, "refs": ["Leviticus 19:9-10"], "ref_start": "Leviticus 19:9", "ref_end": "Leviticus 19:10", "chapter": 19, "verse_start": 9, "verse_end": 10, "sefaria_ref": "Leviticus 19:9-10", "day_of_creation": null, "tags": ["pobre", "estrangeiro", "campo"], "topic": "Peah e leket", "visual": { "marker_type": "icon", "icon": "wheat", "asset": "assets/icons/wheat.svg", "caption": "Peah e leket", "importance": 3 } },
    { "id": "kd004", "order": 4, "text": "Roubo, mentira, juramento falso, retenção de salário e maldição ao surdo são proibidos.", "text_he": null, "refs": ["Leviticus 19:11-14"], "ref_start": "Leviticus 19:11", "ref_end": "Leviticus 19:14", "chapter": 19, "verse_start": 11, "verse_end": 14, "sefaria_ref": "Leviticus 19:11-14", "day_of_creation": null, "tags": ["honestidade", "salário", "fala"], "topic": "Ética cotidiana" },
    { "id": "kd005", "order": 5, "text": "A justiça deve ser imparcial: não favorecer pobre nem poderoso, e julgar com retidão.", "text_he": null, "refs": ["Leviticus 19:15-16"], "ref_start": "Leviticus 19:15", "ref_end": "Leviticus 19:16", "chapter": 19, "verse_start": 15, "verse_end": 16, "sefaria_ref": "Leviticus 19:15-16", "day_of_creation": null, "tags": ["justiça", "tribunal", "fofoca"], "topic": "Justiça sem parcialidade" },
    { "id": "kd006", "order": 6, "text": "A Torá ordena não odiar o irmão, repreender corretamente, não vingar e amar o próximo como a si mesmo.", "text_he": null, "refs": ["Leviticus 19:17-18"], "ref_start": "Leviticus 19:17", "ref_end": "Leviticus 19:18", "chapter": 19, "verse_start": 17, "verse_end": 18, "sefaria_ref": "Leviticus 19:17-18", "day_of_creation": null, "tags": ["amor-ao-próximo", "ódio", "vingança"], "topic": "Ama teu próximo", "visual": { "marker_type": "icon", "icon": "covenant", "asset": "assets/icons/covenant.svg", "caption": "Veahavta lereacha", "importance": 5 } },
    { "id": "kd007", "order": 7, "text": "Misturas proibidas, orlah, práticas mágicas, cortes idólatras e prostituição ritual são rejeitados.", "text_he": null, "refs": ["Leviticus 19:19-31"], "ref_start": "Leviticus 19:19", "ref_end": "Leviticus 19:31", "chapter": 19, "verse_start": 19, "verse_end": 31, "sefaria_ref": "Leviticus 19:19-31", "day_of_creation": null, "tags": ["separação", "orlah", "magia"], "topic": "Separações de santidade" },
    { "id": "kd008", "order": 8, "text": "A parashá exige respeito ao ancião, amor ao estrangeiro, pesos justos e punições contra práticas que profanam a santidade.", "text_he": null, "refs": ["Leviticus 19:32-20:27"], "ref_start": "Leviticus 19:32", "ref_end": "Leviticus 20:27", "chapter": 19, "verse_start": 32, "verse_end": 27, "sefaria_ref": "Leviticus 19:32-20:27", "day_of_creation": null, "tags": ["ancião", "estrangeiro", "pesos-justos"], "topic": "Santidade em sociedade" }
  ],
