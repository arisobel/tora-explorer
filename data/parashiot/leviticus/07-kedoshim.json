  "timeline": { "period_name": "Santidade social e moral", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "Israel é chamado a ser santo, transformando reverência, justiça, fala, sexualidade, comércio e cuidado social em expressão de aliança." },
  "summary": { "short": "Santidade social: respeito, justiça, amor ao próximo e separação moral.", "medium": "Kedoshim traduz santidade em vida social. Respeito aos pais, Shabat, justiça no julgamento, cuidado com pobre e estrangeiro, honestidade comercial e amor ao próximo aparecem lado a lado com proibições de idolatria.\n\nA parashá mostra que santidade não é isolamento abstrato; ela atravessa relações humanas, economia, fala, corpo e justiça.", "characters_main": ["Moshe", "Bnei Israel"], "characters_secondary": ["Pobre", "Estrangeiro", "Ancião"], "themes": ["Santidade", "Justiça", "Amor ao próximo", "Ética social", "Separação"] },
