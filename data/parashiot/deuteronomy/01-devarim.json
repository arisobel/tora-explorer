  "facts": [
    { "id": "dv001", "order": 1, "text": "Moshe fala a Israel nas planícies de Moav, no quadragésimo ano, preparando seu discurso final.", "text_he": null, "refs": ["Deuteronomy 1:1-5"], "ref_start": "Deuteronomy 1:1", "ref_end": "Deuteronomy 1:5", "chapter": 1, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Deuteronomy 1:1-5", "day_of_creation": null, "tags": ["moshe", "moav", "discurso"], "topic": "Abertura dos discursos", "visual": { "marker_type": "icon", "icon": "scroll", "asset": "assets/icons/scroll.svg", "caption": "As palavras de Moshe", "importance": 4 } },
    { "id": "dv002", "order": 2, "text": "Moshe relembra a ordem de deixar o Chorev e avançar rumo à terra prometida aos patriarcas.", "text_he": null, "refs": ["Deuteronomy 1:6-8"], "ref_start": "Deuteronomy 1:6", "ref_end": "Deuteronomy 1:8", "chapter": 1, "verse_start": 6, "verse_end": 8, "sefaria_ref": "Deuteronomy 1:6-8", "day_of_creation": null, "tags": ["chorev", "terra", "patriarcas"], "topic": "Partida do Sinai" },
    { "id": "dv003", "order": 3, "text": "A carga de liderar o povo leva à nomeação de chefes e juízes sábios para administrar justiça.", "text_he": null, "refs": ["Deuteronomy 1:9-18"], "ref_start": "Deuteronomy 1:9", "ref_end": "Deuteronomy 1:18", "chapter": 1, "verse_start": 9, "verse_end": 18, "sefaria_ref": "Deuteronomy 1:9-18", "day_of_creation": null, "tags": ["juízes", "liderança", "justiça"], "topic": "Nomeação de juízes" },
    { "id": "dv004", "order": 4, "text": "A missão dos espiões é recontada como momento em que o medo substituiu a confiança na promessa divina.", "text_he": null, "refs": ["Deuteronomy 1:19-33"], "ref_start": "Deuteronomy 1:19", "ref_end": "Deuteronomy 1:33", "chapter": 1, "verse_start": 19, "verse_end": 33, "sefaria_ref": "Deuteronomy 1:19-33", "day_of_creation": null, "tags": ["espiões", "medo", "terra"], "topic": "Crise dos espiões", "visual": { "marker_type": "icon", "icon": "vine", "asset": "assets/icons/vine.svg", "caption": "A memória dos espiões", "importance": 3 } },
    { "id": "dv005", "order": 5, "text": "A geração rebelde é impedida de entrar na terra, enquanto Calev e Yehoshua são destacados.", "text_he": null, "refs": ["Deuteronomy 1:34-46"], "ref_start": "Deuteronomy 1:34", "ref_end": "Deuteronomy 1:46", "chapter": 1, "verse_start": 34, "verse_end": 46, "sefaria_ref": "Deuteronomy 1:34-46", "day_of_creation": null, "tags": ["sentença", "calev", "yehoshua"], "topic": "Consequência da recusa" },
    { "id": "dv006", "order": 6, "text": "Israel contorna Seir, Moav e Amon, respeitando territórios que Deus deu a outros povos.", "text_he": null, "refs": ["Deuteronomy 2:1-23"], "ref_start": "Deuteronomy 2:1", "ref_end": "Deuteronomy 2:23", "chapter": 2, "verse_start": 1, "verse_end": 23, "sefaria_ref": "Deuteronomy 2:1-23", "day_of_creation": null, "tags": ["edom", "moav", "amon"], "topic": "Fronteiras respeitadas" },
    { "id": "dv007", "order": 7, "text": "Sichon recusa passagem e é derrotado, abrindo a conquista a leste do Jordão.", "text_he": null, "refs": ["Deuteronomy 2:24-37"], "ref_start": "Deuteronomy 2:24", "ref_end": "Deuteronomy 2:37", "chapter": 2, "verse_start": 24, "verse_end": 37, "sefaria_ref": "Deuteronomy 2:24-37", "day_of_creation": null, "tags": ["sichon", "conquista", "jordão"], "topic": "Vitória sobre Sichon" },
    { "id": "dv008", "order": 8, "text": "Og é derrotado, as terras são dadas a Reuven, Gad e meia tribo de Menashe, e Yehoshua é encorajado.", "text_he": null, "refs": ["Deuteronomy 3:1-22"], "ref_start": "Deuteronomy 3:1", "ref_end": "Deuteronomy 3:22", "chapter": 3, "verse_start": 1, "verse_end": 22, "sefaria_ref": "Deuteronomy 3:1-22", "day_of_creation": null, "tags": ["og", "yehoshua", "transjordânia"], "topic": "Vitória sobre Og" }
