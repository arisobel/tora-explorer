  "facts": [
    { "id": "ktv001", "order": 1, "text": "Ao entrar na terra, Israel deve trazer os primeiros frutos ao lugar escolhido por Deus.", "text_he": null, "refs": ["Deuteronomy 26:1-4"], "ref_start": "Deuteronomy 26:1", "ref_end": "Deuteronomy 26:4", "chapter": 26, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Deuteronomy 26:1-4", "day_of_creation": null, "tags": ["bikkurim", "terra", "templo"], "topic": "Primeiros frutos" },
    { "id": "ktv002", "order": 2, "text": "A declaração dos bikkurim narra descida ao Egito, opressão, redenção e chegada à terra.", "text_he": null, "refs": ["Deuteronomy 26:5-11"], "ref_start": "Deuteronomy 26:5", "ref_end": "Deuteronomy 26:11", "chapter": 26, "verse_start": 5, "verse_end": 11, "sefaria_ref": "Deuteronomy 26:5-11", "day_of_creation": null, "tags": ["memória", "êxodo", "gratidão"], "topic": "Declaração histórica" },
    { "id": "ktv003", "order": 3, "text": "O dízimo do terceiro ano é destinado a levita, estrangeiro, órfão e viúva.", "text_he": null, "refs": ["Deuteronomy 26:12-15"], "ref_start": "Deuteronomy 26:12", "ref_end": "Deuteronomy 26:15", "chapter": 26, "verse_start": 12, "verse_end": 15, "sefaria_ref": "Deuteronomy 26:12-15", "day_of_creation": null, "tags": ["maaser", "pobres", "leviim"], "topic": "Dízimo social" },
    { "id": "ktv004", "order": 4, "text": "Israel declara Deus como seu Deus, e Deus declara Israel como povo especial.", "text_he": null, "refs": ["Deuteronomy 26:16-19"], "ref_start": "Deuteronomy 26:16", "ref_end": "Deuteronomy 26:19", "chapter": 26, "verse_start": 16, "verse_end": 19, "sefaria_ref": "Deuteronomy 26:16-19", "day_of_creation": null, "tags": ["aliança", "povo", "santidade"], "topic": "Declaração recíproca" },
    { "id": "ktv005", "order": 5, "text": "Pedras com a Torá escrita e um altar no monte Eival marcam a entrada na terra.", "text_he": null, "refs": ["Deuteronomy 27:1-10"], "ref_start": "Deuteronomy 27:1", "ref_end": "Deuteronomy 27:10", "chapter": 27, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Deuteronomy 27:1-10", "day_of_creation": null, "tags": ["eival", "altar", "torá"], "topic": "Torá em pedras" },
    { "id": "ktv006", "order": 6, "text": "Tribos são posicionadas em Gerizim e Eival para proclamar bênçãos e maldições da aliança.", "text_he": null, "refs": ["Deuteronomy 27:11-26"], "ref_start": "Deuteronomy 27:11", "ref_end": "Deuteronomy 27:26", "chapter": 27, "verse_start": 11, "verse_end": 26, "sefaria_ref": "Deuteronomy 27:11-26", "day_of_creation": null, "tags": ["gerizim", "eival", "maldições"], "topic": "Cerimônia da aliança" },
    { "id": "ktv007", "order": 7, "text": "As bênçãos descrevem prosperidade urbana, agrícola, familiar e militar quando Israel escuta Deus.", "text_he": null, "refs": ["Deuteronomy 28:1-14"], "ref_start": "Deuteronomy 28:1", "ref_end": "Deuteronomy 28:14", "chapter": 28, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Deuteronomy 28:1-14", "day_of_creation": null, "tags": ["bênçãos", "escuta", "prosperidade"], "topic": "Bênçãos da escuta" },
    { "id": "ktv008", "order": 8, "text": "As advertências da aliança descrevem perda, exílio e sofrimento quando Israel abandona a Torá.", "text_he": null, "refs": ["Deuteronomy 28:15-29:8"], "ref_start": "Deuteronomy 28:15", "ref_end": "Deuteronomy 29:8", "chapter": 28, "verse_start": 15, "verse_end_chapter": 29, "verse_end": 8, "sefaria_ref": "Deuteronomy 28:15-29:8", "day_of_creation": null, "tags": ["tochachah", "exílio", "advertência"], "topic": "Advertências da aliança" }
