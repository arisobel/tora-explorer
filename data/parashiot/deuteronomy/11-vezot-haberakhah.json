  "facts": [
    { "id": "vh001", "order": 1, "text": "Moshe é apresentado como homem de Deus antes de abençoar Israel.", "text_he": null, "refs": ["Deuteronomy 33:1-5"], "ref_start": "Deuteronomy 33:1", "ref_end": "Deuteronomy 33:5", "chapter": 33, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Deuteronomy 33:1-5", "day_of_creation": null, "tags": ["moshe", "bênção", "sinai"], "topic": "Abertura da bênção" },
    { "id": "vh002", "order": 2, "text": "Reuven, Yehudah e Levi recebem bênçãos que tratam de vida, liderança e serviço sagrado.", "text_he": null, "refs": ["Deuteronomy 33:6-11"], "ref_start": "Deuteronomy 33:6", "ref_end": "Deuteronomy 33:11", "chapter": 33, "verse_start": 6, "verse_end": 11, "sefaria_ref": "Deuteronomy 33:6-11", "day_of_creation": null, "tags": ["reuven", "yehudah", "levi"], "topic": "Primeiras tribos" },
    { "id": "vh003", "order": 3, "text": "Binyamin e Yosef recebem imagens de proteção, fertilidade e força.", "text_he": null, "refs": ["Deuteronomy 33:12-17"], "ref_start": "Deuteronomy 33:12", "ref_end": "Deuteronomy 33:17", "chapter": 33, "verse_start": 12, "verse_end": 17, "sefaria_ref": "Deuteronomy 33:12-17", "day_of_creation": null, "tags": ["binyamin", "yosef", "fertilidade"], "topic": "Binyamin e Yosef" },
    { "id": "vh004", "order": 4, "text": "Zevulun e Yissachar são ligados à alegria, tendas, comércio e montanha sagrada.", "text_he": null, "refs": ["Deuteronomy 33:18-19"], "ref_start": "Deuteronomy 33:18", "ref_end": "Deuteronomy 33:19", "chapter": 33, "verse_start": 18, "verse_end": 19, "sefaria_ref": "Deuteronomy 33:18-19", "day_of_creation": null, "tags": ["zevulun", "yissachar", "alegria"], "topic": "Zevulun e Yissachar" },
    { "id": "vh005", "order": 5, "text": "Gad, Dan, Naftali e Asher recebem bênçãos de expansão, força, favor e segurança.", "text_he": null, "refs": ["Deuteronomy 33:20-25"], "ref_start": "Deuteronomy 33:20", "ref_end": "Deuteronomy 33:25", "chapter": 33, "verse_start": 20, "verse_end": 25, "sefaria_ref": "Deuteronomy 33:20-25", "day_of_creation": null, "tags": ["gad", "dan", "naftali", "asher"], "topic": "Bênçãos finais das tribos" },
    { "id": "vh006", "order": 6, "text": "Moshe conclui exaltando Deus como refúgio de Israel e fonte de sua segurança.", "text_he": null, "refs": ["Deuteronomy 33:26-29"], "ref_start": "Deuteronomy 33:26", "ref_end": "Deuteronomy 33:29", "chapter": 33, "verse_start": 26, "verse_end": 29, "sefaria_ref": "Deuteronomy 33:26-29", "day_of_creation": null, "tags": ["refúgio", "israel", "segurança"], "topic": "Deus como refúgio" },
