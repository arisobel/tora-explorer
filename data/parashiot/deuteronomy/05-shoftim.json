  "facts": [
    { "id": "sf001", "order": 1, "text": "Juízes e oficiais devem ser colocados em todas as cidades para julgar com justiça, sem suborno.", "text_he": null, "refs": ["Deuteronomy 16:18-20"], "ref_start": "Deuteronomy 16:18", "ref_end": "Deuteronomy 16:20", "chapter": 16, "verse_start": 18, "verse_end": 20, "sefaria_ref": "Deuteronomy 16:18-20", "day_of_creation": null, "tags": ["juízes", "justiça", "suborno"], "topic": "Justiça local", "visual": { "marker_type": "icon", "icon": "scales", "asset": "assets/icons/scales.svg", "caption": "Tzedek tzedek tirdof", "importance": 5 } },
    { "id": "sf002", "order": 2, "text": "Idolatria é rejeitada, e casos difíceis sobem ao lugar escolhido para decisão dos cohanim e juízes.", "text_he": null, "refs": ["Deuteronomy 16:21-17:13"], "ref_start": "Deuteronomy 16:21", "ref_end": "Deuteronomy 17:13", "chapter": 16, "verse_start": 21, "verse_end_chapter": 17, "verse_end": 13, "sefaria_ref": "Deuteronomy 16:21-17:13", "day_of_creation": null, "tags": ["tribunal", "cohanim", "idolatria"], "topic": "Tribunal central" },
    { "id": "sf003", "order": 3, "text": "O futuro rei deve limitar cavalos, mulheres e riqueza, escrever uma Torá e governar com humildade.", "text_he": null, "refs": ["Deuteronomy 17:14-20"], "ref_start": "Deuteronomy 17:14", "ref_end": "Deuteronomy 17:20", "chapter": 17, "verse_start": 14, "verse_end": 20, "sefaria_ref": "Deuteronomy 17:14-20", "day_of_creation": null, "tags": ["rei", "torá", "humildade"], "topic": "Lei do rei", "visual": { "marker_type": "icon", "icon": "crown", "asset": "assets/icons/crown.svg", "caption": "A lei do rei", "importance": 4 } },
    { "id": "sf004", "order": 4, "text": "Cohanim e levitas recebem porções sagradas, pois Deus é sua herança.", "text_he": null, "refs": ["Deuteronomy 18:1-8"], "ref_start": "Deuteronomy 18:1", "ref_end": "Deuteronomy 18:8", "chapter": 18, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Deuteronomy 18:1-8", "day_of_creation": null, "tags": ["leviim", "cohanim", "herança"], "topic": "Herança levítica" },
    { "id": "sf005", "order": 5, "text": "Práticas mágicas das nações são proibidas, e Deus promete levantar profeta como Moshe.", "text_he": null, "refs": ["Deuteronomy 18:9-22"], "ref_start": "Deuteronomy 18:9", "ref_end": "Deuteronomy 18:22", "chapter": 18, "verse_start": 9, "verse_end": 22, "sefaria_ref": "Deuteronomy 18:9-22", "day_of_creation": null, "tags": ["profeta", "adivinhação", "moshe"], "topic": "Profecia verdadeira" },
    { "id": "sf006", "order": 6, "text": "Cidades de refúgio protegem quem matou sem intenção, enquanto homicídio deliberado não recebe abrigo.", "text_he": null, "refs": ["Deuteronomy 19:1-13"], "ref_start": "Deuteronomy 19:1", "ref_end": "Deuteronomy 19:13", "chapter": 19, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Deuteronomy 19:1-13", "day_of_creation": null, "tags": ["refúgio", "homicídio", "justiça"], "topic": "Cidades de refúgio", "visual": { "marker_type": "icon", "icon": "door", "asset": "assets/icons/door.svg", "caption": "As cidades de refúgio", "importance": 3 } },
    { "id": "sf007", "order": 7, "text": "Testemunhas falsas recebem a punição que pretendiam causar, protegendo a integridade do tribunal.", "text_he": null, "refs": ["Deuteronomy 19:14-21"], "ref_start": "Deuteronomy 19:14", "ref_end": "Deuteronomy 19:21", "chapter": 19, "verse_start": 14, "verse_end": 21, "sefaria_ref": "Deuteronomy 19:14-21", "day_of_creation": null, "tags": ["testemunhas", "falso", "tribunal"], "topic": "Testemunha falsa" },
    { "id": "sf008", "order": 8, "text": "As leis de guerra e a eglah arufah afirmam responsabilidade moral mesmo fora do tribunal comum.", "text_he": null, "refs": ["Deuteronomy 20:1-21:9"], "ref_start": "Deuteronomy 20:1", "ref_end": "Deuteronomy 21:9", "chapter": 20, "verse_start": 1, "verse_end_chapter": 21, "verse_end": 9, "sefaria_ref": "Deuteronomy 20:1-21:9", "day_of_creation": null, "tags": ["guerra", "eglah-arufah", "responsabilidade"], "topic": "Ética pública" }
