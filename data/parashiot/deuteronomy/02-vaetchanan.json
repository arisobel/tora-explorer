  "timeline": { "period_name": "Sinai, unidade divina e fidelidade", "anno_mundi_start": 2488, "anno_mundi_end": 2488, "era": "entrada-terra", "position_pct": 43, "description": "Moshe suplica para entrar na terra, relembra a revelação e ensina os fundamentos da fé e da aliança." },
  "summary": { "short": "Moshe relembra Sinai, ensina o Shema e adverte contra idolatria e esquecimento.", "medium": "Vaetchanan combina desejo pessoal de Moshe, advertência nacional e formulações centrais da fé judaica. Moshe não atravessará o Jordão, mas prepara Israel para viver a Torá dentro da terra.\n\nA parashá reconta Sinai, os Dez Mandamentos e o Shema. O foco é preservar memória, evitar idolatria, ensinar os filhos e amar Deus com todo coração.", "characters_main": ["Moshe", "Bnei Israel", "Yehoshua"], "characters_secondary": ["Filhos", "Nações", "Testemunhas"], "themes": ["Shema", "Sinai", "Dez Mandamentos", "Amor a Deus", "Idolatria"] },
