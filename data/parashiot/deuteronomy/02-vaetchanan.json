  "facts": [
    { "id": "ve001", "order": 1, "text": "Moshe suplica para atravessar o Jordão, mas Deus o instrui a subir e ver a terra de longe.", "text_he": null, "refs": ["Deuteronomy 3:23-29"], "ref_start": "Deuteronomy 3:23", "ref_end": "Deuteronomy 3:29", "chapter": 3, "verse_start": 23, "verse_end": 29, "sefaria_ref": "Deuteronomy 3:23-29", "day_of_creation": null, "tags": ["moshe", "súplica", "terra"], "topic": "Súplica de Moshe" },
    { "id": "ve002", "order": 2, "text": "Moshe exorta Israel a guardar as leis sem acrescentar nem diminuir, pois nelas está sua sabedoria diante das nações.", "text_he": null, "refs": ["Deuteronomy 4:1-14"], "ref_start": "Deuteronomy 4:1", "ref_end": "Deuteronomy 4:14", "chapter": 4, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Deuteronomy 4:1-14", "day_of_creation": null, "tags": ["mitzvot", "sabedoria", "nações"], "topic": "Guardar a Torá" },
    { "id": "ve003", "order": 3, "text": "A revelação sem imagem em Chorev fundamenta a proibição de idolatria e representação divina.", "text_he": null, "refs": ["Deuteronomy 4:15-31"], "ref_start": "Deuteronomy 4:15", "ref_end": "Deuteronomy 4:31", "chapter": 4, "verse_start": 15, "verse_end": 31, "sefaria_ref": "Deuteronomy 4:15-31", "day_of_creation": null, "tags": ["idolatria", "chorev", "imagem"], "topic": "Deus sem imagem" },
    { "id": "ve004", "order": 4, "text": "Moshe proclama que não há outro além de Deus, que tirou Israel do Egito e se revelou no fogo.", "text_he": null, "refs": ["Deuteronomy 4:32-40"], "ref_start": "Deuteronomy 4:32", "ref_end": "Deuteronomy 4:40", "chapter": 4, "verse_start": 32, "verse_end": 40, "sefaria_ref": "Deuteronomy 4:32-40", "day_of_creation": null, "tags": ["unicidade", "êxodo", "revelação"], "topic": "Unicidade divina" },
    { "id": "ve005", "order": 5, "text": "Três cidades de refúgio são separadas a leste do Jordão.", "text_he": null, "refs": ["Deuteronomy 4:41-49"], "ref_start": "Deuteronomy 4:41", "ref_end": "Deuteronomy 4:49", "chapter": 4, "verse_start": 41, "verse_end": 49, "sefaria_ref": "Deuteronomy 4:41-49", "day_of_creation": null, "tags": ["cidades-de-refúgio", "jordão", "justiça"], "topic": "Refúgio a leste" },
    { "id": "ve006", "order": 6, "text": "Moshe reconta os Dez Mandamentos, apresentando Sinai como aliança viva com a geração presente.", "text_he": null, "refs": ["Deuteronomy 5:1-30"], "ref_start": "Deuteronomy 5:1", "ref_end": "Deuteronomy 5:30", "chapter": 5, "verse_start": 1, "verse_end": 30, "sefaria_ref": "Deuteronomy 5:1-30", "day_of_creation": null, "tags": ["dez-mandamentos", "sinai", "aliança"], "topic": "Dez Mandamentos" },
    { "id": "ve007", "order": 7, "text": "O Shema declara a unidade de Deus e ordena amar Deus, ensinar os filhos e fixar as palavras no corpo e na casa.", "text_he": null, "refs": ["Deuteronomy 6:1-25"], "ref_start": "Deuteronomy 6:1", "ref_end": "Deuteronomy 6:25", "chapter": 6, "verse_start": 1, "verse_end": 25, "sefaria_ref": "Deuteronomy 6:1-25", "day_of_creation": null, "tags": ["shema", "amor", "educação"], "topic": "Shema e amor a Deus" },
    { "id": "ve008", "order": 8, "text": "Israel deve evitar alianças idolátricas com os povos da terra e lembrar que foi escolhido por amor e aliança.", "text_he": null, "refs": ["Deuteronomy 7:1-11"], "ref_start": "Deuteronomy 7:1", "ref_end": "Deuteronomy 7:11", "chapter": 7, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Deuteronomy 7:1-11", "day_of_creation": null, "tags": ["eleição", "aliança", "idolatria"], "topic": "Povo da aliança" }
