  "timeline": { "period_name": "Escolha, centralização e vida sagrada", "anno_mundi_start": 2488, "anno_mundi_end": 2488, "era": "entrada-terra", "position_pct": 43, "description": "Moshe apresenta bênção e maldição e organiza uma vida nacional em torno do lugar escolhido, justiça social e festas." },
  "summary": { "short": "Bênção e maldição, lugar escolhido, kashrut, tsedakah, shemitah e festas de peregrinação.", "medium": "Re'eh abre com uma escolha colocada diante de Israel: bênção ou maldição. A vida na terra deve se ordenar ao redor do lugar que Deus escolher para fazer habitar Seu nome.\n\nA parashá trata da destruição da idolatria, regras de consumo de carne, falsos profetas, kashrut, dízimos, shemitah, cuidado com pobres e as três festas de peregrinação.", "characters_main": ["Moshe", "Bnei Israel", "Leviim", "Pobres"], "characters_secondary": ["Falso profeta", "Servo hebreu", "Primogênitos"], "themes": ["Bênção e maldição", "Lugar escolhido", "Kashrut", "Tsedakah", "Festas"] },
  "facts": [
    { "id": "rh001", "order": 1, "text": "Moshe coloca diante de Israel bênção e maldição, associadas à escuta ou abandono dos mandamentos.", "text_he": null, "refs": ["Deuteronomy 11:26-32"], "ref_start": "Deuteronomy 11:26", "ref_end": "Deuteronomy 11:32", "chapter": 11, "verse_start": 26, "verse_end": 32, "sefaria_ref": "Deuteronomy 11:26-32", "day_of_creation": null, "tags": ["bênção", "maldição", "escolha"], "topic": "Escolha diante de Israel" },
    { "id": "rh002", "order": 2, "text": "Israel deve destruir lugares de idolatria e servir a Deus no lugar que Ele escolher.", "text_he": null, "refs": ["Deuteronomy 12:1-14"], "ref_start": "Deuteronomy 12:1", "ref_end": "Deuteronomy 12:14", "chapter": 12, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Deuteronomy 12:1-14", "day_of_creation": null, "tags": ["idolatria", "templo", "lugar-escolhido"], "topic": "Lugar escolhido" },
    { "id": "rh003", "order": 3, "text": "A carne comum pode ser comida fora do santuário, mas o sangue permanece proibido.", "text_he": null, "refs": ["Deuteronomy 12:15-28"], "ref_start": "Deuteronomy 12:15", "ref_end": "Deuteronomy 12:28", "chapter": 12, "verse_start": 15, "verse_end": 28, "sefaria_ref": "Deuteronomy 12:15-28", "day_of_creation": null, "tags": ["carne", "sangue", "santidade"], "topic": "Consumo e sangue" },
    { "id": "rh004", "order": 4, "text": "Falso profeta, sedutor familiar e cidade desviada não podem levar Israel a seguir outros deuses.", "text_he": null, "refs": ["Deuteronomy 13:1-19"], "ref_start": "Deuteronomy 13:1", "ref_end": "Deuteronomy 13:19", "chapter": 13, "verse_start": 1, "verse_end": 19, "sefaria_ref": "Deuteronomy 13:1-19", "day_of_creation": null, "tags": ["falso-profeta", "idolatria", "desvio"], "topic": "Proteção contra idolatria" },
    { "id": "rh005", "order": 5, "text": "As leis de kashrut distinguem animais permitidos e proibidos, marcando Israel como povo santo.", "text_he": null, "refs": ["Deuteronomy 14:1-21"], "ref_start": "Deuteronomy 14:1", "ref_end": "Deuteronomy 14:21", "chapter": 14, "verse_start": 1, "verse_end": 21, "sefaria_ref": "Deuteronomy 14:1-21", "day_of_creation": null, "tags": ["kashrut", "santidade", "alimentos"], "topic": "Kashrut" },
    { "id": "rh006", "order": 6, "text": "Dízimos sustentam o serviço, a alegria diante de Deus, os levitas e os vulneráveis.", "text_he": null, "refs": ["Deuteronomy 14:22-29"], "ref_start": "Deuteronomy 14:22", "ref_end": "Deuteronomy 14:29", "chapter": 14, "verse_start": 22, "verse_end": 29, "sefaria_ref": "Deuteronomy 14:22-29", "day_of_creation": null, "tags": ["maaser", "leviim", "pobres"], "topic": "Dízimos" },
    { "id": "rh007", "order": 7, "text": "A shemitah cancela dívidas e exige generosidade para que pobres não sejam abandonados.", "text_he": null, "refs": ["Deuteronomy 15:1-18"], "ref_start": "Deuteronomy 15:1", "ref_end": "Deuteronomy 15:18", "chapter": 15, "verse_start": 1, "verse_end": 18, "sefaria_ref": "Deuteronomy 15:1-18", "day_of_creation": null, "tags": ["shemitah", "dívidas", "pobreza"], "topic": "Shemitah e tsedakah" },
    { "id": "rh008", "order": 8, "text": "Pesach, Shavuot e Sukkot são apresentados como festas de peregrinação ao lugar escolhido.", "text_he": null, "refs": ["Deuteronomy 15:19-16:17"], "ref_start": "Deuteronomy 15:19", "ref_end": "Deuteronomy 16:17", "chapter": 15, "verse_start": 19, "verse_end_chapter": 16, "verse_end": 17, "sefaria_ref": "Deuteronomy 15:19-16:17", "day_of_creation": null, "tags": ["pesach", "shavuot", "sukkot"], "topic": "Festas de peregrinação" }
