  "facts": [
    { "id": "vl001", "order": 1, "text": "Moshe declara que tem 120 anos e não atravessará o Jordão.", "text_he": null, "refs": ["Deuteronomy 31:1-2"], "ref_start": "Deuteronomy 31:1", "ref_end": "Deuteronomy 31:2", "chapter": 31, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Deuteronomy 31:1-2", "day_of_creation": null, "tags": ["moshe", "120", "jordão"], "topic": "Fim da liderança de Moshe" },
    { "id": "vl002", "order": 2, "text": "Moshe encoraja Israel a ser forte, pois Deus passará à frente deles.", "text_he": null, "refs": ["Deuteronomy 31:3-6"], "ref_start": "Deuteronomy 31:3", "ref_end": "Deuteronomy 31:6", "chapter": 31, "verse_start": 3, "verse_end": 6, "sefaria_ref": "Deuteronomy 31:3-6", "day_of_creation": null, "tags": ["força", "coragem", "entrada"], "topic": "Força para o povo" },
    { "id": "vl003", "order": 3, "text": "Yehoshua é chamado diante de Israel e fortalecido para conduzir o povo à terra.", "text_he": null, "refs": ["Deuteronomy 31:7-8"], "ref_start": "Deuteronomy 31:7", "ref_end": "Deuteronomy 31:8", "chapter": 31, "verse_start": 7, "verse_end": 8, "sefaria_ref": "Deuteronomy 31:7-8", "day_of_creation": null, "tags": ["yehoshua", "sucessão", "coragem"], "topic": "Yehoshua fortalecido" },
    { "id": "vl004", "order": 4, "text": "Moshe escreve a Torá e a entrega aos cohanim, levitas e anciãos.", "text_he": null, "refs": ["Deuteronomy 31:9"], "ref_start": "Deuteronomy 31:9", "ref_end": "Deuteronomy 31:9", "chapter": 31, "verse_start": 9, "verse_end": 9, "sefaria_ref": "Deuteronomy 31:9", "day_of_creation": null, "tags": ["torá-escrita", "leviim", "anciãos"], "topic": "Torá entregue" },
    { "id": "vl005", "order": 5, "text": "A mitzvah de Hakhel ordena leitura pública da Torá a cada sete anos em Sukkot.", "text_he": null, "refs": ["Deuteronomy 31:10-13"], "ref_start": "Deuteronomy 31:10", "ref_end": "Deuteronomy 31:13", "chapter": 31, "verse_start": 10, "verse_end": 13, "sefaria_ref": "Deuteronomy 31:10-13", "day_of_creation": null, "tags": ["hakhel", "sukkot", "educação"], "topic": "Hakhel" },
    { "id": "vl006", "order": 6, "text": "Deus chama Moshe e Yehoshua à Tenda do Encontro e anuncia a futura infidelidade de Israel.", "text_he": null, "refs": ["Deuteronomy 31:14-18"], "ref_start": "Deuteronomy 31:14", "ref_end": "Deuteronomy 31:18", "chapter": 31, "verse_start": 14, "verse_end": 18, "sefaria_ref": "Deuteronomy 31:14-18", "day_of_creation": null, "tags": ["tenda", "infidelidade", "testemunho"], "topic": "Advertência divina" },
    { "id": "vl007", "order": 7, "text": "Moshe deve escrever um cântico para servir como testemunha quando Israel se desviar.", "text_he": null, "refs": ["Deuteronomy 31:19-22"], "ref_start": "Deuteronomy 31:19", "ref_end": "Deuteronomy 31:22", "chapter": 31, "verse_start": 19, "verse_end": 22, "sefaria_ref": "Deuteronomy 31:19-22", "day_of_creation": null, "tags": ["cântico", "testemunha", "memória"], "topic": "Cântico-testemunha" },
    { "id": "vl008", "order": 8, "text": "A Torá é colocada ao lado da arca, e Moshe reúne o povo para ouvir o cântico.", "text_he": null, "refs": ["Deuteronomy 31:23-30"], "ref_start": "Deuteronomy 31:23", "ref_end": "Deuteronomy 31:30", "chapter": 31, "verse_start": 23, "verse_end": 30, "sefaria_ref": "Deuteronomy 31:23-30", "day_of_creation": null, "tags": ["arca", "torá", "assembleia"], "topic": "Torá junto à arca" }
