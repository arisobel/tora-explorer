  "facts": [
    { "id": "ek001", "order": 1, "text": "A obediência à aliança traz amor, bênção, multiplicação e proteção na terra.", "text_he": null, "refs": ["Deuteronomy 7:12-26"], "ref_start": "Deuteronomy 7:12", "ref_end": "Deuteronomy 7:26", "chapter": 7, "verse_start": 12, "verse_end": 26, "sefaria_ref": "Deuteronomy 7:12-26", "day_of_creation": null, "tags": ["bênção", "aliança", "terra"], "topic": "Consequência da escuta" },
    { "id": "ek002", "order": 2, "text": "Moshe relembra o deserto e o maná para ensinar que a vida depende da palavra de Deus.", "text_he": null, "refs": ["Deuteronomy 8:1-10"], "ref_start": "Deuteronomy 8:1", "ref_end": "Deuteronomy 8:10", "chapter": 8, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Deuteronomy 8:1-10", "day_of_creation": null, "tags": ["maná", "deserto", "sustento"], "topic": "Maná e dependência" },
    { "id": "ek003", "order": 3, "text": "A abundância da terra exige cuidado para não esquecer Deus nem atribuir força à própria mão.", "text_he": null, "refs": ["Deuteronomy 8:11-20"], "ref_start": "Deuteronomy 8:11", "ref_end": "Deuteronomy 8:20", "chapter": 8, "verse_start": 11, "verse_end": 20, "sefaria_ref": "Deuteronomy 8:11-20", "day_of_creation": null, "tags": ["prosperidade", "esquecimento", "humildade"], "topic": "Perigo da abundância" },
    { "id": "ek004", "order": 4, "text": "Moshe afirma que Israel não recebe a terra por mérito próprio, mas pela promessa divina e maldade dos povos.", "text_he": null, "refs": ["Deuteronomy 9:1-6"], "ref_start": "Deuteronomy 9:1", "ref_end": "Deuteronomy 9:6", "chapter": 9, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Deuteronomy 9:1-6", "day_of_creation": null, "tags": ["mérito", "terra", "promessa"], "topic": "Não por mérito próprio" },
    { "id": "ek005", "order": 5, "text": "A rebelião do bezerro de ouro é recontada como exemplo de obstinação desde Chorev.", "text_he": null, "refs": ["Deuteronomy 9:7-29"], "ref_start": "Deuteronomy 9:7", "ref_end": "Deuteronomy 9:29", "chapter": 9, "verse_start": 7, "verse_end": 29, "sefaria_ref": "Deuteronomy 9:7-29", "day_of_creation": null, "tags": ["bezerro-de-ouro", "intercessão", "rebelião"], "topic": "Memória do bezerro" },
    { "id": "ek006", "order": 6, "text": "As segundas tábuas, a arca e a separação dos levitas mostram restauração após a crise.", "text_he": null, "refs": ["Deuteronomy 10:1-11"], "ref_start": "Deuteronomy 10:1", "ref_end": "Deuteronomy 10:11", "chapter": 10, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Deuteronomy 10:1-11", "day_of_creation": null, "tags": ["segundas-tábuas", "arca", "leviim"], "topic": "Restauração da aliança" },
    { "id": "ek007", "order": 7, "text": "Israel é chamado a temer, amar e servir a Deus, circuncidando o coração e amando o estrangeiro.", "text_he": null, "refs": ["Deuteronomy 10:12-22"], "ref_start": "Deuteronomy 10:12", "ref_end": "Deuteronomy 10:22", "chapter": 10, "verse_start": 12, "verse_end": 22, "sefaria_ref": "Deuteronomy 10:12-22", "day_of_creation": null, "tags": ["amor", "estrangeiro", "coração"], "topic": "Circuncidar o coração" },
