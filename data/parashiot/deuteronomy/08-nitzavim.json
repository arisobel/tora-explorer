  "timeline": { "period_name": "Aliança, retorno e escolha da vida", "anno_mundi_start": 2488, "anno_mundi_end": 2488, "era": "entrada-terra", "position_pct": 43, "description": "Toda Israel, incluindo gerações futuras, fica de pé diante da aliança e recebe a possibilidade de retorno." },
  "summary": { "short": "Toda a comunidade entra na aliança; teshuvah, escolha e vida são colocadas diante de Israel.", "medium": "Nitzavim reúne todos os níveis da comunidade diante de Deus: líderes, crianças, mulheres, estrangeiros e trabalhadores. A aliança inclui também quem não está fisicamente presente.\n\nMoshe descreve queda, exílio e retorno, afirmando que a Torá não está distante. A escolha entre vida e morte é apresentada como decisão concreta de amar Deus e seguir Seus caminhos.", "characters_main": ["Moshe", "Bnei Israel", "Gerações futuras"], "characters_secondary": ["Líderes", "Crianças", "Estrangeiros"], "themes": ["Aliança", "Teshuvah", "Escolha", "Vida", "Responsabilidade"] },
