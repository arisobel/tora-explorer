  "facts": [
    { "id": "nz001", "order": 1, "text": "Toda a comunidade fica de pé diante de Deus para entrar na aliança.", "text_he": null, "refs": ["Deuteronomy 29:9-14"], "ref_start": "Deuteronomy 29:9", "ref_end": "Deuteronomy 29:14", "chapter": 29, "verse_start": 9, "verse_end": 14, "sefaria_ref": "Deuteronomy 29:9-14", "day_of_creation": null, "tags": ["aliança", "comunidade", "todos"], "topic": "Todos de pé", "visual": { "marker_type": "icon", "icon": "covenant", "asset": "assets/icons/covenant.svg", "caption": "Nitzavim — todos diante de Deus", "importance": 5 } },
    { "id": "nz002", "order": 2, "text": "A aliança inclui também quem não está presente, projetando responsabilidade para gerações futuras.", "text_he": null, "refs": ["Deuteronomy 29:15-20"], "ref_start": "Deuteronomy 29:15", "ref_end": "Deuteronomy 29:20", "chapter": 29, "verse_start": 15, "verse_end": 20, "sefaria_ref": "Deuteronomy 29:15-20", "day_of_creation": null, "tags": ["gerações", "futuro", "responsabilidade"], "topic": "Gerações futuras" },
    { "id": "nz003", "order": 3, "text": "A idolatria secreta é comparada a raiz venenosa que ameaça toda a comunidade.", "text_he": null, "refs": ["Deuteronomy 29:21-28"], "ref_start": "Deuteronomy 29:21", "ref_end": "Deuteronomy 29:28", "chapter": 29, "verse_start": 21, "verse_end": 28, "sefaria_ref": "Deuteronomy 29:21-28", "day_of_creation": null, "tags": ["idolatria", "raiz", "exílio"], "topic": "Raiz venenosa" },
    { "id": "nz004", "order": 4, "text": "Coisas ocultas pertencem a Deus, mas as reveladas pertencem a Israel para cumprir a Torá.", "text_he": null, "refs": ["Deuteronomy 29:29"], "ref_start": "Deuteronomy 29:29", "ref_end": "Deuteronomy 29:29", "chapter": 29, "verse_start": 29, "verse_end": 29, "sefaria_ref": "Deuteronomy 29:29", "day_of_creation": null, "tags": ["oculto", "revelado", "torá"], "topic": "Oculto e revelado" },
    { "id": "nz005", "order": 5, "text": "Após bênção e maldição, Israel poderá retornar a Deus de todo coração, mesmo no exílio.", "text_he": null, "refs": ["Deuteronomy 30:1-5"], "ref_start": "Deuteronomy 30:1", "ref_end": "Deuteronomy 30:5", "chapter": 30, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Deuteronomy 30:1-5", "day_of_creation": null, "tags": ["teshuvah", "exílio", "retorno"], "topic": "Retorno do exílio" },
    { "id": "nz006", "order": 6, "text": "Deus circuncidará o coração de Israel para que ame a Deus e viva.", "text_he": null, "refs": ["Deuteronomy 30:6-10"], "ref_start": "Deuteronomy 30:6", "ref_end": "Deuteronomy 30:10", "chapter": 30, "verse_start": 6, "verse_end": 10, "sefaria_ref": "Deuteronomy 30:6-10", "day_of_creation": null, "tags": ["coração", "amor", "vida"], "topic": "Coração transformado" },
    { "id": "nz007", "order": 7, "text": "A Torá não está no céu nem além do mar; está próxima, na boca e no coração.", "text_he": null, "refs": ["Deuteronomy 30:11-14"], "ref_start": "Deuteronomy 30:11", "ref_end": "Deuteronomy 30:14", "chapter": 30, "verse_start": 11, "verse_end": 14, "sefaria_ref": "Deuteronomy 30:11-14", "day_of_creation": null, "tags": ["torá", "proximidade", "coração"], "topic": "Torá próxima" },
    { "id": "nz008", "order": 8, "text": "Moshe coloca vida e morte diante de Israel e chama o povo a escolher a vida.", "text_he": null, "refs": ["Deuteronomy 30:15-20"], "ref_start": "Deuteronomy 30:15", "ref_end": "Deuteronomy 30:20", "chapter": 30, "verse_start": 15, "verse_end": 20, "sefaria_ref": "Deuteronomy 30:15-20", "day_of_creation": null, "tags": ["vida", "morte", "escolha"], "topic": "Escolhe a vida", "visual": { "marker_type": "icon", "icon": "tree", "asset": "assets/icons/tree.svg", "caption": "Escolhe a vida", "importance": 5 } }
