  "facts": [
    { "id": "hz001", "order": 1, "text": "Moshe convoca céus e terra como testemunhas do cântico.", "text_he": null, "refs": ["Deuteronomy 32:1-3"], "ref_start": "Deuteronomy 32:1", "ref_end": "Deuteronomy 32:3", "chapter": 32, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Deuteronomy 32:1-3", "day_of_creation": null, "tags": ["céus", "terra", "testemunho"], "topic": "Chamado ao testemunho", "visual": { "marker_type": "icon", "icon": "harp", "asset": "assets/icons/harp.svg", "caption": "O cântico-testemunha", "importance": 5 } },
    { "id": "hz002", "order": 2, "text": "Deus é chamado de Rocha perfeita, justa e fiel, sem injustiça.", "text_he": null, "refs": ["Deuteronomy 32:4-6"], "ref_start": "Deuteronomy 32:4", "ref_end": "Deuteronomy 32:6", "chapter": 32, "verse_start": 4, "verse_end": 6, "sefaria_ref": "Deuteronomy 32:4-6", "day_of_creation": null, "tags": ["rocha", "justiça", "fidelidade"], "topic": "Deus como Rocha", "visual": { "marker_type": "icon", "icon": "mountains", "asset": "assets/icons/mountains.svg", "caption": "HaTzur — a Rocha", "importance": 4 } },
    { "id": "hz003", "order": 3, "text": "O cântico relembra a eleição de Israel e o cuidado divino no deserto.", "text_he": null, "refs": ["Deuteronomy 32:7-14"], "ref_start": "Deuteronomy 32:7", "ref_end": "Deuteronomy 32:14", "chapter": 32, "verse_start": 7, "verse_end": 14, "sefaria_ref": "Deuteronomy 32:7-14", "day_of_creation": null, "tags": ["memória", "deserto", "cuidado"], "topic": "Cuidado no deserto" },
    { "id": "hz004", "order": 4, "text": "Yeshurun engorda e abandona Deus, trocando a Rocha por deuses estranhos.", "text_he": null, "refs": ["Deuteronomy 32:15-18"], "ref_start": "Deuteronomy 32:15", "ref_end": "Deuteronomy 32:18", "chapter": 32, "verse_start": 15, "verse_end": 18, "sefaria_ref": "Deuteronomy 32:15-18", "day_of_creation": null, "tags": ["yeshurun", "idolatria", "ingratidão"], "topic": "Esquecimento na abundância" },
    { "id": "hz005", "order": 5, "text": "Deus oculta Sua face e permite sofrimento como resposta ao abandono da aliança.", "text_he": null, "refs": ["Deuteronomy 32:19-27"], "ref_start": "Deuteronomy 32:19", "ref_end": "Deuteronomy 32:27", "chapter": 32, "verse_start": 19, "verse_end": 27, "sefaria_ref": "Deuteronomy 32:19-27", "day_of_creation": null, "tags": ["hester-panim", "julgamento", "aliança"], "topic": "Ocultamento da face" },
    { "id": "hz006", "order": 6, "text": "A falta de discernimento de Israel é contrastada com a necessidade de compreender o fim das escolhas.", "text_he": null, "refs": ["Deuteronomy 32:28-35"], "ref_start": "Deuteronomy 32:28", "ref_end": "Deuteronomy 32:35", "chapter": 32, "verse_start": 28, "verse_end": 35, "sefaria_ref": "Deuteronomy 32:28-35", "day_of_creation": null, "tags": ["discernimento", "fim", "consequência"], "topic": "Falta de discernimento" },
    { "id": "hz007", "order": 7, "text": "Deus julgará Seu povo e se voltará contra os inimigos que se exaltaram.", "text_he": null, "refs": ["Deuteronomy 32:36-43"], "ref_start": "Deuteronomy 32:36", "ref_end": "Deuteronomy 32:43", "chapter": 32, "verse_start": 36, "verse_end": 43, "sefaria_ref": "Deuteronomy 32:36-43", "day_of_creation": null, "tags": ["restauração", "vingança", "nações"], "topic": "Restauração final" },
    { "id": "hz008", "order": 8, "text": "Moshe ordena que Israel coloque o cântico no coração, depois é chamado a subir ao monte Nevo.", "text_he": null, "refs": ["Deuteronomy 32:44-52"], "ref_start": "Deuteronomy 32:44", "ref_end": "Deuteronomy 32:52", "chapter": 32, "verse_start": 44, "verse_end": 52, "sefaria_ref": "Deuteronomy 32:44-52", "day_of_creation": null, "tags": ["nevo", "moshe", "coração"], "topic": "Última instrução" }
