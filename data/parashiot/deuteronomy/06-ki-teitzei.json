  "facts": [
    { "id": "ktz001", "order": 1, "text": "A lei da mulher capturada na guerra impõe limites ao poder do soldado e protege sua dignidade.", "text_he": null, "refs": ["Deuteronomy 21:10-14"], "ref_start": "Deuteronomy 21:10", "ref_end": "Deuteronomy 21:14", "chapter": 21, "verse_start": 10, "verse_end": 14, "sefaria_ref": "Deuteronomy 21:10-14", "day_of_creation": null, "tags": ["guerra", "dignidade", "família"], "topic": "Mulher cativa" },
    { "id": "ktz002", "order": 2, "text": "Leis de primogenitura e filho rebelde tratam de ordem familiar, herança e responsabilidade comunitária.", "text_he": null, "refs": ["Deuteronomy 21:15-23"], "ref_start": "Deuteronomy 21:15", "ref_end": "Deuteronomy 21:23", "chapter": 21, "verse_start": 15, "verse_end": 23, "sefaria_ref": "Deuteronomy 21:15-23", "day_of_creation": null, "tags": ["primogênito", "filho-rebelde", "família"], "topic": "Família e herança" },
    { "id": "ktz003", "order": 3, "text": "Devolver objetos perdidos, ajudar animal caído, fazer parapeito e evitar misturas expressam responsabilidade cotidiana.", "text_he": null, "refs": ["Deuteronomy 22:1-12"], "ref_start": "Deuteronomy 22:1", "ref_end": "Deuteronomy 22:12", "chapter": 22, "verse_start": 1, "verse_end": 12, "sefaria_ref": "Deuteronomy 22:1-12", "day_of_creation": null, "tags": ["achados", "segurança", "responsabilidade"], "topic": "Cuidado com o outro" },
    { "id": "ktz004", "order": 4, "text": "Leis sexuais e matrimoniais protegem casamento, consentimento e responsabilidade diante da comunidade.", "text_he": null, "refs": ["Deuteronomy 22:13-30"], "ref_start": "Deuteronomy 22:13", "ref_end": "Deuteronomy 22:30", "chapter": 22, "verse_start": 13, "verse_end": 30, "sefaria_ref": "Deuteronomy 22:13-30", "day_of_creation": null, "tags": ["casamento", "sexualidade", "justiça"], "topic": "Casamento e responsabilidade" },
    { "id": "ktz005", "order": 5, "text": "A santidade do acampamento regula exclusões, pureza, refúgio de escravo e rejeição de exploração cultual.", "text_he": null, "refs": ["Deuteronomy 23:1-19"], "ref_start": "Deuteronomy 23:1", "ref_end": "Deuteronomy 23:19", "chapter": 23, "verse_start": 1, "verse_end": 19, "sefaria_ref": "Deuteronomy 23:1-19", "day_of_creation": null, "tags": ["acampamento", "pureza", "santidade"], "topic": "Santidade do acampamento" },
    { "id": "ktz006", "order": 6, "text": "Votos, trabalho em campo alheio, divórcio e rematrimônio são regulados por limites éticos.", "text_he": null, "refs": ["Deuteronomy 23:20-24:4"], "ref_start": "Deuteronomy 23:20", "ref_end": "Deuteronomy 24:4", "chapter": 23, "verse_start": 20, "verse_end_chapter": 24, "verse_end": 4, "sefaria_ref": "Deuteronomy 23:20-24:4", "day_of_creation": null, "tags": ["votos", "divórcio", "limites"], "topic": "Limites pessoais" },
    { "id": "ktz007", "order": 7, "text": "Leis econômicas protegem recém-casado, devedor, trabalhador, estrangeiro, órfão e viúva.", "text_he": null, "refs": ["Deuteronomy 24:5-22"], "ref_start": "Deuteronomy 24:5", "ref_end": "Deuteronomy 24:22", "chapter": 24, "verse_start": 5, "verse_end": 22, "sefaria_ref": "Deuteronomy 24:5-22", "day_of_creation": null, "tags": ["trabalho", "pobreza", "justiça"], "topic": "Proteção econômica" },
