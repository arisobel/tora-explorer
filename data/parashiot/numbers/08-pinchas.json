  "facts": [
    { "id": "pn001", "order": 1, "text": "Pinchas recebe aliança de paz e sacerdócio por ter interrompido a profanação em Baal Peor.", "text_he": null, "refs": ["Numbers 25:10-15"], "ref_start": "Numbers 25:10", "ref_end": "Numbers 25:15", "chapter": 25, "verse_start": 10, "verse_end": 15, "sefaria_ref": "Numbers 25:10-15", "day_of_creation": null, "tags": ["pinchas", "aliança", "paz"], "topic": "Aliança de Pinchas", "visual": { "marker_type": "icon", "icon": "covenant", "asset": "assets/icons/covenant.svg", "caption": "A aliança de paz", "importance": 5 } },
    { "id": "pn002", "order": 2, "text": "Deus ordena hostilidade contra Midian por sua participação na sedução de Israel.", "text_he": null, "refs": ["Numbers 25:16-18"], "ref_start": "Numbers 25:16", "ref_end": "Numbers 25:18", "chapter": 25, "verse_start": 16, "verse_end": 18, "sefaria_ref": "Numbers 25:16-18", "day_of_creation": null, "tags": ["midian", "baal-peor", "conflito"], "topic": "Conflito com Midian" },
    { "id": "pn003", "order": 3, "text": "A nova geração é recenseada nas planícies de Moav, preparando a distribuição da terra.", "text_he": null, "refs": ["Numbers 26:1-65"], "ref_start": "Numbers 26:1", "ref_end": "Numbers 26:65", "chapter": 26, "verse_start": 1, "verse_end": 65, "sefaria_ref": "Numbers 26:1-65", "day_of_creation": null, "tags": ["censo", "moav", "nova-geração"], "topic": "Censo da nova geração" },
    { "id": "pn004", "order": 4, "text": "As filhas de Tzelofchad pedem herança no nome do pai, e Deus confirma seu direito.", "text_he": null, "refs": ["Numbers 27:1-11"], "ref_start": "Numbers 27:1", "ref_end": "Numbers 27:11", "chapter": 27, "verse_start": 1, "verse_end": 11, "sefaria_ref": "Numbers 27:1-11", "day_of_creation": null, "tags": ["bnot-tzelofchad", "herança", "justiça"], "topic": "Filhas de Tzelofchad", "visual": { "marker_type": "icon", "icon": "scales", "asset": "assets/icons/scales.svg", "caption": "As filhas de Tzelofchad", "importance": 4 } },
    { "id": "pn005", "order": 5, "text": "Moshe é instruído a subir e ver a terra, sabendo que não a atravessará por causa de Merivah.", "text_he": null, "refs": ["Numbers 27:12-14"], "ref_start": "Numbers 27:12", "ref_end": "Numbers 27:14", "chapter": 27, "verse_start": 12, "verse_end": 14, "sefaria_ref": "Numbers 27:12-14", "day_of_creation": null, "tags": ["moshe", "terra", "merivah"], "topic": "Moshe vê a terra" },
    { "id": "pn006", "order": 6, "text": "Moshe pede um sucessor para que a comunidade não fique como rebanho sem pastor; Yehoshua é nomeado.", "text_he": null, "refs": ["Numbers 27:15-23"], "ref_start": "Numbers 27:15", "ref_end": "Numbers 27:23", "chapter": 27, "verse_start": 15, "verse_end": 23, "sefaria_ref": "Numbers 27:15-23", "day_of_creation": null, "tags": ["yehoshua", "sucessão", "liderança"], "topic": "Nomeação de Yehoshua", "visual": { "marker_type": "icon", "icon": "banner", "asset": "assets/icons/banner.svg", "caption": "Yehoshua nomeado", "importance": 4 } },
    { "id": "pn007", "order": 7, "text": "As ofertas diárias, de Shabat, Rosh Chodesh e festas são organizadas como serviço público contínuo.", "text_he": null, "refs": ["Numbers 28:1-29:39"], "ref_start": "Numbers 28:1", "ref_end": "Numbers 29:39", "chapter": 28, "verse_start": 1, "verse_end_chapter": 29, "verse_end": 39, "sefaria_ref": "Numbers 28:1-29:39", "day_of_creation": null, "tags": ["tamid", "festas", "korbanot"], "topic": "Calendário de ofertas" },
