  "facts": [
    { "id": "blk001", "order": 1, "text": "Balak teme Israel após suas vitórias e envia mensageiros para contratar Bilam.", "text_he": null, "refs": ["Numbers 22:2-7"], "ref_start": "Numbers 22:2", "ref_end": "Numbers 22:7", "chapter": 22, "verse_start": 2, "verse_end": 7, "sefaria_ref": "Numbers 22:2-7", "day_of_creation": null, "tags": ["balak", "moav", "medo"], "topic": "Medo de Moav" },
    { "id": "blk002", "order": 2, "text": "Deus proíbe Bilam de amaldiçoar Israel, pois o povo é abençoado.", "text_he": null, "refs": ["Numbers 22:8-14"], "ref_start": "Numbers 22:8", "ref_end": "Numbers 22:14", "chapter": 22, "verse_start": 8, "verse_end": 14, "sefaria_ref": "Numbers 22:8-14", "day_of_creation": null, "tags": ["bilam", "bênção", "proibição"], "topic": "Israel abençoado" },
    { "id": "blk003", "order": 3, "text": "Bilam parte com os oficiais de Moav, mas o anjo bloqueia o caminho e a jumenta vê o perigo antes dele.", "text_he": null, "refs": ["Numbers 22:15-35"], "ref_start": "Numbers 22:15", "ref_end": "Numbers 22:35", "chapter": 22, "verse_start": 15, "verse_end": 35, "sefaria_ref": "Numbers 22:15-35", "day_of_creation": null, "tags": ["jumenta", "anjo", "bilam"], "topic": "Jumenta de Bilam" },
    { "id": "blk004", "order": 4, "text": "No primeiro altar, Bilam declara que não pode amaldiçoar quem Deus não amaldiçoou.", "text_he": null, "refs": ["Numbers 22:36-23:12"], "ref_start": "Numbers 22:36", "ref_end": "Numbers 23:12", "chapter": 22, "verse_start": 36, "verse_end_chapter": 23, "verse_end": 12, "sefaria_ref": "Numbers 22:36-23:12", "day_of_creation": null, "tags": ["oráculo", "bênção", "altar"], "topic": "Primeira bênção" },
    { "id": "blk005", "order": 5, "text": "No segundo oráculo, Bilam afirma que Deus não muda de palavra e vê força real em Israel.", "text_he": null, "refs": ["Numbers 23:13-26"], "ref_start": "Numbers 23:13", "ref_end": "Numbers 23:26", "chapter": 23, "verse_start": 13, "verse_end": 26, "sefaria_ref": "Numbers 23:13-26", "day_of_creation": null, "tags": ["oráculo", "rei", "força"], "topic": "Segunda bênção" },
    { "id": "blk006", "order": 6, "text": "Bilam contempla Israel acampado por tribos e pronuncia a bênção sobre suas tendas.", "text_he": null, "refs": ["Numbers 23:27-24:9"], "ref_start": "Numbers 23:27", "ref_end": "Numbers 24:9", "chapter": 23, "verse_start": 27, "verse_end_chapter": 24, "verse_end": 9, "sefaria_ref": "Numbers 23:27-24:9", "day_of_creation": null, "tags": ["tendas", "tribos", "bênção"], "topic": "Tendas de Israel", "visual": { "marker_type": "icon", "icon": "tent", "asset": "assets/icons/tent.svg", "caption": "Ma tovu ohalecha", "importance": 5 } },
    { "id": "blk007", "order": 7, "text": "Bilam profetiza sobre o futuro, incluindo uma estrela que sairá de Yaakov e poder sobre inimigos.", "text_he": null, "refs": ["Numbers 24:10-25"], "ref_start": "Numbers 24:10", "ref_end": "Numbers 24:25", "chapter": 24, "verse_start": 10, "verse_end": 25, "sefaria_ref": "Numbers 24:10-25", "day_of_creation": null, "tags": ["estrela", "yaakov", "futuro"], "topic": "Oráculos finais", "visual": { "marker_type": "icon", "icon": "star", "asset": "assets/icons/star.svg", "caption": "A estrela de Yaakov", "importance": 5 } },
    { "id": "blk008", "order": 8, "text": "Em Shitim, Israel se envolve com Baal Peor; a praga começa e Pinchas interrompe a crise com ação decisiva.", "text_he": null, "refs": ["Numbers 25:1-9"], "ref_start": "Numbers 25:1", "ref_end": "Numbers 25:9", "chapter": 25, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Numbers 25:1-9", "day_of_creation": null, "tags": ["baal-peor", "pinchas", "praga"], "topic": "Crise de Baal Peor" }
