  "identity": { "id": "bamidbar", "name": "Bamidbar", "name_pt": "No deserto", "hebrew": "בְּמִדְבַּר", "transliteration": "Bamidbar", "aliyot_count": 7 },
  "range": { "ref_start": "Numbers 1:1", "ref_end": "Numbers 4:20", "sefaria_ref": "Numbers 1:1-4:20", "chapters_covered": [1,2,3,4], "chapter_start": 1, "chapter_end": 4, "verse_start": 1, "verse_end_chapter": 4, "verse_end": 20 },
  "timeline": { "period_name": "Organização do acampamento", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "No segundo ano após a saída do Egito, Israel é contado e organizado como acampamento em torno do Mishkan." },
  "summary": { "short": "Israel é contado, organizado por tribos e posicionado ao redor do Mishkan.", "medium": "Bamidbar transforma a multidão que saiu do Egito em um acampamento ordenado. Cada tribo é contada, cada líder é nomeado e o Mishkan passa a ocupar o centro físico e simbólico da vida nacional.\n\nOs levitas são separados para o serviço sagrado em lugar dos primogênitos. O livro começa, portanto, com uma arquitetura de povo: tribos, bandeiras, funções, limites e proximidade com o sagrado.", "characters_main": ["Moshe", "Aharon", "Bnei Israel", "Leviim"], "characters_secondary": ["Nesiim", "Gershon", "Kehat", "Merari"], "themes": ["Censo", "Acampamento", "Tribos", "Mishkan", "Leviim"] },
  "facts": [
    { "id": "bm001", "order": 1, "text": "Deus ordena que Moshe e Aharon contem os homens de Israel por famílias e casas paternas.", "text_he": null, "refs": ["Numbers 1:1-19"], "ref_start": "Numbers 1:1", "ref_end": "Numbers 1:19", "chapter": 1, "verse_start": 1, "verse_end": 19, "sefaria_ref": "Numbers 1:1-19", "day_of_creation": null, "tags": ["censo", "tribos", "deserto"], "topic": "Censo nacional" },
    { "id": "bm002", "order": 2, "text": "Os resultados do censo são registrados por tribo, formando a contagem militar de Israel.", "text_he": null, "refs": ["Numbers 1:20-46"], "ref_start": "Numbers 1:20", "ref_end": "Numbers 1:46", "chapter": 1, "verse_start": 20, "verse_end": 46, "sefaria_ref": "Numbers 1:20-46", "day_of_creation": null, "tags": ["censo", "tribos", "exército"], "topic": "Tribos contadas" },
    { "id": "bm003", "order": 3, "text": "A tribo de Levi não é contada com as demais, pois recebe responsabilidade direta sobre o Mishkan.", "text_he": null, "refs": ["Numbers 1:47-54"], "ref_start": "Numbers 1:47", "ref_end": "Numbers 1:54", "chapter": 1, "verse_start": 47, "verse_end": 54, "sefaria_ref": "Numbers 1:47-54", "day_of_creation": null, "tags": ["leviim", "mishkan", "separação"], "topic": "Levi separado" },
    { "id": "bm004", "order": 4, "text": "O acampamento é disposto em quatro lados, com bandeiras e tribos ao redor da Tenda do Encontro.", "text_he": null, "refs": ["Numbers 2:1-34"], "ref_start": "Numbers 2:1", "ref_end": "Numbers 2:34", "chapter": 2, "verse_start": 1, "verse_end": 34, "sefaria_ref": "Numbers 2:1-34", "day_of_creation": null, "tags": ["acampamento", "bandeiras", "ordem"], "topic": "Mapa das tribos" },
    { "id": "bm005", "order": 5, "text": "A linhagem de Aharon é apresentada, incluindo Nadav e Avihu, e o serviço sacerdotal é delimitado.", "text_he": null, "refs": ["Numbers 3:1-4"], "ref_start": "Numbers 3:1", "ref_end": "Numbers 3:4", "chapter": 3, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Numbers 3:1-4", "day_of_creation": null, "tags": ["aharon", "cohanim", "nadav-avihu"], "topic": "Casa sacerdotal" },
    { "id": "bm006", "order": 6, "text": "Os levitas são dados a Aharon para servir no Mishkan e substituir os primogênitos de Israel.", "text_he": null, "refs": ["Numbers 3:5-13"], "ref_start": "Numbers 3:5", "ref_end": "Numbers 3:13", "chapter": 3, "verse_start": 5, "verse_end": 13, "sefaria_ref": "Numbers 3:5-13", "day_of_creation": null, "tags": ["leviim", "primogênitos", "serviço"], "topic": "Leviim no lugar dos primogênitos" },
    { "id": "bm007", "order": 7, "text": "As famílias levíticas de Gershon, Kehat e Merari recebem posições e responsabilidades distintas no transporte do Mishkan.", "text_he": null, "refs": ["Numbers 3:14-39"], "ref_start": "Numbers 3:14", "ref_end": "Numbers 3:39", "chapter": 3, "verse_start": 14, "verse_end": 39, "sefaria_ref": "Numbers 3:14-39", "day_of_creation": null, "tags": ["gershon", "kehat", "merari", "mishkan"], "topic": "Famílias levíticas" },
    { "id": "bm008", "order": 8, "text": "Os filhos de Kehat recebem instruções rigorosas para transportar os objetos mais sagrados sem vê-los descobertos.", "text_he": null, "refs": ["Numbers 4:1-20"], "ref_start": "Numbers 4:1", "ref_end": "Numbers 4:20", "chapter": 4, "verse_start": 1, "verse_end": 20, "sefaria_ref": "Numbers 4:1-20", "day_of_creation": null, "tags": ["kehat", "objetos sagrados", "limite"], "topic": "Kehat e o sagrado" }
  ],
