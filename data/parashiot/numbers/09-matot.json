  "facts": [
    { "id": "mt001", "order": 1, "text": "Moshe ensina aos chefes das tribos que votos e juramentos obrigam a pessoa a cumprir sua palavra.", "text_he": null, "refs": ["Numbers 30:2-17"], "ref_start": "Numbers 30:2", "ref_end": "Numbers 30:17", "chapter": 30, "verse_start": 2, "verse_end": 17, "sefaria_ref": "Numbers 30:2-17", "day_of_creation": null, "tags": ["votos", "fala", "compromisso"], "topic": "Leis de votos", "visual": { "marker_type": "icon", "icon": "scroll", "asset": "assets/icons/scroll.svg", "caption": "Os votos", "importance": 4 } },
    { "id": "mt002", "order": 2, "text": "Deus ordena a Moshe que vingue Israel de Midian antes de sua morte.", "text_he": null, "refs": ["Numbers 31:1-6"], "ref_start": "Numbers 31:1", "ref_end": "Numbers 31:6", "chapter": 31, "verse_start": 1, "verse_end": 6, "sefaria_ref": "Numbers 31:1-6", "day_of_creation": null, "tags": ["midian", "guerra", "pinchas"], "topic": "Guerra contra Midian" },
    { "id": "mt003", "order": 3, "text": "Os reis de Midian são derrotados e Bilam morre na guerra.", "text_he": null, "refs": ["Numbers 31:7-12"], "ref_start": "Numbers 31:7", "ref_end": "Numbers 31:12", "chapter": 31, "verse_start": 7, "verse_end": 12, "sefaria_ref": "Numbers 31:7-12", "day_of_creation": null, "tags": ["bilam", "midian", "julgamento"], "topic": "Derrota de Midian" },
    { "id": "mt004", "order": 4, "text": "Moshe repreende os oficiais por preservarem mulheres ligadas à sedução de Baal Peor.", "text_he": null, "refs": ["Numbers 31:13-24"], "ref_start": "Numbers 31:13", "ref_end": "Numbers 31:24", "chapter": 31, "verse_start": 13, "verse_end": 24, "sefaria_ref": "Numbers 31:13-24", "day_of_creation": null, "tags": ["baal-peor", "pureza", "repreensão"], "topic": "Acerto após a guerra" },
    { "id": "mt005", "order": 5, "text": "O espólio é contado e dividido entre combatentes, comunidade, cohanim e levitas.", "text_he": null, "refs": ["Numbers 31:25-54"], "ref_start": "Numbers 31:25", "ref_end": "Numbers 31:54", "chapter": 31, "verse_start": 25, "verse_end": 54, "sefaria_ref": "Numbers 31:25-54", "day_of_creation": null, "tags": ["espólio", "cohanim", "leviim"], "topic": "Divisão do espólio" },
    { "id": "mt006", "order": 6, "text": "Reuven e Gad pedem terras a leste do Jordão por causa de seus muitos rebanhos.", "text_he": null, "refs": ["Numbers 32:1-5"], "ref_start": "Numbers 32:1", "ref_end": "Numbers 32:5", "chapter": 32, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Numbers 32:1-5", "day_of_creation": null, "tags": ["reuven", "gad", "transjordânia"], "topic": "Pedido por terras a leste" },
    { "id": "mt007", "order": 7, "text": "Moshe teme que o pedido desanime Israel como os espiões fizeram, mas aceita quando as tribos prometem lutar primeiro.", "text_he": null, "refs": ["Numbers 32:6-32"], "ref_start": "Numbers 32:6", "ref_end": "Numbers 32:32", "chapter": 32, "verse_start": 6, "verse_end": 32, "sefaria_ref": "Numbers 32:6-32", "day_of_creation": null, "tags": ["responsabilidade", "espiões", "acordo"], "topic": "Compromisso de combate" },
    { "id": "mt008", "order": 8, "text": "As terras de Sichon e Og são atribuídas a Reuven, Gad e meia tribo de Menashe, que constroem cidades e currais.", "text_he": null, "refs": ["Numbers 32:33-42"], "ref_start": "Numbers 32:33", "ref_end": "Numbers 32:42", "chapter": 32, "verse_start": 33, "verse_end": 42, "sefaria_ref": "Numbers 32:33-42", "day_of_creation": null, "tags": ["menashe", "cidades", "herança"], "topic": "Herança transjordânica", "visual": { "marker_type": "icon", "icon": "mountains", "asset": "assets/icons/mountains.svg", "caption": "As terras a leste", "importance": 3 } }
