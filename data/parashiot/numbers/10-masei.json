  "facts": [
    { "id": "ms001", "order": 1, "text": "Moshe registra as jornadas de Israel desde a saída do Egito, etapa por etapa, conforme a ordem divina.", "text_he": null, "refs": ["Numbers 33:1-2"], "ref_start": "Numbers 33:1", "ref_end": "Numbers 33:2", "chapter": 33, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Numbers 33:1-2", "day_of_creation": null, "tags": ["jornadas", "memória", "moshe"], "topic": "Registro das jornadas", "visual": { "marker_type": "icon", "icon": "journey", "asset": "assets/icons/journey.svg", "caption": "As 42 jornadas", "importance": 5 } },
    { "id": "ms002", "order": 2, "text": "A lista percorre desde Ramsés e a saída do Egito até as etapas finais nas planícies de Moav.", "text_he": null, "refs": ["Numbers 33:3-49"], "ref_start": "Numbers 33:3", "ref_end": "Numbers 33:49", "chapter": 33, "verse_start": 3, "verse_end": 49, "sefaria_ref": "Numbers 33:3-49", "day_of_creation": null, "tags": ["ramsés", "moav", "deserto"], "topic": "Mapa do deserto" },
    { "id": "ms003", "order": 3, "text": "Israel recebe a ordem de expulsar os habitantes idólatras da terra e destruir seus objetos de culto.", "text_he": null, "refs": ["Numbers 33:50-56"], "ref_start": "Numbers 33:50", "ref_end": "Numbers 33:56", "chapter": 33, "verse_start": 50, "verse_end": 56, "sefaria_ref": "Numbers 33:50-56", "day_of_creation": null, "tags": ["terra", "idolatria", "conquista"], "topic": "Mandato de ocupação" },
    { "id": "ms004", "order": 4, "text": "As fronteiras da terra de Canaã são definidas para a futura herança de Israel.", "text_he": null, "refs": ["Numbers 34:1-15"], "ref_start": "Numbers 34:1", "ref_end": "Numbers 34:15", "chapter": 34, "verse_start": 1, "verse_end": 15, "sefaria_ref": "Numbers 34:1-15", "day_of_creation": null, "tags": ["fronteiras", "canaã", "herança"], "topic": "Fronteiras da terra" },
    { "id": "ms005", "order": 5, "text": "Elazar, Yehoshua e líderes tribais são nomeados para distribuir a terra.", "text_he": null, "refs": ["Numbers 34:16-29"], "ref_start": "Numbers 34:16", "ref_end": "Numbers 34:29", "chapter": 34, "verse_start": 16, "verse_end": 29, "sefaria_ref": "Numbers 34:16-29", "day_of_creation": null, "tags": ["elazar", "yehoshua", "liderança"], "topic": "Responsáveis pela divisão" },
    { "id": "ms006", "order": 6, "text": "Os levitas recebem cidades e arredores em meio às tribos, pois não possuem território tribal próprio.", "text_he": null, "refs": ["Numbers 35:1-8"], "ref_start": "Numbers 35:1", "ref_end": "Numbers 35:8", "chapter": 35, "verse_start": 1, "verse_end": 8, "sefaria_ref": "Numbers 35:1-8", "day_of_creation": null, "tags": ["leviim", "cidades", "herança"], "topic": "Cidades levíticas" },
    { "id": "ms007", "order": 7, "text": "Cidades de refúgio são estabelecidas para diferenciar homicídio intencional de morte acidental.", "text_he": null, "refs": ["Numbers 35:9-34"], "ref_start": "Numbers 35:9", "ref_end": "Numbers 35:34", "chapter": 35, "verse_start": 9, "verse_end": 34, "sefaria_ref": "Numbers 35:9-34", "day_of_creation": null, "tags": ["cidades-de-refúgio", "justiça", "homicídio"], "topic": "Cidades de refúgio", "visual": { "marker_type": "icon", "icon": "door", "asset": "assets/icons/door.svg", "caption": "As cidades de refúgio", "importance": 4 } },
    { "id": "ms008", "order": 8, "text": "As filhas de Tzelofchad casam dentro de sua tribo, preservando a herança familiar sem transferi-la a outra tribo.", "text_he": null, "refs": ["Numbers 36:1-13"], "ref_start": "Numbers 36:1", "ref_end": "Numbers 36:13", "chapter": 36, "verse_start": 1, "verse_end": 13, "sefaria_ref": "Numbers 36:1-13", "day_of_creation": null, "tags": ["bnot-tzelofchad", "herança", "tribos"], "topic": "Herança de Tzelofchad" }
