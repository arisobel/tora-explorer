  "facts": [
    { "id": "kr001", "order": 1, "text": "Korach, Datan, Aviram e 250 líderes se levantam contra Moshe e Aharon.", "text_he": null, "refs": ["Numbers 16:1-3"], "ref_start": "Numbers 16:1", "ref_end": "Numbers 16:3", "chapter": 16, "verse_start": 1, "verse_end": 3, "sefaria_ref": "Numbers 16:1-3", "day_of_creation": null, "tags": ["korach", "rebelião", "liderança"], "topic": "Coalizão rebelde" },
    { "id": "kr002", "order": 2, "text": "Moshe propõe o teste dos incensários, deixando que Deus revele quem está escolhido para se aproximar.", "text_he": null, "refs": ["Numbers 16:4-11"], "ref_start": "Numbers 16:4", "ref_end": "Numbers 16:11", "chapter": 16, "verse_start": 4, "verse_end": 11, "sefaria_ref": "Numbers 16:4-11", "day_of_creation": null, "tags": ["incenso", "escolha", "teste"], "topic": "Teste dos incensários", "visual": { "marker_type": "icon", "icon": "fire", "asset": "assets/icons/fire.svg", "caption": "Os incensários", "importance": 5 } },
    { "id": "kr003", "order": 3, "text": "Datan e Aviram recusam subir e acusam Moshe de tê-los tirado de uma terra boa para morrer no deserto.", "text_he": null, "refs": ["Numbers 16:12-15"], "ref_start": "Numbers 16:12", "ref_end": "Numbers 16:15", "chapter": 16, "verse_start": 12, "verse_end": 15, "sefaria_ref": "Numbers 16:12-15", "day_of_creation": null, "tags": ["datan", "aviram", "acusação"], "topic": "Recusa de Datan e Aviram" },
    { "id": "kr004", "order": 4, "text": "A terra se abre e engole Korach, Datan, Aviram e suas casas, sinalizando o julgamento divino.", "text_he": null, "refs": ["Numbers 16:16-35"], "ref_start": "Numbers 16:16", "ref_end": "Numbers 16:35", "chapter": 16, "verse_start": 16, "verse_end": 35, "sefaria_ref": "Numbers 16:16-35", "day_of_creation": null, "tags": ["julgamento", "terra", "rebeldes"], "topic": "Abertura da terra", "visual": { "marker_type": "icon", "icon": "mountains", "asset": "assets/icons/mountains.svg", "caption": "A terra se abre", "importance": 4 } },
    { "id": "kr005", "order": 5, "text": "Os incensários dos rebeldes são transformados em revestimento do altar, memorial contra aproximação indevida.", "text_he": null, "refs": ["Numbers 17:1-5"], "ref_start": "Numbers 17:1", "ref_end": "Numbers 17:5", "chapter": 17, "verse_start": 1, "verse_end": 5, "sefaria_ref": "Numbers 17:1-5", "day_of_creation": null, "tags": ["incensários", "altar", "memorial"], "topic": "Memorial no altar" },
    { "id": "kr006", "order": 6, "text": "O povo acusa Moshe e Aharon, uma praga começa, e Aharon corre com incenso para deter a mortandade.", "text_he": null, "refs": ["Numbers 17:6-15"], "ref_start": "Numbers 17:6", "ref_end": "Numbers 17:15", "chapter": 17, "verse_start": 6, "verse_end": 15, "sefaria_ref": "Numbers 17:6-15", "day_of_creation": null, "tags": ["praga", "aharon", "incenso"], "topic": "Aharon detém a praga" },
    { "id": "kr007", "order": 7, "text": "A vara de Aharon floresce entre as varas das tribos, confirmando a escolha sacerdotal.", "text_he": null, "refs": ["Numbers 17:16-28"], "ref_start": "Numbers 17:16", "ref_end": "Numbers 17:28", "chapter": 17, "verse_start": 16, "verse_end": 28, "sefaria_ref": "Numbers 17:16-28", "day_of_creation": null, "tags": ["vara", "aharon", "sacerdócio"], "topic": "Vara florescida", "visual": { "marker_type": "icon", "icon": "staff", "asset": "assets/icons/staff.svg", "caption": "A vara de Aharon floresce", "importance": 4 } },
