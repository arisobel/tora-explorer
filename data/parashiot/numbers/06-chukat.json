  "summary": { "short": "A novilha vermelha, a morte de Miriam e Aharon, as águas de Merivah e as primeiras vitórias no caminho.", "medium": "Chukat começa com a lei da novilha vermelha, um estatuto ligado à purificação da impureza da morte. A narrativa então avança para o fim dos quarenta anos, quando Miriam morre e a água falta novamente.\n\nMoshe fere a rocha nas águas de Merivah, e a entrada dele e de Aharon na terra é negada. Aharon morre no monte Hor, Israel enfrenta Edom, as serpentes e os reis Sichon e Og, abrindo o caminho para as planícies de Moav.", "characters_main": ["Moshe", "Aharon", "Miriam", "Bnei Israel"], "characters_secondary": ["Edom", "Sichon", "Og", "Elazar"], "themes": ["Purificação", "Morte", "Água", "Liderança", "Conquista"] },
  "facts": [
    { "id": "chk001", "order": 1, "text": "A lei da parah adumah estabelece a purificação de quem entra em contato com a morte.", "text_he": null, "refs": ["Numbers 19:1-22"], "ref_start": "Numbers 19:1", "ref_end": "Numbers 19:22", "chapter": 19, "verse_start": 1, "verse_end": 22, "sefaria_ref": "Numbers 19:1-22", "day_of_creation": null, "tags": ["parah-adumah", "pureza", "morte"], "topic": "Novilha vermelha" },
    { "id": "chk002", "order": 2, "text": "Miriam morre em Kadesh, e a falta de água retorna como teste para o povo e para a liderança.", "text_he": null, "refs": ["Numbers 20:1-2"], "ref_start": "Numbers 20:1", "ref_end": "Numbers 20:2", "chapter": 20, "verse_start": 1, "verse_end": 2, "sefaria_ref": "Numbers 20:1-2", "day_of_creation": null, "tags": ["miriam", "kadesh", "água"], "topic": "Morte de Miriam" },
    { "id": "chk003", "order": 3, "text": "Nas águas de Merivah, Moshe fere a rocha; Deus declara que Moshe e Aharon não conduzirão o povo à terra.", "text_he": null, "refs": ["Numbers 20:3-13"], "ref_start": "Numbers 20:3", "ref_end": "Numbers 20:13", "chapter": 20, "verse_start": 3, "verse_end": 13, "sefaria_ref": "Numbers 20:3-13", "day_of_creation": null, "tags": ["merivah", "rocha", "liderança"], "topic": "Águas de Merivah" },
    { "id": "chk004", "order": 4, "text": "Edom recusa a passagem de Israel por seu território, obrigando o povo a contornar a região.", "text_he": null, "refs": ["Numbers 20:14-21"], "ref_start": "Numbers 20:14", "ref_end": "Numbers 20:21", "chapter": 20, "verse_start": 14, "verse_end": 21, "sefaria_ref": "Numbers 20:14-21", "day_of_creation": null, "tags": ["edom", "jornada", "fronteira"], "topic": "Recusa de Edom" },
    { "id": "chk005", "order": 5, "text": "Aharon sobe ao monte Hor, suas vestes são passadas a Elazar, e Aharon morre ali.", "text_he": null, "refs": ["Numbers 20:22-29"], "ref_start": "Numbers 20:22", "ref_end": "Numbers 20:29", "chapter": 20, "verse_start": 22, "verse_end": 29, "sefaria_ref": "Numbers 20:22-29", "day_of_creation": null, "tags": ["aharon", "elazar", "monte-hor"], "topic": "Morte de Aharon" },
    { "id": "chk006", "order": 6, "text": "Após queixas no caminho, serpentes venenosas atacam o povo; a serpente de cobre torna-se sinal de cura para quem olha para ela.", "text_he": null, "refs": ["Numbers 21:4-9"], "ref_start": "Numbers 21:4", "ref_end": "Numbers 21:9", "chapter": 21, "verse_start": 4, "verse_end": 9, "sefaria_ref": "Numbers 21:4-9", "day_of_creation": null, "tags": ["serpentes", "cura", "queixa"], "topic": "Serpente de cobre" },
    { "id": "chk007", "order": 7, "text": "Israel canta pelo poço, celebrando a água como dom renovado durante a jornada.", "text_he": null, "refs": ["Numbers 21:16-20"], "ref_start": "Numbers 21:16", "ref_end": "Numbers 21:20", "chapter": 21, "verse_start": 16, "verse_end": 20, "sefaria_ref": "Numbers 21:16-20", "day_of_creation": null, "tags": ["poço", "cântico", "água"], "topic": "Cântico do poço" },
    { "id": "chk008", "order": 8, "text": "Israel derrota Sichon e Og, conquistando territórios a leste do Jordão e chegando às planícies de Moav.", "text_he": null, "refs": ["Numbers 21:21-22:1"], "ref_start": "Numbers 21:21", "ref_end": "Numbers 22:1", "chapter": 21, "verse_start": 21, "verse_end_chapter": 22, "verse_end": 1, "sefaria_ref": "Numbers 21:21-22:1", "day_of_creation": null, "tags": ["sichon", "og", "moav"], "topic": "Vitórias a leste do Jordão" }
