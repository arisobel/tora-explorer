  "facts": [
    { "id": "bhlt001", "order": 1, "text": "Aharon acende a menorah, e suas lâmpadas iluminam diante dela conforme a ordem divina.", "text_he": null, "refs": ["Numbers 8:1-4"], "ref_start": "Numbers 8:1", "ref_end": "Numbers 8:4", "chapter": 8, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Numbers 8:1-4", "day_of_creation": null, "tags": ["menorah", "aharon", "luz"], "topic": "Acendimento da menorah" },
    { "id": "bhlt002", "order": 2, "text": "Os levitas são purificados e consagrados para servir no lugar dos primogênitos de Israel.", "text_he": null, "refs": ["Numbers 8:5-26"], "ref_start": "Numbers 8:5", "ref_end": "Numbers 8:26", "chapter": 8, "verse_start": 5, "verse_end": 26, "sefaria_ref": "Numbers 8:5-26", "day_of_creation": null, "tags": ["leviim", "purificação", "serviço"], "topic": "Consagração dos levitas" },
    { "id": "bhlt003", "order": 3, "text": "Israel celebra o segundo Pesach no deserto, e Deus institui Pesach Sheni para quem estava impuro ou distante.", "text_he": null, "refs": ["Numbers 9:1-14"], "ref_start": "Numbers 9:1", "ref_end": "Numbers 9:14", "chapter": 9, "verse_start": 1, "verse_end": 14, "sefaria_ref": "Numbers 9:1-14", "day_of_creation": null, "tags": ["pesach", "pesach-sheni", "inclusão"], "topic": "Pesach Sheni" },
    { "id": "bhlt004", "order": 4, "text": "A nuvem sobre o Mishkan guia cada parada e partida, tornando a jornada dependente da presença divina.", "text_he": null, "refs": ["Numbers 9:15-23"], "ref_start": "Numbers 9:15", "ref_end": "Numbers 9:23", "chapter": 9, "verse_start": 15, "verse_end": 23, "sefaria_ref": "Numbers 9:15-23", "day_of_creation": null, "tags": ["nuvem", "mishkan", "jornada"], "topic": "Nuvem orientadora" },
    { "id": "bhlt005", "order": 5, "text": "As trombetas de prata são criadas para convocar a assembleia, ordenar a marcha e marcar guerra e festas.", "text_he": null, "refs": ["Numbers 10:1-10"], "ref_start": "Numbers 10:1", "ref_end": "Numbers 10:10", "chapter": 10, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Numbers 10:1-10", "day_of_creation": null, "tags": ["trombetas", "ordem", "assembleia"], "topic": "Trombetas de prata" },
    { "id": "bhlt006", "order": 6, "text": "O acampamento parte do Sinai em ordem, com a arca da aliança indo diante deles na jornada.", "text_he": null, "refs": ["Numbers 10:11-36"], "ref_start": "Numbers 10:11", "ref_end": "Numbers 10:36", "chapter": 10, "verse_start": 11, "verse_end": 36, "sefaria_ref": "Numbers 10:11-36", "day_of_creation": null, "tags": ["partida", "sinai", "arca"], "topic": "Partida do Sinai" },
    { "id": "bhlt007", "order": 7, "text": "O povo reclama, deseja carne e relembra o Egito; Moshe expressa o peso da liderança, e setenta anciãos recebem espírito.", "text_he": null, "refs": ["Numbers 11:1-35"], "ref_start": "Numbers 11:1", "ref_end": "Numbers 11:35", "chapter": 11, "verse_start": 1, "verse_end": 35, "sefaria_ref": "Numbers 11:1-35", "day_of_creation": null, "tags": ["queixa", "codornizes", "anciãos"], "topic": "Queixa e liderança compartilhada" },
    { "id": "bhlt008", "order": 8, "text": "Miriam e Aharon falam contra Moshe; Deus defende a singularidade profética de Moshe e Miriam é atingida por tzaraat.", "text_he": null, "refs": ["Numbers 12:1-16"], "ref_start": "Numbers 12:1", "ref_end": "Numbers 12:16", "chapter": 12, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Numbers 12:1-16", "day_of_creation": null, "tags": ["miriam", "aharon", "moshe", "tzaraat"], "topic": "Fala contra Moshe" }
