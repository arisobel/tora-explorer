  "range": { "ref_start": "Numbers 13:1", "ref_end": "Numbers 15:41", "sefaria_ref": "Numbers 13:1-15:41", "chapters_covered": [13,14,15], "chapter_start": 13, "chapter_end": 15, "verse_start": 1, "verse_end_chapter": 15, "verse_end": 41 },
  "timeline": { "period_name": "Crise dos espiões", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "A missão dos espiões transforma a aproximação à terra em crise de confiança e determina o destino da geração do deserto." },
  "summary": { "short": "Os espiões exploram Canaã, o povo recua com medo e a geração do deserto recebe sua sentença.", "medium": "Shelach é o ponto de ruptura da primeira geração. Os representantes das tribos veem a terra, confirmam sua fertilidade, mas interpretam seus habitantes como ameaça impossível.\n\nCalev e Yehoshua tentam reorientar o povo para confiança, porém a comunidade chora, deseja voltar ao Egito e rejeita a entrada. A resposta divina transforma quarenta dias de exploração em quarenta anos de jornada.", "characters_main": ["Moshe", "Aharon", "Yehoshua", "Calev", "Meraglim"], "characters_secondary": ["Bnei Israel", "Canaanim"], "themes": ["Terra prometida", "Medo", "Confiança", "Calev", "Tzitzit"] },
  "facts": [
    { "id": "sl001", "order": 1, "text": "Deus permite que Moshe envie líderes tribais para explorar a terra de Canaã.", "text_he": null, "refs": ["Numbers 13:1-16"], "ref_start": "Numbers 13:1", "ref_end": "Numbers 13:16", "chapter": 13, "verse_start": 1, "verse_end": 16, "sefaria_ref": "Numbers 13:1-16", "day_of_creation": null, "tags": ["espiões", "tribos", "canaã"], "topic": "Envio dos espiões" },
    { "id": "sl002", "order": 2, "text": "Moshe instrui os espiões a observar o povo, as cidades, a terra e seus frutos.", "text_he": null, "refs": ["Numbers 13:17-20"], "ref_start": "Numbers 13:17", "ref_end": "Numbers 13:20", "chapter": 13, "verse_start": 17, "verse_end": 20, "sefaria_ref": "Numbers 13:17-20", "day_of_creation": null, "tags": ["missão", "observação", "terra"], "topic": "Instruções da missão" },
    { "id": "sl003", "order": 3, "text": "Os espiões retornam com frutos da terra depois de quarenta dias, mostrando sua fertilidade.", "text_he": null, "refs": ["Numbers 13:21-25"], "ref_start": "Numbers 13:21", "ref_end": "Numbers 13:25", "chapter": 13, "verse_start": 21, "verse_end": 25, "sefaria_ref": "Numbers 13:21-25", "day_of_creation": null, "tags": ["frutos", "uvas", "quarenta-dias"], "topic": "Frutos de Canaã" },
    { "id": "sl004", "order": 4, "text": "A maioria reconhece que a terra mana leite e mel, mas descreve seus habitantes como fortes e intransponíveis.", "text_he": null, "refs": ["Numbers 13:26-33"], "ref_start": "Numbers 13:26", "ref_end": "Numbers 13:33", "chapter": 13, "verse_start": 26, "verse_end": 33, "sefaria_ref": "Numbers 13:26-33", "day_of_creation": null, "tags": ["relatório", "medo", "gigantes"], "topic": "Relatório negativo" },
    { "id": "sl005", "order": 5, "text": "O povo chora, deseja voltar ao Egito e ameaça substituir Moshe, enquanto Calev e Yehoshua defendem a entrada na terra.", "text_he": null, "refs": ["Numbers 14:1-10"], "ref_start": "Numbers 14:1", "ref_end": "Numbers 14:10", "chapter": 14, "verse_start": 1, "verse_end": 10, "sefaria_ref": "Numbers 14:1-10", "day_of_creation": null, "tags": ["rebelião", "calev", "yehoshua"], "topic": "Reação do povo" },
    { "id": "sl006", "order": 6, "text": "Moshe intercede, invocando os atributos de misericórdia para evitar destruição imediata do povo.", "text_he": null, "refs": ["Numbers 14:11-20"], "ref_start": "Numbers 14:11", "ref_end": "Numbers 14:20", "chapter": 14, "verse_start": 11, "verse_end": 20, "sefaria_ref": "Numbers 14:11-20", "day_of_creation": null, "tags": ["intercessão", "misericórdia", "moshe"], "topic": "Intercessão de Moshe" },
    { "id": "sl007", "order": 7, "text": "A geração adulta é sentenciada a morrer no deserto, e os quarenta dias da missão tornam-se quarenta anos de jornada.", "text_he": null, "refs": ["Numbers 14:21-45"], "ref_start": "Numbers 14:21", "ref_end": "Numbers 14:45", "chapter": 14, "verse_start": 21, "verse_end": 45, "sefaria_ref": "Numbers 14:21-45", "day_of_creation": null, "tags": ["quarenta-anos", "sentença", "deserto"], "topic": "Sentença da geração" },
    { "id": "sl008", "order": 8, "text": "Após leis de ofertas, challah e erro comunitário, a parashá conclui com o mandamento de tzitzit para lembrar os mandamentos.", "text_he": null, "refs": ["Numbers 15:1-41"], "ref_start": "Numbers 15:1", "ref_end": "Numbers 15:41", "chapter": 15, "verse_start": 1, "verse_end": 41, "sefaria_ref": "Numbers 15:1-41", "day_of_creation": null, "tags": ["ofertas", "challah", "tzitzit"], "topic": "Memória dos mandamentos" }
