  "timeline": { "period_name": "Pureza, bênção e inauguração", "anno_mundi_start": 2449, "anno_mundi_end": 2449, "era": "saida-egito", "position_pct": 42, "description": "A organização do acampamento se aprofunda com serviço levítico, leis sociais e rituais, bênção sacerdotal e ofertas dos líderes." },
  "summary": { "short": "Serviço dos levitas, leis de pureza, sotah, nazir, bênção sacerdotal e ofertas dos líderes.", "medium": "Nasso amplia a estrutura do acampamento. As famílias levíticas recebem tarefas, a pureza do espaço comunitário é preservada e danos sociais exigem confissão e reparação.\n\nA parashá também traz a sotah, o nazir, a bênção sacerdotal e as ofertas dos líderes tribais. O acampamento aparece como espaço em que corpo, fala, voto, família, liderança e presença divina se conectam.", "characters_main": ["Moshe", "Aharon", "Leviim", "Nesiim"], "characters_secondary": ["Sotah", "Nazir", "Cohanim"], "themes": ["Pureza", "Reparação", "Nazir", "Bênção sacerdotal", "Inauguração"] },
  "facts": [
    { "id": "ns001", "order": 1, "text": "Gershon e Merari são contados e recebem suas tarefas no transporte das cortinas, estruturas e utensílios do Mishkan.", "text_he": null, "refs": ["Numbers 4:21-49"], "ref_start": "Numbers 4:21", "ref_end": "Numbers 4:49", "chapter": 4, "verse_start": 21, "verse_end": 49, "sefaria_ref": "Numbers 4:21-49", "day_of_creation": null, "tags": ["leviim", "gershon", "merari"], "topic": "Serviço levítico" },
    { "id": "ns002", "order": 2, "text": "Pessoas em estados de impureza são afastadas temporariamente do acampamento para preservar sua santidade.", "text_he": null, "refs": ["Numbers 5:1-4"], "ref_start": "Numbers 5:1", "ref_end": "Numbers 5:4", "chapter": 5, "verse_start": 1, "verse_end": 4, "sefaria_ref": "Numbers 5:1-4", "day_of_creation": null, "tags": ["pureza", "acampamento", "santidade"], "topic": "Pureza do acampamento" },
    { "id": "ns003", "order": 3, "text": "Quem causa dano deve confessar, restituir o principal e acrescentar um quinto, mostrando que responsabilidade inclui reparação concreta.", "text_he": null, "refs": ["Numbers 5:5-10"], "ref_start": "Numbers 5:5", "ref_end": "Numbers 5:10", "chapter": 5, "verse_start": 5, "verse_end": 10, "sefaria_ref": "Numbers 5:5-10", "day_of_creation": null, "tags": ["confissão", "restituição", "ética"], "topic": "Reparação de danos" },
    { "id": "ns004", "order": 4, "text": "A lei da sotah trata de suspeita conjugal por meio de um rito público diante do cohen.", "text_he": null, "refs": ["Numbers 5:11-31"], "ref_start": "Numbers 5:11", "ref_end": "Numbers 5:31", "chapter": 5, "verse_start": 11, "verse_end": 31, "sefaria_ref": "Numbers 5:11-31", "day_of_creation": null, "tags": ["sotah", "família", "rito"], "topic": "Sotah" },
    { "id": "ns005", "order": 5, "text": "O nazir assume abstinência temporária de vinho, corte de cabelo e contato com mortos como voto de separação.", "text_he": null, "refs": ["Numbers 6:1-21"], "ref_start": "Numbers 6:1", "ref_end": "Numbers 6:21", "chapter": 6, "verse_start": 1, "verse_end": 21, "sefaria_ref": "Numbers 6:1-21", "day_of_creation": null, "tags": ["nazir", "voto", "santidade"], "topic": "Nazir" },
    { "id": "ns006", "order": 6, "text": "Aharon e seus filhos recebem as palavras da bênção sacerdotal para abençoar Israel em nome de Deus.", "text_he": null, "refs": ["Numbers 6:22-27"], "ref_start": "Numbers 6:22", "ref_end": "Numbers 6:27", "chapter": 6, "verse_start": 22, "verse_end": 27, "sefaria_ref": "Numbers 6:22-27", "day_of_creation": null, "tags": ["birkat-cohanim", "bênção", "aharon"], "topic": "Bênção sacerdotal" },
    { "id": "ns007", "order": 7, "text": "Os líderes das tribos trazem carros e bois para auxiliar o serviço levítico no transporte do Mishkan.", "text_he": null, "refs": ["Numbers 7:1-9"], "ref_start": "Numbers 7:1", "ref_end": "Numbers 7:9", "chapter": 7, "verse_start": 1, "verse_end": 9, "sefaria_ref": "Numbers 7:1-9", "day_of_creation": null, "tags": ["nesiim", "leviim", "mishkan"], "topic": "Doações para o transporte" },
    { "id": "ns008", "order": 8, "text": "Durante doze dias, cada líder tribal oferece a mesma oferta inaugural, afirmando igualdade e participação de todas as tribos.", "text_he": null, "refs": ["Numbers 7:10-89"], "ref_start": "Numbers 7:10", "ref_end": "Numbers 7:89", "chapter": 7, "verse_start": 10, "verse_end": 89, "sefaria_ref": "Numbers 7:10-89", "day_of_creation": null, "tags": ["inauguração", "nesiim", "tribos"], "topic": "Ofertas dos líderes" }
  ],
